<bea30c65-7fd8-4791-aea1-ffaa1c6522f0> a crm:PC3_has_note ;
    crm:P01_has_domain <a59118d2-4841-409b-8efa-0ebae69de799> ;
    crm:P03_has_range_literal "Voir la suite de l'article : [https://data-iremus.huma-num.fr/sherlock/projects/mercure-galant/articles/1682-02_295]()." ;
