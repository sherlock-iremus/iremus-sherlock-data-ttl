    crm:P03_has_range_literal "Voir la question : [https://data-iremus.huma-num.fr/sherlock/projects/mercure-galant/articles/1682-06e_398b]() et une autre réponse : [https://data-iremus.huma-num.fr/sherlock/projects/mercure-galant/articles/1682-09e_252]()." ;
    crm:P3.1_has_type <abcad1ea-4883-4e00-aa5e-4cd542e10845> .

