<be4f69cd-be59-4965-b66c-3d6df3da0946> a crm:E13_Attribute_Assignment ;
    sherlock:has_context_project <77176a31-2f64-4c47-82d7-fbdda58d776d> ;
    crm:P140_assigned_attribute_to <95e52e6c-a282-4a7a-9c58-5dc982b18390> ;
    crm:P141_assigned "<note resp=\"editor\">De juillet à octobre 1701, le<hi rend=\"italic\"> Mercure galant</hi> publie quatre articles sur les pratiques religieuses en Terre sainte. Le premier est signé du P. Raphaël Ventajol, « Procureur Général de Terre-Sainte », probable auteur des articles suivants, non signés. Celui de juillet 1701 évoque les célébrations en Terre sainte pour l’accession au trône du duc d’Anjou au trône d’Espagne. Le <ref target=\"MG-1701-08_016\">deuxième </ref> (août 1701) décrit les 24 couvents, missions et hospices de Terre Sainte et leurs coutumes ; <ref target=\"MG-1701-09_010\">le troisième</ref> (septembre 1701), les coutumes religieuses et rituels pratiqués lors de différentes fêtes. Le <ref target=\"MG-1701-10_015\">dernier </ref> (octobre 1701) évoque des cérémonies organisées au Couvent de Nazareth et décrit des pèlerinages en Terre sainte.</note>" ;
    crm:P14_carried_out_by <5d3e1e80-8f04-4a21-a085-f0fd2e1c40aa>,
        <e6584d49-a83a-4a18-aab7-02ecaa80732b> ;
    crm:P177_assigned_property_of_type <67a4fbdc-a186-43c5-bcb9-bb25bf798ded> .

