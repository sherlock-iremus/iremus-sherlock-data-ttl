<8bdd6205-6f25-49b5-98c4-78538e12996e> a crm:PC3_has_note ;
    crm:P01_has_domain <9711eb3f-9f64-44b3-89ce-bd192ff13230> ;
    crm:P03_has_range_literal "La *Relation de la Bataille de Fleurus* se compose de deux sections paginées à partir de 1. Cet extrait appartient à la seconde." ;
    crm:P3.1_has_type <abcad1ea-4883-4e00-aa5e-4cd542e10845> .

<90cbc5a8-e942-4a4e-a2ae-5a9cfa5aaeca> a crm:PC3_has_note ;
