        ],
        "http://purl.org/dc/terms/identifier": [
            {
                "@value": "51432a1b-f13b-4235-bdaf-9ab273d783d8"
            }
        ],
        "http://www.w3.org/2004/02/skos/core#historyNote": [
            {
                "@language": "fr",
                "@value": "<p class=\"ql-align-justify\">Les rondeaux publiés dans le <em>Mercure galant</em> présentant une grande variété formelle, on définit ici le rondeau par l’alternance de deux rimes et la répétition du premier vers (ou d’une partie de ce premier vers) en guise de refrain à la fin de chaque strophe."
            }
        ]
    },
