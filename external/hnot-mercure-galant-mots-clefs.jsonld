            }
        ],
        "http://purl.org/dc/terms/modified": [
            {
                "@value": "2022-03-28",
                "@type": "http://www.w3.org/2001/XMLSchema#date"
            }
        ],
        "http://purl.org/dc/terms/identifier": [
            {
                "@value": "55b60125-f11e-4590-8b0f-d7e0c4a14e1c"
            }
        ],
        "http://www.w3.org/2004/02/skos/core#historyNote": [
            {
                "@language": "fr",
                "@value": "D'après le Littré (1872-1877) : 1. Présent considérable, donné sous la forme d'un autre qui l'est beaucoup moins. 2. Fête en usage parmi les Espagnols (5 décembre) ; consiste à faire à ses amis des présents, sans qu'ils sachent d'où ils leur viennent."
            }
        ]
    },
