                "@id": "https://opentheso.huma-num.fr/?idc=2c9871f7-0b87-4747-8ea7-89fc63dcef54&idt=mercure-galant-mots-clefs"
            },
            {
                "@id": "https://opentheso.huma-num.fr/?idc=b008dc5d-2be1-4f19-86dc-f5499b1f82fa&idt=mercure-galant-mots-clefs"
