            }
        ],
        "http://purl.org/dc/terms/modified": [
            {
                "@value": "2022-04-19",
                "@type": "http://www.w3.org/2001/XMLSchema#date"
            }
        ],
        "http://purl.org/dc/terms/identifier": [
            {
                "@value": "6fbe48db-76b9-47c1-bc65-b8671d943087"
            }
        ],
        "http://www.w3.org/2004/02/skos/core#historyNote": [
            {
                "@language": "fr",
                "@value": "\"La <strong>danse du chevalet</strong>, appelée aussi <strong>jeu du chevalet</strong><a href=\"https://fr.wikipedia.org/wiki/Danse_du_chevalet#cite_note-1\" rel=\"noopener noreferrer\" target=\"_blank\"><sup>1</sup></a> ou <strong>le Chevalet</strong> est une danse essentiellement carnavalesque qui peut revêtir des tailles et des formes différentes selon les lieux où elle se pratique. Née au Moyen Âge à Montpellier semble-t-il, elle est un élément important de la tradition héraultaise, mais se décline plus largement autour de ce département. (cf. https://fr.wikipedia.org/wiki/Danse_du_chevalet, consulté le 19 avril 2022)."
            }
        ]
    },
