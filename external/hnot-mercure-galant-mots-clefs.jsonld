    {
        "@id": "https://opentheso.huma-num.fr/?idc=6fbe48db-76b9-47c1-bc65-b8671d943087&idt=mercure-galant-mots-clefs",
        "@type": [
            "http://www.w3.org/2004/02/skos/core#Concept"
        ],
        "http://www.w3.org/2004/02/skos/core#prefLabel": [
            {
                "@language": "fr",
                "@value": "Danse du chevalet"
            }
        ],
        "http://www.w3.org/2004/02/skos/core#altLabel": [
            {
                "@language": "fr",
                "@value": "Jeu du chevalet"
            }
        ],
        "http://www.w3.org/2004/02/skos/core#broader": [
