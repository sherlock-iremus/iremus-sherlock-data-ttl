    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<b740ba22-6b97-46e3-b830-eda8a37440a8> a crm:PC3_has_note ;
    crm:P01_has_domain <4b81abe2-bfbc-44fc-8794-6cec47c3b5d5> ;
    crm:P03_has_range_literal "chanteuse" ;
    crm:P3.1_has_type <c5402ae4-4ae9-48a1-86ed-c13de0c97d53> .

<b775b0c8-0651-48a6-8a6d-c54c0c7ea0e4> a crm:PC3_has_note ;
    crm:P01_has_domain <ad8fc296-d3e5-4e5b-a5fb-ca095f9dc0aa> ;
    crm:P03_has_range_literal "M. Bernard (fl. 1701) est l'auteur d'un poème publié en janvier 1701 dans le Mercure galant (cf. MG-1701-01\\_036)." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<b7772096-fb76-4edd-83fd-9caaf671fc6f> a crm:PC3_has_note ;
    crm:P01_has_domain <0dbe6c3d-634a-4843-a550-331ec132e0e1> ;
    crm:P03_has_range_literal "Compositeur de la cantate *Les Jardins de St Cloud*." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<b788670c-b204-40c7-91d2-ce2f0d50868b> a crm:PC3_has_note ;
    crm:P01_has_domain <38e261c2-b8ff-4925-baee-ff3852997acf> ;
    crm:P03_has_range_literal "M. Champenois, maître de musique, composa la musique d'un air publié dans la première partie du Mercure galant de novembre 1688 (cf. MG-1688-11a\\_213)." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<b79e9976-d607-488e-a388-4c509516a998> a crm:PC3_has_note ;
    crm:P01_has_domain <c97eeaf4-2b3f-41f5-b97b-e2b0fd72bbfc> ;
    crm:P03_has_range_literal "Président et lieutenant général en la sénéchaussée de Valence (cf. MG-1687-03b\\_383)." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<b7b33e14-d97f-4747-b456-85f6deb8ab65> a crm:PC3_has_note ;
    crm:P01_has_domain <0fa91433-08d9-4b0d-8527-7052700e0c09> ;
    crm:P03_has_range_literal "Prieur du couvent des Augustins de Toulon (cf. MG-1690-09_147)." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<b7e0085b-d258-44e2-b33a-4381c2a1b61c> a crm:PC3_has_note ;
    crm:P01_has_domain <a8a1b119-358f-4e75-abc2-adb9b396b31c> ;
    crm:P03_has_range_literal "M. Puget, de Berance est l'auteur d'une ode publiée dans le Mercure galant en avril 1702 (cf. [1702-04_282](https://data-iremus.huma-num.fr/sherlock/mercure-galant/article/1702-04_282)). Nous n'avons pas pu identifier avec certitude la ville où il réside à cette date. Peut-être s'agit-il de Cérance, dans l'évêché de Coutances (gouvernement de Normandie), à peu de distance de la Bérence, affluent de la Sienne." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<b8011f57-5c90-40e8-ab55-0f93648d2381> a crm:PC3_has_note ;
    crm:P01_has_domain <a66bf13c-1cd9-46e7-b464-6bceb772a84a> ;
    crm:P03_has_range_literal "Fils du baron puis marquis d'Ollières et frère de M. de Mirabeau (cf. MG-1687-06a\\_166). On peut l'identifier soit à Augustin d'Agoult d'Ollières, soit à Gaspard d'Agoult d'Ollières." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<b81786e1-db23-427f-9485-5e4b82fe9019> a crm:PC3_has_note ;
    crm:P01_has_domain <cf446574-df0d-49cf-8a6d-6d59b1de40a7> ;
    crm:P03_has_range_literal "Avocat et premier échevin de Mâcon (cf. [1679-09_072](https://data-iremus.huma-num.fr/sherlock/mercure-galant/article/1679-09_072))." ;
