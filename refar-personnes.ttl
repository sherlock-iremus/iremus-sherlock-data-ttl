<0b405e24-446f-48c3-abfc-b306ee5cf71f> a crm:PC3_has_note ;
    crm:P01_has_domain <00b21f34-9aa6-4306-ad6e-7e69408412fd> ;
    crm:P03_has_range_literal "lieutenant général de la ville de Sens (1684.12)" ;
    crm:P3.1_has_type <c5402ae4-4ae9-48a1-86ed-c13de0c97d53> .

<0b8f1a7b-719d-46ab-95a0-f9b230085e5b> a crm:PC3_has_note ;
    crm:P01_has_domain <6057a750-fd65-4e96-9f2a-deb41c476d03> ;
    crm:P03_has_range_literal "Gallois (Jean) (1632-1707), abbé commendataire de Saint-Martin de Chore (v. 1672…), commis à la garde de la Bibliothèque du roi (1683-1684), professeur de mathématiques et de grec (1686…), inspecteur (1688…) et syndic (1689…) au Collège royal, censeur royal (1700-1707)" ;
    crm:P3.1_has_type <c5402ae4-4ae9-48a1-86ed-c13de0c97d53> .

