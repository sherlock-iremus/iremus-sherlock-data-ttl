<a6fb254c-5b04-4817-8382-185e18f821f6> a crm:PC3_has_note ;
    crm:P01_has_domain <fd76b1ee-98b0-4460-ba99-822d9556313b> ;
    crm:P03_has_range_literal "M. Maugard, de Troyes, est l'auteur d'une paraphrase du psaume Exaudiat publiée dans le Mercure galant d'août 1702 (MG-1702-08\\_176). Si l'on se fie au texte de l'épître en vers à Louis Nivelle publiée dans le périodique en février 1702, c'est le même M. Maugard qui en est l'auteur (MG-1702-02a\\_146)." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

