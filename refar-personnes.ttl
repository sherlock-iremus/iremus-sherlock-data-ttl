<3ebd6ebb-5f44-46f0-a087-e15f5a1febc0> a crm:PC3_has_note ;
    crm:P01_has_domain <c29c2bc2-cea6-4969-9e22-a1a241b63ca5> ;
    crm:P03_has_range_literal "\"Mademoiselle de Saint-Jean de Saint Malo\" est l'autrice des paroles de deux airs publiés dans le *Mercure Galant* de février 1680 (cf. MG-1680-02\\_283) et dans celui de mars 1680 (cf. MG-1680-03a\\_015)." ;
