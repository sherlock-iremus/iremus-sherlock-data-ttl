    crm:P03_has_range_literal "Oratorien, professeur au collège de Juilly (cf. MG-1688-08\\_268)." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<026f505b-f999-4fc0-9258-22568dc1c955> a crm:PC3_has_note ;
    crm:P01_has_domain <02255a9a-4c0f-4b4f-b56c-5f805902a2cb> ;
    crm:P03_has_range_literal "Vigarani (Carlo) (1637-1713), ingénieur du roi (1662-1690), intendant des plaisirs du roi (1668-1690), inventeur des machines des théâtres, ballets et fêtes royales (1679-1690)" ;
    crm:P3.1_has_type <c5402ae4-4ae9-48a1-86ed-c13de0c97d53> .

<0272c948-ac9e-4dff-ad15-b06afe9fcd04> a crm:PC3_has_note ;
