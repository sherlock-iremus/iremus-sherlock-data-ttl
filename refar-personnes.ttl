<e442c54f-8d4f-46d9-83dd-a89cc0b8c54e> a crm:PC3_has_note ;
    crm:P01_has_domain <bdf7a9b6-b37d-49b1-86d1-94e85f7cf63b> ;
    crm:P03_has_range_literal "D’après la thèse de Juan Antonio López Anguita intitulée “Pouvoir et influence politique d'une reine d'Espagne lors de la Guerre de Succession : Marie-Louise Gabrielle de Savoie, première épouse de Philippe V”, Madame de Noyers (?-1720) était gouvernante de Marie-Louise, reine d’Espagne (cf. https://core.ac.uk/download/pdf/33108544.pdf, consulté le 4 février 2021). En 1655, elle épousa François Rey, baron de Noyers." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<e44aa5aa-28e4-4220-9ca6-55d605731540> a crm:PC3_has_note ;
