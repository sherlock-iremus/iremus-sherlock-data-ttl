<52f65a6b-eec4-435c-a6c8-18b93126046d> a crm:PC3_has_note ;
    crm:P01_has_domain <e285284d-2a74-4b20-87a2-cf74f5057799> ;
    crm:P03_has_range_literal "Alexandre Maître (1650-1715), marquis de Bay, “servait depuis 1702 dans les troupes espagnoles et était lieutenant général et capitaine général des deux Castilles ; Phillipe V lui avait donné la Toison d’Or en 1707” (cf. Mémoires du chevalier de Quincy. III. 1710-1713, Paris: Société de l’histoire de France, 1901, p. 37)." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<52f86881-5153-4d8f-962e-6f46f4fd44d6> a crm:PC3_has_note ;
    crm:P01_has_domain <4cd6e542-388c-45c1-9342-645d9607d648> ;
    crm:P03_has_range_literal "Mademoiselle de Des Marest participa aux réjouissances organisées à la cours lors du Carnaval 1702 (cf. [1702-02a_400](https://data-iremus.huma-num.fr/sherlock/mercure-galant/article/1702-02a_400))." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<5305f54a-5cb1-41ea-8f92-9df382d7969d> a crm:PC3_has_note ;
    crm:P01_has_domain <2bb5287a-a068-489f-8563-30a300376358> ;
    crm:P03_has_range_literal "Béthune-Charost (Julie-Christine-Régine Gorge d'Antraigues, duchesse de) (1688-1737), dame du palais (1725-1737)" ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<530907c4-883c-4489-a817-d157399baced> a crm:PC3_has_note ;
    crm:P01_has_domain <5c9f2815-9614-4c93-ba02-5a49b8be8116> ;
    crm:P03_has_range_literal "M. Leger est l'auteur d'un air publié dans le *Mercure galant* de mai 1689 (cf. MG-1689-05a\\_079)." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<53154522-a19c-4353-b29a-834d57def1e7> a crm:PC3_has_note ;
    crm:P01_has_domain <558834bf-d080-4744-bdba-106f0af9e19c> ;
    crm:P03_has_range_literal "La Minière (Félix-Louis de Cornette de) (1733-1794), secrétaire du duc de Coigny (…1772…), garde des livres du Cabinet du roi à Choisy (…1775-1785…), secrétaire général des dragons, trésorier de la capitainerie royale de la varenne du Louvre" ;
    crm:P3.1_has_type <c5402ae4-4ae9-48a1-86ed-c13de0c97d53> .

<534e3a04-7966-407f-a931-17c814b1d8ac> a crm:PC3_has_note ;
    crm:P01_has_domain <ad84f707-5073-4e84-8ae3-4bf4164531cc> ;
    crm:P03_has_range_literal "Après avoir été secrétaire à l'ambassade de France à Constantinople (1703), Pierre-Victor Michel fut envoyé extraordinaire de Louis XIV en Perse entre 1706 et 1708 (cf. Susan Mokhberi, The Persian Mirror : Reflections of th Safarid Empire in Early Modern France, Oxford Scholarship Online: November 2019, ISBN-13: 9780190884796 ; DOI:10.1093/oso/9780190884796.003.0004 ; consulté le 23 avril 2021). À son retour en France, il écrivit “Mémoire du Sieur Michel sur le voyage qu’il a fait en Perse dans les années 1706, 1707, 1708 et 1709” (cf. https://gallica.bnf.fr/ark:/12148/btv1b10720916q/f5.item, consulté le 20 avril 2021)." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<5351f978-3ba0-4ad5-813b-da0ec08e7b91> a crm:PC3_has_note ;
    crm:P01_has_domain <a43619dc-187f-4f36-95ee-999df575b555> ;
    crm:P03_has_range_literal "M. Fleury, de Châteaudun, mit en musique un Dialogue \"Mars, la Victoire, la Paix\" dont le livret est publié dans la livraison de mars 1679 du Mercure galant (cf. MG-1679-03\\_281)." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<537a2773-e61e-436f-8bad-ab46934d1c77> a crm:PC3_has_note ;
    crm:P01_has_domain <d67cbf56-b37f-476e-a867-3ce4d3330802> ;
    crm:P03_has_range_literal "M. France de Nola composa la musique d'un air publié dans le Nouveau Mercure (cf. [1717-09_156](https://data-iremus.huma-num.fr/sherlock/mercure-galant/article/1717-09_156))." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<539eff3d-eb7e-4090-9c30-9b1a9adb68eb> a crm:PC3_has_note ;
    crm:P01_has_domain <15090833-a167-4aca-8c20-70bcf28a83ea> ;
    crm:P03_has_range_literal "Premier président de la chambre des comptes de Rouen (cf. MG-1682-07\\_310)." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<53b0c1ec-523e-480a-95d8-82fe613b0063> a crm:PC3_has_note ;
    crm:P01_has_domain <3be4fa58-3901-4d4d-8172-740ddf5581a7> ;
    crm:P03_has_range_literal "Sabran (Louis-Hector-Honoré-Maxime de) (1739-1811), aumônier du roi (1767-1774), premier aumônier de la reine (1774-1780), évêque de Laon (1777), grand aumônier de la reine (1780-1791)" ;
    crm:P3.1_has_type <c5402ae4-4ae9-48a1-86ed-c13de0c97d53> .

<53b825eb-734f-47e5-a993-9977d7b0f479> a crm:PC3_has_note ;
    crm:P01_has_domain <0ae91caf-62c9-4029-ac8b-f8b7a08e3b36> ;
    crm:P03_has_range_literal "Petit (Louis) (?-?), contrôleur des Bâtiments du roi à Saint-Germain-en-Laye (1665-1683), à Marly (1679-1683) et à la machine de Marly (1682-1683), gentilhomme servant du prince de Condé" ;
    crm:P3.1_has_type <c5402ae4-4ae9-48a1-86ed-c13de0c97d53> .

<53cf0dac-cd1a-4a3f-828f-a6c02084885d> a crm:PC3_has_note ;
