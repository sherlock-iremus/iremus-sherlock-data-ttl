    crm:P03_has_range_literal "Le Mercure galant mentionne une Madame de Brion , épouse de Mr de Brion \"cy-devant Capitaine d'Infanterie dans la Reyne\", qui a participé aux réjouissances publiques à Château-Gontier pour la naissance du duc de Bretagne (cf. [1704-07b_393](https://data-iremus.huma-num.fr/sherlock/mercure-galant/article/1704-07b_393))." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<82c920ef-48bf-491e-85c6-fb4752f5bc9c> a crm:PC3_has_note ;
    crm:P01_has_domain <73d7007e-526b-4c23-bd6b-57629512e93a> ;
    crm:P03_has_range_literal "Hérault d'armes au titre du régiment de Charolais (cf. MG-1678-09\\_375 et MG-1684-10\\_007)." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<82d0708b-14af-4989-9599-07c3e7ea6218> a crm:PC3_has_note ;
