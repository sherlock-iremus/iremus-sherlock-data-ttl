<0e97abcf-fa8b-47c0-af79-a03c57017bde> a crm:PC3_has_note ;
    crm:P01_has_domain <c13ff9d8-3bbe-4d22-8ee1-1b725c0e85e2> ;
    crm:P03_has_range_literal "M. Gouët, auteur de quatre airs parus dans le Mercure galant en 1678, était, d'après le périodique \"Maistre de Musique des Dames Religieuses de Lonchamp\" (cf. MG-1678-08\\_060 ; MG-1678-09\\_225 ; MG-1678-10\\_031 ; MG-1678-11\\_043)." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<0ea1de57-fee4-40d5-b226-b8b84939564f> a crm:PC3_has_note ;
    crm:P01_has_domain <b2e3f4cb-fda9-44cb-82d2-5ce9a792df87> ;
    crm:P03_has_range_literal "Trésorier de France en Champagne (cf. MG-1680-03b_088)." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<0ea96092-70a5-421c-b748-61f4a8383dbf> a crm:PC3_has_note ;
    crm:P01_has_domain <f1d42e14-c1e0-4423-aa40-693f8729f10c> ;
    crm:P03_has_range_literal "Gentilhomme de la cour de Hanovre (cf. MG-1681-08_144)." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<0ec2904e-e512-4bf8-8c82-adb62aee720a> a crm:PC3_has_note ;
    crm:P01_has_domain <86788459-98b8-4428-b6c6-7560b43cc2e9> ;
    crm:P03_has_range_literal "D'après le Mercure galant, M. Daches, auteur d'une gavotte et d'un menuet parus dans le périodique, était «  de la musique du roi  » (cf. [1684-02_234](https://data-iremus.huma-num.fr/sherlock/mercure-galant/article/1684-02_234)). Il ne figure cependant pas dans les effectifs de la Musique du roi donnés pas les état de la France." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<0ee38335-fceb-42c5-9160-94d8c1546da4> a crm:PC3_has_note ;
    crm:P01_has_domain <16e54fcf-b9e8-4636-a901-47f2b4dab896> ;
    crm:P03_has_range_literal "Premier consul de Montpellier (cf. MG-1682-09b_125)." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<0efa9929-c9df-4a7f-8e8b-3a2fe61681ba> a crm:PC3_has_note ;
    crm:P01_has_domain <61e8d28a-45c3-404e-b73d-24a79c7885e9> ;
    crm:P03_has_range_literal "Directeur de la confrérie de Saint-Nicolas en l'église de Saint-Jean-en-Grève de Paris (cf. MG-1686-05_217)." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<0f1c4e0e-0992-46cf-9b5c-9eeb2b4a62f9> a crm:PC3_has_note ;
    crm:P01_has_domain <f6ab33c1-d16c-414a-a9be-2e49af5cc816> ;
    crm:P03_has_range_literal "Joan de Rojas y Solorzano, auteur d'un sonnet en espagnol publié dans le Mercure galant de février 1702, était secrétaire de Philippe V d'Espagne (cf. [1702-02a_301](https://data-iremus.huma-num.fr/sherlock/mercure-galant/article/1702-02a_301))." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<0f1f48a3-7032-4f22-bfc0-7c36eb30e6b6> a crm:PC3_has_note ;
    crm:P01_has_domain <4fbd4cb4-e543-45ce-88ba-fad40775b993> ;
    crm:P03_has_range_literal "D'après le *Mercure galant*, un motet de M. Dubuisson, \"Pensionnaire de la Musique de Sa Majesté\", fut chanté à Fontainebleau durant la messe du roi (cf. MG-1707-10A\\_306)." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<0f30a085-b09d-4b53-9b07-86ec5580ab74> a crm:PC3_has_note ;
    crm:P01_has_domain <e7d7a5f8-2f55-41ae-851a-c4a0234becc1> ;
    crm:P03_has_range_literal "Sculpteur." ;
    crm:P3.1_has_type <c5402ae4-4ae9-48a1-86ed-c13de0c97d53> .

<0f318033-d481-413d-96b2-46155415a2b8> a crm:PC3_has_note ;
    crm:P01_has_domain <50e176a4-01b0-4c26-be9b-b5c7f0f09729> ;
    crm:P03_has_range_literal "Autrice de deux cantatilles (*Les songes heureux et malheureux* et *Le réveil heureux*)." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<0f39f1f9-a1a7-4f84-a933-54a210c21326> a crm:PC3_has_note ;
    crm:P01_has_domain <97efc08b-9ba3-457d-8c16-0eb5ff76cdd7> ;
    crm:P03_has_range_literal "Béthune (Anne-Marie de Beauvilliers, comtesse de) (1610-1688), dame d'atours de la reine (1660-1683)" ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<0f49e971-0253-4041-9cb2-53f01c314d02> a crm:PC3_has_note ;
    crm:P01_has_domain <db4cf665-e523-4a1b-a376-da26ba9c6b7e> ;
    crm:P03_has_range_literal "Compositeur des oeuvres *Le Triomphe de Thémire* et *Silène*." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<0f53bee2-fc6e-45ce-ba66-ca4675223d54> a crm:PC3_has_note ;
    crm:P01_has_domain <fe1af282-55a0-47a4-8f81-d8dad0dff371> ;
    crm:P03_has_range_literal "Soulaigre (Henry) (1620-1701), concierge, garde-meuble, garde-horloge (1633-1701) et portier (1676-1701) du château vieux de Saint-Germain-en-Laye" ;
    crm:P3.1_has_type <c5402ae4-4ae9-48a1-86ed-c13de0c97d53> .

<0f5af655-8cbc-4123-9eb6-3d2bcc713eb1> a crm:PC3_has_note ;
    crm:P01_has_domain <ced083b6-0974-46b7-aa32-3767deee2dca> ;
    crm:P03_has_range_literal "De Poitiers, auteur d'un fable publiée dans le Mercure galant (cf. MG-1682-10b\\_199)." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<0f6c9368-12b4-487c-891c-3beb35cbaa1c> a crm:PC3_has_note ;
    crm:P01_has_domain <3e1f9909-5e33-43df-84d3-c021cd0d13ea> ;
    crm:P03_has_range_literal "M. Bernard (fl. 1697) était receveur général de la commanderie de Launay (cf. [1697-09_257](https://data-iremus.huma-num.fr/sherlock/mercure-galant/article/1697-09_257))." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<0f744d52-5dfc-4fd6-b8b8-08d65907d2c5> a crm:PC3_has_note ;
    crm:P01_has_domain <8dd1266e-4fad-4aa5-911f-8e091731f6a3> ;
    crm:P03_has_range_literal "missionnaire jésuite, professeur de mathématique au collège de Clermont puis à Lyon, Chambéry, Marseille et Turin." ;
    crm:P3.1_has_type <c5402ae4-4ae9-48a1-86ed-c13de0c97d53> .

<0f7a86a3-b612-45ec-9765-f163ec1bbdcd> a crm:PC3_has_note ;
    crm:P01_has_domain <5956eb8d-e5c3-4030-a2c1-38df227a775b> ;
    crm:P03_has_range_literal "M. de Granville, de Riom, est l'auteur d'un ouvrage publié dans la livraison d'août 1702 du Mercure galant (MG-1702-08\\_125)." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<0f808eb5-a24f-46b9-8d7d-44e8d0adf6c2> a crm:PC3_has_note ;
    crm:P01_has_domain <2eae7d95-3c3f-4e0f-b8c2-e6085efb7263> ;
    crm:P03_has_range_literal "Blouin (Louis) (v. 1660-1729), premier valet de chambre du roi (1665-1715), intendant des terres, parcs et châteaux de Versailles (1701-1729) et de Marly (1679-1729), gouverneur de Coutances (1713)" ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<0f89e931-b4c2-40a1-ac28-d714c645beca> a crm:PC3_has_note ;
    crm:P01_has_domain <c0acad96-b340-49db-a0a9-038f25b4e731> ;
    crm:P03_has_range_literal "Compositeur des cantates *Apollon et Daphné*, *Pyrâme et Thisbé*, *Le jugement de Paris* et *Le destin de Narcisse* parues en 1708." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<0f8ef4d5-0092-4cc4-a13d-bd14591c6ba6> a crm:PC3_has_note ;
    crm:P01_has_domain <2dd59f8b-15ed-4805-9626-4309f0a8b4f8> ;
    crm:P03_has_range_literal "Mlle de Poisson a participé à un bal chez M. de Saint-Philibert à Château-Gontier pour célébrer la naissance du duc de Bretagne (cf. [1704-07b_393](https://data-iremus.huma-num.fr/sherlock/mercure-galant/article/1704-07b_393))." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<0fbee384-5e19-4284-b181-7fad532c1b2f> a crm:PC3_has_note ;
    crm:P01_has_domain <70979351-c1da-42be-931f-c028b043f4f3> ;
    crm:P03_has_range_literal "synonymes: baron de Licques, baron de Wiserkerke" ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<0fd73de8-d2fc-4f85-bebe-8ecb532e7983> a crm:PC3_has_note ;
    crm:P01_has_domain <658611ee-34cf-4470-af75-c3782f690701> ;
    crm:P03_has_range_literal "Compositeur, candidat au concours pour le poste de sous-maître de musique de la Chapelle Royale (cf. [1683-04_310](https://data-iremus.huma-num.fr/sherlock/mercure-galant/article/1683-04_310))." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

