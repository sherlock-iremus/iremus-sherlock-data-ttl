    crm:P03_has_range_literal "Le *Mercure galant* de mars 1702 évoque l'abbé Bruzen, de Dieppe, auteur d'une paraphrase de psaume (cf. MG-1702-03\\_215)." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<a5786349-592f-42ad-9347-ba18beb5fc0f> a crm:PC3_has_note ;
