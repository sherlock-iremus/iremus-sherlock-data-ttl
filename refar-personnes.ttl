<c576b3f0-5421-42bb-ba91-571e1e6afacd> a crm:PC3_has_note ;
    crm:P01_has_domain <0e7e2ecd-fee7-4d1c-923e-1eaa909e1502> ;
    crm:P03_has_range_literal "Jacques de Drouillet fut conseiller au Parlement de Toulouse (1653-1677) puis président à la deuxième chambre des Enquêtes (1677). Il présida également l'Académie des Jeux floraux de Toulouse entre 1704 et 1718 (cf. Axel Duboul, « Les deux siècles de l’Académie des Jeux floraux », Toulouse, imprimerie et librairie E. Privat, 1901, t. 2, p. 96 ; https://gallica.bnf.fr/ark:/12148/bpt6k998931/f114.item.r=druillet, consulté le 26 mars 2021)" ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<c57dc24e-a920-47ee-a849-eaefc8b3a481> a crm:PC3_has_note ;
