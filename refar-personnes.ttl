<d58210ef-8b4d-4161-92e4-5c2d6fa441ad> a crm:PC3_has_note ;
    crm:P01_has_domain <a69b6b55-3bb8-4338-8341-bc65d995119c> ;
    crm:P03_has_range_literal "Pierre-Cardin Lebret fut successivement intendant de la généralité de Limoges (1681-1683), intendant de la généralité de Grenoble (1683-1686), intendant de la généralité de Lyon (1686-1687), intendant de Provence (1687-1704) et premier président du Parlement de Provence (1691-1710)." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<d59ec2e4-edef-4309-a7f8-a25659e9c2a5> a crm:PC3_has_note ;
    crm:P01_has_domain <51ed1529-59a0-403c-86d5-f2171cad1391> ;
    crm:P03_has_range_literal "M. l'abbé Roy «  Chanoine de S. Jacques de l'Hopital, âgé de 80 ans  » est l'auteur du poème d'un air en l'honneur de Louise-Adélaïde de Savoie publié dans la livraison d'août 1718 du Mercure galant (cf. [1718-08_188](https://data-iremus.huma-num.fr/sherlock/mercure-galant/article/1718-08_188))." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<d5ab089b-4e6e-4654-967e-5061ee84574e> a crm:PC3_has_note ;
    crm:P01_has_domain <92d1402b-3877-4357-a1c5-5a8650f9d50a> ;
    crm:P03_has_range_literal "secrétaire du roi (1668), commissaire général de l'artillerie (1676), trésorier général des finances de la dauphine (1680)" ;
    crm:P3.1_has_type <c5402ae4-4ae9-48a1-86ed-c13de0c97d53> .

<d5b76c2d-b1e3-47fd-8c84-e5e1fc830b19> a crm:PC3_has_note ;
    crm:P01_has_domain <54f88894-a50c-470d-bcd4-00f948bb7da8> ;
    crm:P03_has_range_literal "M. Capus, \"Maistre de Musique fort estimé, & étably à Dijon\", composa la musique d'un air paru dans le Mercure galant de septembre 1690 (cf. [1690-09_111](https://data-iremus.huma-num.fr/sherlock/mercure-galant/article/1690-09_111))." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<d5ba850c-15cf-4b87-8124-b8c1e0e387a4> a crm:PC3_has_note ;
    crm:P01_has_domain <658d944d-3254-488c-8092-8916098f93c3> ;
    crm:P03_has_range_literal "Fait partie des équipages du Roy d’Espagne & de Messeigneurs les Ducs de Bourgogne & de Berry, & de leur suite mentionné dans le Mercure galant de janvier 1701 (MG-1701-01\\_160)." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

