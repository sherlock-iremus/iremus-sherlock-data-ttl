    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<712feb0d-1503-4a87-ac79-61ff5d89ae88> a crm:PC3_has_note ;
    crm:P01_has_domain <17909e71-e484-456e-a247-b2ccf976637a> ;
    crm:P03_has_range_literal "Maître à danser à l'Académie équestre royale de Paris (cf. [1678-01_119](https://data-iremus.huma-num.fr/sherlock/mercure-galant/article/1678-01_119))." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<71511fe7-8a4f-4e21-903e-fd0eaa2a022c> a crm:PC3_has_note ;
    crm:P01_has_domain <38549b6a-8f00-459f-a0a6-bb869f5fde27> ;
    crm:P03_has_range_literal "Maire de Poitiers de 1693 à 1701." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<71584724-cc51-4eef-ae56-f710ff3e88e5> a crm:PC3_has_note ;
    crm:P01_has_domain <d34d29ab-7f26-405a-8490-d87f1d154170> ;
    crm:P03_has_range_literal "M. Pillet était le principal du collège de Dormans en 1704 (cf. MG-1704-08\\_203)." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<715fc096-b171-4bde-9083-575ccbd0ebfa> a crm:PC3_has_note ;
    crm:P01_has_domain <b2e3f4cb-fda9-44cb-82d2-5ce9a792df87> ;
    crm:P03_has_range_literal "Trésorier de France en Champagne (cf. [1680-03b_088](https://data-iremus.huma-num.fr/sherlock/mercure-galant/article/1680-03b_088))." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<718306d4-a533-44ac-9113-a7e09da61ccd> a crm:PC3_has_note ;
    crm:P01_has_domain <4d1f656c-00ce-4f09-bb04-c8f4d117f1a3> ;
    crm:P03_has_range_literal "Boze (Claude Gros de) (1680-1753), trésorier au Bureau des finances de Lyon, intendant des devises et inscriptions des édifices royaux (1706…), garde du Cabinet des médailles du roi (1719-1753), censeur royal (1745-1747)" ;
    crm:P3.1_has_type <c5402ae4-4ae9-48a1-86ed-c13de0c97d53> .

<718d716d-144c-4086-8a15-b1c65ba067d3> a crm:PC3_has_note ;
    crm:P01_has_domain <19940af4-2e24-4e81-a328-0dbaabd02dfa> ;
    crm:P03_has_range_literal "Grégoire de la Forge (fl. 1693-1706) a été Général de l'ordre de la Trinité entre novembre 1692 jusqu'à sa mort en août 1706 (cf. Moreri, Louis. Le Grand dictionnaire historique ou le Mélange curieux de l'histoire sacrée et profane, Tome 10. Paris, chez les Libraires Associés, 1759, p. 344)." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<7192642d-8c28-4c75-970e-cc28d856fb77> a crm:PC3_has_note ;
    crm:P01_has_domain <f3ae752d-f97f-44d1-8486-c8af6d1c502d> ;
    crm:P03_has_range_literal "Maître des comptes à Grenoble (cf. [1684-03_218](https://data-iremus.huma-num.fr/sherlock/mercure-galant/article/1684-03_218))." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<71b31180-f841-4488-9c77-f16d93e6c78b> a crm:PC3_has_note ;
    crm:P01_has_domain <3de21d33-119d-42a5-a532-de25bc862e38> ;
    crm:P03_has_range_literal "Chanoine et sacristain de la cathédrale d'Arles (cf. [1687-03a_056](https://data-iremus.huma-num.fr/sherlock/mercure-galant/article/1687-03a_056)) ; frère de Henri de Boche, grand sénéchal d'Arles." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<71b9f1b9-c8f4-4e5d-a0e0-bfc56fa5b9f7> a crm:PC3_has_note ;
    crm:P01_has_domain <93cc16ed-0ac5-4b3b-aae3-1547cf9d240a> ;
    crm:P03_has_range_literal "Gouverneur de Saint-Omer (cf. MG-1679-01_286)." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<71daab60-c680-463f-928c-e3f84180f596> a crm:PC3_has_note ;
    crm:P01_has_domain <ab62a099-5029-410f-9e8b-1d2eeea75731> ;
    crm:P03_has_range_literal "Bignon (Jérôme-Frédéric) (1747-1784), conseiller au parlement de Paris, bibliothécaire du roi (en survivance en 1770, en titre  de 1772 à 1784)" ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<71dfc597-3555-40b2-bf52-a5058bb8f154> a crm:PC3_has_note ;
    crm:P01_has_domain <131050e7-8af9-4793-99a8-372da86a9ff7> ;
    crm:P03_has_range_literal "Marie-Élisabeth-Angélique-Gabrielle de Rohan-Soubise était dame du palais de la reine de 1725 à 1729 et gouvernante des Enfants de France de 1729 à 1754." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<71e2ad0a-9bed-4f5b-b1ec-54c8e94e5493> a crm:PC3_has_note ;
    crm:P01_has_domain <55e430a4-abbd-4c3f-b3ca-c640a0f6799b> ;
    crm:P03_has_range_literal "Morel, François-Philippe (1660-1731), aumônier du roi (1694-1716)" ;
    crm:P3.1_has_type <c5402ae4-4ae9-48a1-86ed-c13de0c97d53> .

<71e8c127-e51d-4418-9c1e-aed3d81a7336> a crm:PC3_has_note ;
    crm:P01_has_domain <1c6556be-1a88-4209-8ac6-1c76a0ed28f7> ;
    crm:P03_has_range_literal "M. Ennelin, \"de Saint Quentin\", est l'auteur d'un air publié dans le *Mercure galant* de juin 1687 (cf. [1687-06a_084](https://data-iremus.huma-num.fr/sherlock/mercure-galant/article/1687-06a_084)). Peut-être est-il apparenté à l'auteur de l'air \"Retirez-vous foibles buveurs\" publié dans les *Meslanges de musique latine, françoise & italienne...* (Paris, Jean-Baptiste-Christophe Ballard, 1731, Automne, p. 200-204)." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<71fc9611-268e-48c2-b4e0-728988b3719a> a crm:PC3_has_note ;
    crm:P01_has_domain <f829131a-0994-4c9d-98be-22d4587720a3> ;
    crm:P03_has_range_literal "Mademoiselle de Ravetot participa aux réjouissances organisées à la cours lors du Carnaval 1702 (cf. [1702-02a_400](https://data-iremus.huma-num.fr/sherlock/mercure-galant/article/1702-02a_400))." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<71fdf505-9647-4aa9-9007-bdde3f035122> a crm:PC3_has_note ;
    crm:P01_has_domain <7450fd20-dad0-488d-9e0d-2d06794a3ec5> ;
    crm:P03_has_range_literal "Secrétaire du roi (cf. MG-1681-12_027)." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<7225aa5b-300b-4990-9770-60c3dd92a85b> a crm:PC3_has_note ;
    crm:P01_has_domain <3f3e5128-9ae0-4bcc-a602-5d6c2975f81b> ;
    crm:P03_has_range_literal "Ambassadeur de France à Madrid (cf. MG-1682-10a_266)." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<723224ca-6c1d-4a34-9d70-0fcd9a165c57> a crm:PC3_has_note ;
    crm:P01_has_domain <c6c0078a-d661-4963-96b5-39b1da4cea65> ;
    crm:P03_has_range_literal "Conseiller au grand conseil en 1668, maître des requêtes en 1676, intendant de Limoges en 1681, du Dauphiné en 1683, de Lyon en 1686, de Provence en 1687 ; premier président du parlement de Provence (1690-1710)." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<723fcb45-e40b-45b6-8bd2-cc5ee8b4ece8> a crm:PC3_has_note ;
    crm:P01_has_domain <e4dd0d4e-60c9-448a-b47d-b5e23bc8063d> ;
    crm:P03_has_range_literal "Ancien aumônier de Monsieur (cf. MG-1686-10a_073)." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<72715b96-d885-4d4a-940c-1864ccbf0fc1> a crm:PC3_has_note ;
    crm:P01_has_domain <9feb6ddb-691c-49d0-b72e-01fe6eb59026> ;
    crm:P03_has_range_literal "Argouges (Florent d') (1647-1719), intendant de Moulins (1686-1688), puis de Bourgogne (1688-1694)" ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<727ed884-8892-4b8f-8665-f3e19a91c470> a crm:PC3_has_note ;
    crm:P01_has_domain <8be9ecdb-4dc8-4429-bb8a-d3aa5d3082c3> ;
    crm:P03_has_range_literal "Participa aux réjouissances organisées pour célébrer le retour de la santé du roi à Agde (cf. MG-1687-04_074)." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<7290a09e-a23f-492c-84c6-112045e93ce6> a crm:PC3_has_note ;
    crm:P01_has_domain <aa604ab7-25e7-4751-a622-4e2cdddfd3e8> ;
    crm:P03_has_range_literal "Participa aux réjouissances du Carnaval de la cour de Lorraine en 1699 (cf. MG-1699-03_151)." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<72c8abba-3786-40c5-86a5-3fc4a0caebe2> a crm:PC3_has_note ;
