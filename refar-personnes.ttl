    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<67f792b1-010f-4230-bda0-fb45e3df0330> a crm:PC3_has_note ;
    crm:P01_has_domain <73e316ff-4a5e-40f0-938b-efb6d7da8723> ;
    crm:P03_has_range_literal "Dame d'honneur de la duchesse de Hanovre (cf. [1684-12_136](https://data-iremus.huma-num.fr/sherlock/mercure-galant/article/1684-12_136))" ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<6848dc88-a757-44cf-bde8-4f8925472461> a crm:PC3_has_note ;
    crm:P01_has_domain <f41d059d-0a21-4d8d-9922-9c4f43b49a50> ;
    crm:P03_has_range_literal "Rohan (Louis-Constantin de) (1697-1779), premier aumônier du roi (1748-1757)" ;
    crm:P3.1_has_type <c5402ae4-4ae9-48a1-86ed-c13de0c97d53> .

<6888a9ba-6c8e-4bda-9eff-2b82d915efc0> a crm:PC3_has_note ;
    crm:P01_has_domain <c8496335-66b9-4ea3-bbe1-67940026db95> ;
    crm:P03_has_range_literal "M. Du Pré composa la musique d'un air paru dans le Mercure galant (cf. [1679-02_253](https://data-iremus.huma-num.fr/sherlock/mercure-galant/article/1679-02_253)). Peut-être s'agit-il de Laurent Dupré (1642-1709)." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<68c00a0c-fc78-408a-ac41-8b66e2d17e7c> a crm:PC3_has_note ;
