    crm:P03_has_range_literal "M. Chastan, \"de la ville d'Apt\", composa la musique d'un air paru dans le Mercure galant d'août 1707 (cf. [1707-08_149](https://data-iremus.huma-num.fr/sherlock/mercure-galant/article/1707-08_149))." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<b2727b67-e5bc-451b-941e-64ba24cce6d4> a crm:PC3_has_note ;
    crm:P01_has_domain <d16962e1-fd20-41fe-949e-59ab8740b5a0> ;
    crm:P03_has_range_literal "L'abbé de Vaillac a célébré la bénédiction nuptiale du mariage du comte et de la comtesse de Vauguyon au château de Chalus en 1704 (cf. MG-1704-01\\_13)." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<b27423a5-08da-48d5-ab22-a37d396901db> a crm:PC3_has_note ;
