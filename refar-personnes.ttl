    crm:P01_has_domain <f379276f-4bf5-483c-b1c1-a58c3c723391> ;
    crm:P03_has_range_literal "M. Charles, \"disciple de M. Brossant\" (cf. MG-1706-04\\_375), est l'auteur de la musique d'airs parus dans le Mercure galant entre 1706 et 1710. Peut-être convient-il de lire \"Brossard\" et non \"Brossant\"." ;
