    crm:P01_has_domain <9257b7a5-3be8-4f13-9446-c99ab445873a> ;
    crm:P03_has_range_literal "Gentilhomme charentais (cf. MG-1682-10a_059)." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<adc438e9-c155-4984-9a32-fa6f1a52d3a4> a crm:PC3_has_note ;
    crm:P01_has_domain <05c88838-4299-4e14-9aba-b648f763d17d> ;
    crm:P03_has_range_literal "Simon (Jean-François) (1654-1719), précepteur de Michel-François Le Peletier des Forts (1684…), secrétaire de Michel Le Peletier de Souzy, contrôleur des fortifications (1691…), commis à la garde du Cabinet des médailles du roi (1712-1718)" ;
    crm:P3.1_has_type <c5402ae4-4ae9-48a1-86ed-c13de0c97d53> .

<adcb12fd-313d-45e6-9d63-640219fe509f> a crm:PC3_has_note ;
    crm:P01_has_domain <bd1de76a-6472-4bac-b83a-c575de6f42bc> ;
    crm:P03_has_range_literal "M. Chevalier composa la musique d'un air paru dans le Mercure galant de décembre 1681 (cf. MG-1681-12\\_178)." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<adf643cc-6a62-435d-ab4f-634ef160ccef> a crm:PC3_has_note ;
    crm:P01_has_domain <fbf25c28-1944-40da-8fa3-ef434d2b1c21> ;
    crm:P03_has_range_literal "Tourolle (Charles) (1693?-1748), maréchal des logis (actif en 1722-1728), garde général du Garde-Meuble de la Couronne (en survivance …1728-1742, en titre 1742-1748), receveur général des domaines et bois de la généralité de Rouen (1735-1748)" ;
    crm:P3.1_has_type <c5402ae4-4ae9-48a1-86ed-c13de0c97d53> .

<ae202468-6666-4e71-95eb-aae19741d913> a crm:PC3_has_note ;
    crm:P01_has_domain <a58ed6f2-7d86-4ef5-a277-0ee0e76aef68> ;
    crm:P03_has_range_literal "M. de la Fevrerie était un contributeur du *Mercure Galant* qui publia en février 1695 sa \"Réponse à la Satire contre les Vers irreguliers employée dans le Mercure du mois d'Avril 1694\" (cf. [1695_02_236](https://data-iremus.huma-num.fr/sherlock/mercure-galant/article/1695_02_236)) et écrivit les paroles d'un air publié dans le *Mercure Galant* de décembre 1708 (cf. MG-1708-12\\_267)." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<ae30ad85-ccbd-44cd-ae19-7f79c9489e92> a crm:PC3_has_note ;
    crm:P01_has_domain <3f50f517-e846-4324-a240-7591632c6518> ;
    crm:P03_has_range_literal "Bellefonds (Guillaume Pissonnet de) (v. 1660-v. 1721), concierge du château de Chambord" ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<ae3d4275-842a-4c7a-9e08-3eca62b61742> a crm:PC3_has_note ;
    crm:P01_has_domain <70185fb6-6e7a-4d3b-a54b-f2845e7fd0d8> ;
    crm:P03_has_range_literal "Ingénieur du roi, artificier (cf. MG-1686-10a_281)." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<ae3f0895-74a7-4035-8f49-eb9e9628a3bb> a crm:PC3_has_note ;
    crm:P01_has_domain <06dcf0a1-acec-4256-82e8-80ba9ed281cd> ;
    crm:P03_has_range_literal "M. Normandeau l'aîné, \"cy-devant Page de la Chapelle du Roy\" (cf. [1699-09_205](https://data-iremus.huma-num.fr/sherlock/mercure-galant/article/1699-09_205)), ne doit pas être confondu avec M. Normandeau, auteur de deux airs parus dans le *Mercure galant* en 1689 et 1691 (cf. MG-1689-06a\\_114 et MG-1691-09\\_311a). Ce dernier était peut-être le père de l'ancien page." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<ae500f0d-3e86-47e0-a05d-d1635b234bea> a crm:PC3_has_note ;
    crm:P01_has_domain <02d3fe62-3d0d-4e03-bd32-1600a6f522a8> ;
    crm:P03_has_range_literal "M. Royer est l'auteur des paroles d'un air publié dans le *Mercure Galant*de septembre 1684 (cf. [1684-09_091](https://data-iremus.huma-num.fr/sherlock/mercure-galant/article/1684-09_091))." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<ae6114c8-bac5-42fa-8cf1-50709a6245d8> a crm:PC3_has_note ;
    crm:P01_has_domain <535d38df-2d53-4c4e-ac91-1e55ec692388> ;
    crm:P03_has_range_literal "Le *Mercure galant* indique que Jean Foloppe était avocat du roi (cf. MG-1704-07b\\_292). Les archives civiles de la Seine Maritime précisent qu’il est devenu « avocat du roi au siège présidial de Caudebec » entre 1676 et 1690 (Inventaire-sommaire des Archives Départementales antérieures à 1790 de Seine inférieure, archives civiles, série C- 1328)." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<ae8888bc-3604-4eeb-ad2a-add2c1ebe4d8> a crm:PC3_has_note ;
    crm:P01_has_domain <9349cc67-18da-4b16-acb6-21c5b76f03bb> ;
    crm:P03_has_range_literal "Jésuite, professeur de théologie à Poitiers (cf. [1687-03b_063](https://data-iremus.huma-num.fr/sherlock/mercure-galant/article/1687-03b_063))." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<ae9443db-d6ea-409f-afbe-d83180035635> a crm:PC3_has_note ;
    crm:P01_has_domain <08d0f0e0-2295-4b1a-a050-7348ba45cfa6> ;
    crm:P03_has_range_literal "Intendant de justice des trois évêchés (cf. MG-1681-08\\_53) après avoir occupé les mêmes fonctions à Caen (novembre 1676-1677)." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<af02a6f0-4612-43a8-9e5c-924ca3508ac1> a crm:PC3_has_note ;
    crm:P01_has_domain <b5d9b180-2c6e-4fb9-840d-a79a1cb02436> ;
    crm:P03_has_range_literal "Doyen de la collégiale de Mortain (cf. MG-1708-01_186)." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<af0fde6b-eec5-4dfc-b7e0-426da533115f> a crm:PC3_has_note ;
    crm:P01_has_domain <78643598-3232-4e83-998b-e98e820e95df> ;
    crm:P03_has_range_literal "Pensionnaires du collège Louis-le-Grand (cf. MG-1686-09b_102)." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<af37b160-acdf-461d-9ccd-def6c35c55e3> a crm:PC3_has_note ;
    crm:P01_has_domain <a7e12b74-b5dc-426c-9887-adfd84c425aa> ;
    crm:P03_has_range_literal "Maître de la musique de Saint-Germain-l'Auxerois, ancien élève de Pierre Robert." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<af4c973a-2779-4cce-a328-967583ca719a> a crm:PC3_has_note ;
    crm:P01_has_domain <9ce2a6b0-8f7b-4d95-ba43-20c33689f74c> ;
    crm:P03_has_range_literal "Fils aîné du procureur de la Chambre de Württemberg (cf. Procureur de la Chambre de Württemberg (cf. MG-1684-11\\_034).)" ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<af511ead-33d3-4321-aa0a-db4635e855cb> a crm:PC3_has_note ;
    crm:P01_has_domain <b6b9eb4a-14ee-4d4f-ba29-650edd85ba11> ;
    crm:P03_has_range_literal "Lieutenant du roi (cf. [1682-04_203](https://data-iremus.huma-num.fr/sherlock/mercure-galant/article/1682-04_203))." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<af59d188-2dbb-41e0-b14b-160afd3c7b5e> a crm:PC3_has_note ;
    crm:P01_has_domain <ab315a7c-51d4-4bf8-8f43-b16478658958> ;
    crm:P03_has_range_literal "D’après le Mercure galant, Flavio Barbarossa est « Recteur & Gouverneur du Comtat Venaissin » en 1701 (Cf. MG-1701-02\\_036)." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<afb2ea4d-2309-4160-a14b-a317e0a9cf55> a crm:PC3_has_note ;
    crm:P01_has_domain <d2a45ec3-d710-44bc-9cd0-d88f19e5efff> ;
    crm:P03_has_range_literal "Mailly (Louise-Julie de Mailly de Nesle, comtesse de) (1710-1751), dame du palais de la reine (1729-1742)" ;
    crm:P3.1_has_type <c5402ae4-4ae9-48a1-86ed-c13de0c97d53> .

<aff566a0-d94b-4c29-b448-1a488a8cd944> a crm:PC3_has_note ;
    crm:P01_has_domain <5ddd2dca-d197-47ea-b706-a232b7a42446> ;
    crm:P03_has_range_literal "Demoiselle qui épousa en 1678 M. de Launay, capitaine des régiments du roi (cf. [1678-06_122](https://data-iremus.huma-num.fr/sherlock/mercure-galant/article/1678-06_122))." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<b04e0cbb-5177-4ba5-9eff-a5603e83bc92> a crm:PC3_has_note ;
    crm:P01_has_domain <f825ea78-64da-4a0a-bc7d-17ac9c7b4498> ;
    crm:P03_has_range_literal "Lieutenant de la garde allemande de Naples (cf. MG-1680-03a\\_120)." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<b0553aa2-afa6-4f68-be29-a3d9cbfe0257> a crm:PC3_has_note ;
    crm:P01_has_domain <043be057-6f54-4906-91d2-7929b6060dff> ;
    crm:P03_has_range_literal "Mère de Flaminia Pamphili (1651-1709), princesse de Vénaffre (cf. MG-1678-08_057)." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<b0738073-fa40-444e-acf0-f6fc18901ac3> a crm:PC3_has_note ;
    crm:P01_has_domain <8a9865e5-3023-4a4b-9584-6e874a589aac> ;
    crm:P03_has_range_literal "M. Mouton, maître de musique de la cathédrale Saint-Étienne de Troyes, est l'auteur de la musique d'un Te Deum exécuté par le Petit concert de Troyes le 27 juillet 1756 pour célébrer la prise du fort Saint-Philippe (cf. Annonces, affiches et avis divers. 8 septembre 1756, n° 36, p. 143)." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<b090172e-1940-4bec-9cdf-2edbe450ee5b> a crm:PC3_has_note ;
    crm:P01_has_domain <7822dc5e-5d34-47a0-9499-691ae423838a> ;
    crm:P03_has_range_literal "Capitaine-lieutenant des gardes du palais de la cour de Hanovre (cf. MG-1681-04\\_133 et MG-1681-08\\_144)." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<b0924543-b65f-48cf-b645-04f951c5d091> a crm:PC3_has_note ;
    crm:P01_has_domain <bc605ffa-f9e0-4b3c-a6fe-f355b8547789> ;
    crm:P03_has_range_literal "Tallemant, François (1620-1693), aumônier du roi (1648... ; ...1661-1671), Premier aumônier de Madame (1671-1693)" ;
    crm:P3.1_has_type <c5402ae4-4ae9-48a1-86ed-c13de0c97d53> .

<b09e9e36-4f74-44d5-8806-d310145854b8> a crm:PC3_has_note ;
    crm:P01_has_domain <49405385-83ee-416e-802f-3ba4108c101e> ;
    crm:P03_has_range_literal "Mère de Claude Bosc du Bois, procureur général de la cour des aides (cf. MG-1682-06\\_241)." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<b0bca11b-9e08-4d8c-82db-3ee896f023ad> a crm:PC3_has_note ;
    crm:P01_has_domain <960b6ca7-d919-4840-bf89-c8e596de378c> ;
    crm:P03_has_range_literal "Louis Millon a été aumônier du roi (cf. MG-1685-08\\_206) puis évêque de Condom (1694-1734)." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<b0d0e265-97e9-4c99-b136-51d61dab9219> a crm:PC3_has_note ;
    crm:P01_has_domain <4d960afc-3dd9-4e0e-8a27-ede19c7c91aa> ;
    crm:P03_has_range_literal "Mathématicien, prévôt de Ternans (Nièvre), divulgateur scientifique" ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<b0e9cec3-a532-49fd-8670-8229719c0792> a crm:PC3_has_note ;
    crm:P01_has_domain <86b62ad6-d3d8-4cdd-a43d-9922a6e4db2b> ;
    crm:P03_has_range_literal "Compositeur de la cantatille \"Le Triomphe de Lise\" datant selon le Mercure de France (mai 1759) de 1759." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<b0ed7d7e-3cf4-499b-b8c0-e9169b2dace8> a crm:PC3_has_note ;
    crm:P01_has_domain <ffd1e29b-ea51-44d5-80de-29ac512e0f5a> ;
    crm:P03_has_range_literal "M. de Merville est l'auteur des paroles d'un air publié dans le *Mercure galant* de juin 1678 (cf. [1678-06_207](https://data-iremus.huma-num.fr/sherlock/mercure-galant/article/1678-06_207)) et d'un air publié dans celui de septembre 1678 (cf. MG-1678-09\\_037)." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<b0ee8042-df46-4cf9-9626-e62c4d0c3592> a crm:PC3_has_note ;
    crm:P01_has_domain <7e3fca3c-f40e-4b19-a518-2c515f805d2f> ;
    crm:P03_has_range_literal "Avocat général de la Chambre des comptes de Rouen, reçu en 1690." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<b0ef4518-c621-4f68-b957-746678fcd459> a crm:PC3_has_note ;
    crm:P01_has_domain <95a23b75-5ca0-48b5-a9a4-30c5633ee11c> ;
    crm:P03_has_range_literal "Maire de Caudebec-en-Caux (cf. [1698-01_063](https://data-iremus.huma-num.fr/sherlock/mercure-galant/article/1698-01_063))." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<b0f221cd-0bf9-4f10-83db-740051abe700> a crm:PC3_has_note ;
    crm:P01_has_domain <495c0c16-8074-4b31-8942-60dea4ee8b03> ;
    crm:P03_has_range_literal "Ossun (Geneviève de Gramont, comtesse d') (1751-1794), dame d'atours de la reine (1781-1792)" ;
    crm:P3.1_has_type <c5402ae4-4ae9-48a1-86ed-c13de0c97d53> .

<b101049f-bdbb-47db-ab53-45db33fe82b6> a crm:PC3_has_note ;
    crm:P01_has_domain <c11e5086-871f-4469-8f07-c32ed51e435d> ;
    crm:P03_has_range_literal "Participa aux réjouissances de la cour de Hanovre pour le Carnaval de l'année 1693 (cf. MG-1693-04_208)." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<b106e45a-7654-4290-b420-bd7d89a033ee> a crm:PC3_has_note ;
    crm:P01_has_domain <77dfff53-711e-4c4a-886a-c15214a6ac90> ;
    crm:P03_has_range_literal "Chevalier de l'ordre de Saint-Jean de érusalem, commandeur de Caignac, procureur et receveur général du Trésor de l'Ordre, au grand prieuré de Toulouse entre 1678 et 1694." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<b1162465-0a28-486a-b38c-f6a6e24afedf> a crm:PC3_has_note ;
    crm:P01_has_domain <3e4addf1-5123-4f58-bcdf-7264aafb94c1> ;
    crm:P03_has_range_literal "Général, il quitte la France pour le Siam en mars 1687, avec pour instructions d'établir des garnisons françaises à Mergui et à Bangkok." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<b1170f59-31fa-4a33-b15b-71435af8efc7> a crm:PC3_has_note ;
    crm:P01_has_domain <b23ba521-d432-4f97-8a82-8f06d2bbf553> ;
    crm:P03_has_range_literal "fille d'honneur de Madame (1682.01)" ;
    crm:P3.1_has_type <c5402ae4-4ae9-48a1-86ed-c13de0c97d53> .

<b1206f16-8834-4bcd-8078-691a22e3f7b2> a crm:PC3_has_note ;
    crm:P01_has_domain <c92f5e49-d8b0-4b34-bdf7-d0a3b0cb96dc> ;
    crm:P03_has_range_literal "D'après le *Mercure galant*, M. Normandeau était organiste du Collège de Navarre. Il est l'auteur de deux airs parus dans le périodique en 1689 et 1691 (cf. [1689-06a_114](https://data-iremus.huma-num.fr/sherlock/mercure-galant/article/1689-06a_114), [1691-09_311a](https://data-iremus.huma-num.fr/sherlock/mercure-galant/article/1691-09_311a)). Il ne doit pas être confondu avec M. Normandeau l'aîné, dont le *Mercure galant* affirme en 1699 qu'il était \"cy-devant Page de la Chapelle du Roy\" (cf. MG-1699-09\\_205) qui pourrait être son fils." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<b125fd22-d9e1-4b3a-aa51-247320548eb2> a crm:PC3_has_note ;
    crm:P01_has_domain <719f3110-e9bb-4952-a8f4-07d28ca05676> ;
    crm:P03_has_range_literal "Turgot de Saint-Clair (Dominique-Barnabé de) (1667-1727), premier aumônier du duc de Berry (1711-1727)" ;
    crm:P3.1_has_type <c5402ae4-4ae9-48a1-86ed-c13de0c97d53> .

<b12a429d-064d-4f00-9e89-e3f89334fb4f> a crm:PC3_has_note ;
    crm:P01_has_domain <fc6ec345-a52e-4d35-a519-b500dc8e6e4a> ;
    crm:P03_has_range_literal "Aubert (Jean-Jacques) (actif v. 1685), charpentier" ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<b13f3ea9-a739-4538-b707-50fdcc0c7f5e> a crm:PC3_has_note ;
    crm:P01_has_domain <1084db02-2f6e-49b7-af78-7b0023a0abcb> ;
    crm:P03_has_range_literal "Gouverneur du comté de Nice (cf. MG-1693-02a_303)." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<b14b57bb-37c0-4fbb-9db6-89da34cebb35> a crm:PC3_has_note ;
    crm:P01_has_domain <1ed3a69d-7d6c-4d7f-a6b7-97b3b805ad31> ;
    crm:P03_has_range_literal "Participa aux réjouissances de la cour de Hanovere pour le Carnaval de l'année 1693 (cf. MG-1693-04_208)." ;
