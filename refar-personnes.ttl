    crm:P03_has_range_literal "Maillebois (Louise-Marie-Emmanuelle de Tourzel d'Alègre, marquise de) (1692-1756), dame pour accompagner Mesdames (1751-1752), dame pour accompagner Madame Adélaïde (1752-1756)" ;
    crm:P3.1_has_type <c5402ae4-4ae9-48a1-86ed-c13de0c97d53> .

