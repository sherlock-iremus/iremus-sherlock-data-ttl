<cd5de465-f314-49a9-ab3c-4e17f1cf576a> a crm:PC3_has_note ;
    crm:P01_has_domain <b9c9c7c2-8746-4da0-8b2b-50f88d1f5d5f> ;
    crm:P03_has_range_literal "Le comte de San Estevan accompagna Philippe V lors de son voyage dans les états italiens en 1702 (cf. [1702-12_322](https://data-iremus.huma-num.fr/sherlock/mercure-galant/article/1702-12_322))." ;
