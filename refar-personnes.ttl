<8a0ff1a0-9603-463f-b1c4-0023d5740058> a crm:PC3_has_note ;
    crm:P01_has_domain <d80ad849-3d64-4c14-a361-7938c071c175> ;
    crm:P03_has_range_literal "Le Mercure galant de juillet 1704 consacré aux réjouissances organisées pour célébrer la naissance du duc de Bretagne mentionne M. de Brissac, alors pensionnaire au collège Louis-le-Grand (cf. [1704-07b_178](https://data-iremus.huma-num.fr/sherlock/mercure-galant/article/1704-07b_178)). Il figure au programme d’une représentation de théâtre du même collège, en avril 1701 (https://catalogue.bnf.fr/ark:/12148/cb333947409)." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

