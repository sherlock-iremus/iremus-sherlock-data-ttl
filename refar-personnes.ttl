<83b4da45-376d-4391-b27f-6c14a36ae1ad> a crm:PC3_has_note ;
    crm:P01_has_domain <1f57664a-b52c-493b-97d1-e790ee412e56> ;
    crm:P03_has_range_literal "Jean Reynal était maître à danser, frère de Guillaume Reynal, tous les deux membres de l’Académie Royale de Danse (cf. Société des études historiques. L’Investigateur, Paris: 1879, p. 320)." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<83c2db9d-079f-4653-9fe5-fb568e729351> a crm:PC3_has_note ;
    crm:P01_has_domain <a8e49629-b653-4821-9440-c3a25bfd3b1e> ;
