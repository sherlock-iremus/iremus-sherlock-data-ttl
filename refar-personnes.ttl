    crm:P3.1_has_type <c5402ae4-4ae9-48a1-86ed-c13de0c97d53> .

<a1599249-7d18-4bd5-b01d-b551cef93716> a crm:PC3_has_note ;
    crm:P01_has_domain <7a8c0a9f-2775-4a11-b329-88d468917b91> ;
    crm:P03_has_range_literal "Claude-Marie de Saint Georges (1677-?), chanoine-comte de Saint-Jean de Lyon (1697), était le neveu de Claude de Saint-Georges, Archevêque de Lyon. Il fut “précenteur de l’église de Lyon” (cf. Journal Historique sur les Matières du Tems, Tome VI, Paris : Étienne Ganeau, 1719, p. 155)." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<a16c5eb4-32d1-45e9-9434-159b7f3f51b8> a crm:PC3_has_note ;
    crm:P01_has_domain <96b9febc-19af-4a23-ae5c-d579659e541a> ;
    crm:P03_has_range_literal "Alincourt (Marie-Josèphe de Boufflers, duchesse d') (1704-1738), dame du palais de la reine (1726-1734)" ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<a1b4748d-2e97-4f47-91f2-18f6dc8fc265> a crm:PC3_has_note ;
    crm:P01_has_domain <42f801bc-cbd9-47f3-9520-99cdfafc521b> ;
    crm:P03_has_range_literal "M. Paillot est l'un des commissaires fondateurs de l'Académie de musique de Troyes." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<a1cb7046-8ed2-42af-b4bb-feec1b203d6b> a crm:PC3_has_note ;
    crm:P01_has_domain <c4ad290a-d7f5-4e4f-b770-8d95e88e0c47> ;
    crm:P03_has_range_literal "Isaac Royer était consul de France en Smyrne entre 1697 et 1707 (cf. https://journals.openedition.org/cdlm/11218, consulté le 10 juin 2021)." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<a1fdc1ed-b124-46b1-bb8d-5b0b5c3d4089> a crm:PC3_has_note ;
    crm:P01_has_domain <5ff6c7e0-f35a-4dec-8cda-c246c76cee3f> ;
    crm:P03_has_range_literal "Rabiet d'Antespine est l'auteur des paroles d'un air publié dans le *Mercure Galant* en janvier 1691 (cf. MG-1691-01\\_332)." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<a2116206-ec3b-4b57-ba53-7853e695045c> a crm:PC3_has_note ;
    crm:P01_has_domain <2fdcd9e5-ff2d-4349-9310-3ff9b7a918b5> ;
    crm:P03_has_range_literal "Secrétaire des commandements du dauphin (cf. MG-1698-01\\_274)." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<a211efbb-4ec5-48ad-8f37-20cab9007b3e> a crm:PC3_has_note ;
    crm:P01_has_domain <d43150b4-7c7a-4444-868e-d8aa7fbac7e6> ;
    crm:P03_has_range_literal "Marie-Gatienne Bacilly, nièce de Bertrand de Bacilly, épousa le chanteur Jean Daniel qui reprit en 1678 la clientelle de Bertand de Bacilly (cf. L. Guillo et F. Michel,«  Nouveaux documents sur le maître de chant Bertrand de Bacilly (1621-1690)  », *Revue de musicologie*, 97/2 (2011), p. 269-327)." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<a233b695-5654-49a0-920d-81fb39584ca7> a crm:PC3_has_note ;
    crm:P01_has_domain <190343c3-4674-4734-b62a-541a527013ba> ;
    crm:P03_has_range_literal "Charles Allard, le père, était un sauteur et un entrepreneur de spectacles. Il a introduit ses deux fils, Charles et Pierre, en 1699 lors des célébrations du carnaval à Marly (cf. http://www.theatrales.uqam.ca/foires/08a.html#allard, consulté le 25 mai 2021)." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<a24c3af3-3bdb-42cd-ba75-dd101462bcb0> a crm:PC3_has_note ;
    crm:P01_has_domain <968162e5-6dd9-4dd9-b346-941bf05e0525> ;
    crm:P03_has_range_literal "Forcoal (Jean de) (1621-1682), aumônier du roi (1645-1648... ; ...1663-1671), évêque de Séez (1670-1682)" ;
    crm:P3.1_has_type <c5402ae4-4ae9-48a1-86ed-c13de0c97d53> .

<a274bbeb-a5e3-4b55-ae84-c83086040139> a crm:PC3_has_note ;
    crm:P01_has_domain <2d883eed-eab7-44fb-ac5c-9deec30d7e33> ;
    crm:P03_has_range_literal "M. Tesson est l'auteur d'un madrigal destiné à être mis en musique paru dans le Mercure galant de juin 1701 (cf. MG-1701-06\\_065), d'une épître en vers (cf. MG-1702-02a\\_70), et d'un autre madrigal publié en avril 1702 (cf. MG-1702-04\\_139)." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<a2816973-1c40-4b48-a670-9313aa0e9bbb> a crm:PC3_has_note ;
    crm:P01_has_domain <14f38e92-9ad9-4e3b-8e19-3b8fc578eee2> ;
    crm:P03_has_range_literal "Curé de l'église Notre-Dame de Niort (cf. MG-1692-11_188)." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<a29bbb58-9310-4316-9971-d1389492a532> a crm:PC3_has_note ;
    crm:P01_has_domain <4f8d1de7-4640-4702-b0ac-d89e6582c39d> ;
    crm:P03_has_range_literal "M. de La Coste pourrait avoir proposé une nouvelle harmonisation de l'air \"Ainsi que mon amour\" publié anonymement dans le Mercure galant de septembre 1700 (cf. MG-1700-09\\_144). Cette harmonisation est parue dans le Recueil d'airs sérieux et à boire (Paris, Ballard, juillet 1700)." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<a2d1d117-d621-4ad7-8c74-b8a06e9aba84> a crm:PC3_has_note ;
    crm:P01_has_domain <5cc1bd30-308d-48bd-8240-d9bcd5653514> ;
    crm:P03_has_range_literal "Protestant écossais, soutien de Marie, reine d'écosse." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<a315b001-b71a-456b-8242-51e4f3dc1ecd> a crm:PC3_has_note ;
    crm:P01_has_domain <7c5e7763-ed8d-4480-87c1-d3090c8c53d5> ;
    crm:P03_has_range_literal "Participa aux réjouissances du Carnaval de la cour de Lorraine en 1699 (cf. MG-1699-03_151)." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<a327bf75-288a-4f75-b6ae-14d0d527c12f> a crm:PC3_has_note ;
    crm:P01_has_domain <7e938c0e-fa1c-48d4-bbb5-1f32ff9dcd97> ;
    crm:P03_has_range_literal "Maître de la chapelle de la cathédrale de Soissons. Il a fait publier \"Les délices de la table, des airs...meslez de. cantatilles\" et diverses cantatilles." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<a3336db8-a2e7-424d-ad7b-19477455b340> a crm:PC3_has_note ;
