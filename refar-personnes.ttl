    crm:P03_has_range_literal "Mailly de Nesles (François de) (1658-1721), cardinal (1719-1721)" ;
    crm:P3.1_has_type <c5402ae4-4ae9-48a1-86ed-c13de0c97d53> .

<a6f6a68d-d507-4af5-8c1e-20b544a0e5bf> a crm:PC3_has_note ;
    crm:P01_has_domain <27240195-a929-4ce0-a326-cb37e1d9f954> ;
    crm:P03_has_range_literal "Le Mercure galant mentionne Madame la Présidente de Beaumont qui a participé aux réjouissances publiques organisées à Château-Gontier pour la naissance du duc de Bretagne en 1704." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<a6f81510-9efa-43f8-bb99-efa02e45c577> a crm:PC3_has_note ;
