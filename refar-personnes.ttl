    crm:P03_has_range_literal "M. Cordetz est un des commissaires fondateurs de l'Académie de musique de Troyes." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<a5710699-1553-412e-8f7f-53886465c14a> a crm:PC3_has_note ;
