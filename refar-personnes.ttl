<4aa86f6b-a6cc-4c15-8fb1-fe9cbd748aca> a crm:PC3_has_note ;
    crm:P01_has_domain <634ed06e-ff44-4c56-8632-dba32b38db37> ;
    crm:P03_has_range_literal "Nicolas Montailly est un compositeur et maître de musique français actif à Paris dans le dernier quart du XVIIe siècle et le premier du XVIIIe. Il est l'auteur de nombreux airs dont vingt-trois parurent dans le *Mercure galant* entre 1688 et 1708." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

