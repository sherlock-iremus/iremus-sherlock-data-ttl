<fd23c5b5-aa9b-49d5-914a-ca6c8d573517> a crm:PC3_has_note ;
    crm:P01_has_domain <53d108ef-922e-4c69-9f5c-2b68976e248c> ;
    crm:P03_has_range_literal "Madame de Middleton a participé à une fête organisée par Louis XIV à Versailles à laquelle la cour d'Angleterre exilée à Saint-Germain-en-Laye participa (cf. [1708-01_244](https://data-iremus.huma-num.fr/sherlock/mercure-galant/article/1708-01_244)). Il pourrait s'agir de Catherine Brudenell, countess of Middleton (cf. <https://www.npg.org.uk/collections/search/portrait/mw139850/Catherine-ne-Brudenell-Countess-of-Middleton>, consulté le 2 avril 2021), épouse du comte de Middleton (cf. <https://fr.nipponkaigi.net/wiki/Charles_Middleton,_2nd_Earl_of_Middleton>, consulté le 2 avril 2021)." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<fd2aaa92-315c-4192-9445-bc889f18d16a> a crm:PC3_has_note ;
    crm:P01_has_domain <7e4f0bd0-e1da-4e59-954b-2be6c01b65e3> ;
    crm:P03_has_range_literal "Le \"Solitaire du bois du Val-Dieu\" est le pseudonyme utilisé par l'auteur des paroles d'un air publié dans le *Mercure Galant* de janvier 1710 (cf. MG-1710-01\\_299)." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<fd398230-4bae-428a-bca0-226aa51ccd79> a crm:PC3_has_note ;
    crm:P01_has_domain <a70fe44e-2b6f-404c-a4b7-d221381a49b2> ;
    crm:P03_has_range_literal "Prévôt de Château-Thierry (cf. MG-1698-01_021)." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<fd3d4ddc-6a71-45e1-8794-7b8e0ba5a16b> a crm:PC3_has_note ;
    crm:P01_has_domain <bdbb41ee-e9af-44a7-add3-b01fe42858fa> ;
    crm:P03_has_range_literal "François I Martin est un compositeur français, actif à Paris durant la seconde moitié du XVIIe siècle. Il a été ordinaire de la musique de Gaston d'Orléans et a publié un recueil de pièces pour la guitare (1663), un recueil d'airs (1668) et des airs isolés, dont quatre dans le *Mercure galant* (cf. MG-1678-04\\_071 ; MG-1688-11a\\_136 ; MG-1689-04a\\_076 et MG-1689-04a\\_317). Il est également l'auteur d'une pastorale, Les Bergers heureux (cf. MG-1689-09\\_021). Il est le père de François (1661-?)." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<fd412699-9b5b-42f2-8075-cbad35fa3d8d> a crm:PC3_has_note ;
    crm:P01_has_domain <4eca5596-1159-4610-9d8d-3de71277f823> ;
    crm:P03_has_range_literal "Maître de musique de la cathédrale de Nantes et de celle de l'Eglise métropole d'Auch." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<fd421e49-ca70-4e58-86cd-9921511ffb68> a crm:PC3_has_note ;
    crm:P01_has_domain <80694d01-4aae-4552-9c62-bd57729fb3d0> ;
    crm:P03_has_range_literal "Sancy (M. de), censeur royal (1776…), secrétaire général de la Librairie et Imprimerie de France (1777…), garde de la Bibliothèque particulière du roi à Versailles et du Cabinet des livres à la suite de la cour (…1782-1789…)" ;
    crm:P3.1_has_type <c5402ae4-4ae9-48a1-86ed-c13de0c97d53> .

<fd59af0e-1f36-4ed2-a969-ce7a74cc78e5> a crm:PC3_has_note ;
    crm:P01_has_domain <66c5ebaa-e16e-4b61-bab6-96457830f184> ;
    crm:P03_has_range_literal "Frère de la reine de Pologne (1694.06)." ;
    crm:P3.1_has_type <c5402ae4-4ae9-48a1-86ed-c13de0c97d53> .

<fd69ccc0-0427-4615-bee6-84e37dc6c298> a crm:PC3_has_note ;
