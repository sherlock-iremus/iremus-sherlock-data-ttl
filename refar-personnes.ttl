    crm:P01_has_domain <2d00d839-0fcb-4481-8d54-7c4cad8172c9> ;
    crm:P03_has_range_literal "Targny (Louis de) (v. 1659-1737), garde des imprimés (1720-1726), puis des manuscrits (1726-1737) de la Bibliothèque du roi" ;
    crm:P3.1_has_type <c5402ae4-4ae9-48a1-86ed-c13de0c97d53> .

<36332392-9e05-4e64-b17f-f71ee31a6d16> a crm:PC3_has_note ;
    crm:P01_has_domain <1084db02-2f6e-49b7-af78-7b0023a0abcb> ;
    crm:P03_has_range_literal "Gouverneur du comté de Nice (cf. [1693-02a_303](https://data-iremus.huma-num.fr/sherlock/mercure-galant/article/1693-02a_303))." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<36590d53-dd3e-4f8b-b20b-bc99154d8ee8> a crm:PC3_has_note ;
    crm:P01_has_domain <2d9e47e8-61d6-4784-9f5f-e013a3563371> ;
    crm:P03_has_range_literal "Louise-Anne Lecomte de Latresne était l'épouse du Président du Parlement de Bordeaux, Jean-Baptiste Lecomte de Latresne (?-1703)." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<3668f786-8930-4fa5-a7f7-6843f04361a9> a crm:PC3_has_note ;
    crm:P01_has_domain <03836b03-6e51-4571-a037-e0c3c49515a4> ;
    crm:P03_has_range_literal "Le *Mercure galant* de mars 1702 évoque l'abbé Bruzen, de Dieppe, auteur d'une paraphrase de psaume (cf. [1702-03_215](https://data-iremus.huma-num.fr/sherlock/mercure-galant/article/1702-03_215))." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<367bd9a9-ebae-4ba6-9376-006e7ec4652c> a crm:PC3_has_note ;
    crm:P01_has_domain <184da222-2136-4aee-8837-246cf6a70c6a> ;
    crm:P03_has_range_literal "D'après le Mercure galant, M. Labbé, a été successivement maître de musique à Saint-Jacques de Dieppe (1678-1679) puis maître de musique de Caën (1679), avant de s'établir à Rouen \"comme un homme rare & qui passe pour un des plus habiles Musiciens du Royaume, non seulement pour l'Art de composer, mais aussi pour la belle métode du Chant, qu'il enseigne à tout ce qu'il y a de Personnes de qualité dans la Ville\" (cf. [1686-11a_070b](https://data-iremus.huma-num.fr/sherlock/mercure-galant/article/1686-11a_070b)). Il se serait formé auprès des meilleurs maîtres de Paris et auprès de Bacilly lors d'un passage de ce dernier en Normandie (cf. MG-1687-09a\\_350)." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<367ffa4d-f073-462e-8902-c43572f33530> a crm:PC3_has_note ;
    crm:P01_has_domain <96fda2c0-6799-48c5-b9db-168a23a32bfe> ;
    crm:P03_has_range_literal "Périn, Albert-François (1688-1759), valet de chambre du roi (…1708-1736…), porte-manteau du roi (…1712-av. 1718 ; …1736-av. 1749), sous-gouverneur (…1718-av. 1749), précepteur (…1736-1749…), puis gouverneur (…1749-1756…) des pages de la Grande Écurie" ;
    crm:P3.1_has_type <c5402ae4-4ae9-48a1-86ed-c13de0c97d53> .

<36a3df9a-b2e8-4e02-a5d9-12710b87c1b0> a crm:PC3_has_note ;
    crm:P01_has_domain <5b2391ae-1f34-49e3-b6cf-0d0867547385> ;
    crm:P03_has_range_literal "Sallier (Claude) (1685-1761), précepteur, professeur d'hébreu au Collège royal (1719…), garde des imprimés de la Bibliothèque du roi (1726-1761), secrétaire-interprète du duc d'Orléans (…1749…)" ;
    crm:P3.1_has_type <c5402ae4-4ae9-48a1-86ed-c13de0c97d53> .

<36abe899-4562-4884-a690-4ec9d7c9bbc9> a crm:PC3_has_note ;
    crm:P01_has_domain <0b28c95e-eaeb-45ca-8472-87e16f5a3833> ;
    crm:P03_has_range_literal "Giovanni Battista Roca prit part aux manifestations organisées par la République de Gênes pour la réception de Philippe V d'Espagne en novembre 1702 (cf. MG-1702-12\\_191)." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<36b0ae3f-bfbc-4c3a-aa31-61eb77c785ea> a crm:PC3_has_note ;
    crm:P01_has_domain <ada0d9ff-3413-4ea1-820a-cedd9c58f354> ;
    crm:P03_has_range_literal "Compositeur, candidat au concours pour le poste de sous-maître de musique de la Chapelle Royale (cf. MG-1683-04_310)." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<36bae6f3-3ce0-4ce8-b844-a5cfa3bf072d> a crm:PC3_has_note ;
    crm:P01_has_domain <a793389d-a6b5-4573-8b1d-04c517a76674> ;
    crm:P03_has_range_literal "Père de M. de Mirabeau et du chevalier d'Agoult (cf. MG-1687-06a_166)." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<36bc82a9-54a7-4801-87e8-b5053e361028> a crm:PC3_has_note ;
    crm:P01_has_domain <c2e62695-0df5-4d76-92d9-bec935d7a69d> ;
    crm:P03_has_range_literal "Antibes (Charles de Grimaldi d') (1705-1770), évêque de Rodez (1747-1770)" ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<36d37440-b54e-4d41-bbdc-2182d8c6e1d2> a crm:PC3_has_note ;
    crm:P01_has_domain <39af5121-1464-494b-8295-56818e943976> ;
    crm:P03_has_range_literal "Albrecht Konrad Finck von Finckenstein (1660-1735) fut “maréchal et homme de cour prussien, familier du roi-sergent. Il fut le précepteur de Frédéric II” (cf. https://fr.wikipedia.org/wiki/Albrecht\\_Konrad\\_Finck\\_von\\_Finckenstein, consulté le 29 mars)." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<36d6475a-9ee2-459a-b32d-f3f36f9b8ba0> a crm:PC3_has_note ;
    crm:P01_has_domain <73ca78c2-ac87-4a57-8c6b-60cd1cd788cd> ;
    crm:P03_has_range_literal "Lieutenant du roi (cf. MG-1678-12_092)." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<36d9faa4-38f2-48ac-9ad5-d6d75106811a> a crm:PC3_has_note ;
    crm:P01_has_domain <38e8b22f-1eb5-48ab-a87e-472cd73dee04> ;
    crm:P03_has_range_literal "Fondeur de cloches à Lisieux (cf. MG-1686-02a_162)." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<37055ce4-ae5b-4653-8cc7-4b61b0efddd9> a crm:PC3_has_note ;
    crm:P01_has_domain <0e637de6-c137-4d06-ba40-59c5526a143d> ;
    crm:P03_has_range_literal "Épouse de Charles de Faucon de Ris." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<3709c482-f729-4345-ba29-6c4431132894> a crm:PC3_has_note ;
    crm:P01_has_domain <ae9a4885-e290-4bee-b282-2a39346a53e7> ;
    crm:P03_has_range_literal "Épouse en 1683 une demoiselle de Bonneville, à Saint-Bonnet-le-Chastel (cf. MG-1683-02_051)." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<3711647c-970c-4dc5-9238-d289ce0aeef1> a crm:PC3_has_note ;
    crm:P01_has_domain <a8a1b119-358f-4e75-abc2-adb9b396b31c> ;
    crm:P03_has_range_literal "M. Puget, de Berance est l'auteur d'une ode publiée dans le Mercure galant en avril 1702 (cf. MG-1702-04\\_282). Nous n'avons pas pu identifier avec certitude la ville où il réside à cette date. Peut-être s'agit-il de Cérance, dans l'évêché de Coutances (gouvernement de Normandie), à peu de distance de la Bérence, affluent de la Sienne." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<3711faa0-90a5-4180-97a7-9f0c19ebf1c2> a crm:PC3_has_note ;
    crm:P01_has_domain <8b772a89-c29d-4def-8289-629431fee1b2> ;
    crm:P03_has_range_literal "Organiste de S. Aspais de Melun ; compositeur d'une cantate perdue (L'amour égaré)" ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<37352360-125c-4eb0-ba7d-ad83cca91025> a crm:PC3_has_note ;
    crm:P01_has_domain <5353f8b0-91cb-41e3-b556-de13b711442d> ;
    crm:P03_has_range_literal "M. Vauthier est l'un des commissaires fondateurs de l'Académie de musique de Troyes." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<3744114a-a4a5-4736-b252-0d0eca8793f0> a crm:PC3_has_note ;
    crm:P01_has_domain <4c3ef283-87cb-447d-8a55-844b04035855> ;
    crm:P03_has_range_literal "Dans le *Mercure Galant* de mars 1705*,* le rédacteur attribue les paroles d'un poème qui sera mis en air à \"Mr. Chauveau de Chartes qui a donné au Public deux Volumes d'histoires galantes & comiques & plusieurs petits contes en vers, qui ont esté bien reçûs.\"" ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<37676de6-e9bb-4fd3-9034-4765409d1896> a crm:PC3_has_note ;
    crm:P01_has_domain <a368c0f6-734f-4f3d-b2e5-981679e740ce> ;
    crm:P03_has_range_literal "Louis Nivelle (1638-1718) était avocat au parlement de Paris). Il est le père de Gabriel-Nicolas Nivelle (1687-1771), prêtre janséniste." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

