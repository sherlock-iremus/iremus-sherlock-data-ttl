    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<ead2acbb-422c-412b-af63-bcf6308d2458> a crm:PC3_has_note ;
    crm:P01_has_domain <18e5bf8d-6d57-4805-b041-5e36ae0da221> ;
    crm:P03_has_range_literal "Amateur, auteur d'une cantatille (*L'inconstance fixée*) et d'une ariette (*La bergère timide*) éditées. chez Le Menu." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

