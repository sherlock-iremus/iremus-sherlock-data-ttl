    crm:P03_has_range_literal "Villaquirán (Estefanía Romero de) (?-1631), azafata de la reine (1601-1615), première femme de chambre de la reine (1615-1631)" ;
    crm:P3.1_has_type <c5402ae4-4ae9-48a1-86ed-c13de0c97d53> .

