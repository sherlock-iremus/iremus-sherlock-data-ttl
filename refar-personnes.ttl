<e06f8a5a-c1b0-4479-b3f7-b413965d1339> a crm:PC3_has_note ;
    crm:P01_has_domain <75dc3451-d0ca-4c1f-ab3b-b9653382e591> ;
    crm:P03_has_range_literal "François le Maçon des Rabines a été chanoine du Mans, aumônier du duc d'Orléans et traducteur. Il est né à Château-du-Loir et mort à Paris en 1723 (cf. Société historique et archéologique du Maine, Revue historique et archéologique du Maine, Janvier 1938, page 103, en ligne https://gallica.bnf.fr/ark:/12148/bpt6k5613918f, consulté le 31 mars 2021)." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<e0780061-d648-4653-a4ac-ba1070f48876> a crm:PC3_has_note ;
