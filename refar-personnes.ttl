    crm:P01_has_domain <6f050d63-1e6f-4ff5-ba7b-b46821902817> ;
    crm:P03_has_range_literal "M. Alison est l'auteur d'un rondeau et de stances publiés dans le *Mercure galant* en janvier et février 1702 (cf. MG-1702-01\\_140 ; MG-1702-02a\\_66)." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<3d66f787-2c4b-472a-a99b-dd935404737d> a crm:PC3_has_note ;
    crm:P01_has_domain <1f792bf7-8d20-4c89-bd07-8e9514a70317> ;
    crm:P03_has_range_literal "Guy Carré, seigneur de Montgeron (?- 1732) fut Intendant du Berry de 1705 à 1708 (cf. Mémoires de la Société des antiquaires du Centre, (1931-1933) vol. 45, Bourges, Imprimerie André Tardy, 1934, p. 220 ; https://gallica.bnf.fr/ark:/12148/bpt6k415240d/f1.item?lang=FR, consulté le 29 mars 2021). Il fut aussi “maître des requêtes puis intendant à Limoges (1709-1711)” (cf. https://fr.wikipedia.org/wiki/Liste\\_des\\_intendants\\_de\\_la\\_généralité\\_de\\_Bourges, consulté le 29 mars 2021)." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<3d7e40ec-051e-4b42-b1ca-a74e8a522379> a crm:PC3_has_note ;
