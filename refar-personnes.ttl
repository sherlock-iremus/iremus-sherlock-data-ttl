<0c90b07c-6840-46ea-b55c-9e86f41e94a3> a crm:PC3_has_note ;
    crm:P01_has_domain <28108107-d2ca-489a-9940-8f48251321eb> ;
    crm:P03_has_range_literal "M. Dégan (fl. 1680) était membre de l’Académie Royale de Danse (cf. [1680-06_263](https://data-iremus.huma-num.fr/sherlock/mercure-galant/article/1680-06_263))." ;
