<7bf317a6-e8a7-4dd4-837e-cd5a99585250> a crm:PC3_has_note ;
    crm:P01_has_domain <eb9ce2bd-fc6d-41b8-9e8d-47f6930d4f0c> ;
    crm:P03_has_range_literal "Giuseppe Tortoriti fut acteur et membre de la Comédie Italienne (1683-1697). Il était connu pour son rôle de Pascariel (cf. Guy Boquet, Les Comédiens Italiens à Paris au temps de Louis XIV , dans Revue d’histoire moderne et contemporaine, tome 26 N°3, Juillet-septembre 1979. pp. 422-438 ; https://www.persee.fr/doc/rhmc\\_0048-8003\\_1979\\_num\\_26\\_3\\_1065)." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

