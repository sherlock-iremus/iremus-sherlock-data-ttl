    crm:P03_has_range_literal "Fleury (Pierre-Augustin-Bernardin de Rosset de Rocozels de) (1717-1780), premier aumônier de la reine (1743-1768), évêque de Chartres (1746), premier aumônier de la dauphine (1770-1774), grand aumônier de la reine (1774-1780)" ;
