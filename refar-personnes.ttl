<6570c76d-f217-4652-a111-0431f07bbed6> a crm:PC3_has_note ;
    crm:P01_has_domain <7e4f0bd0-e1da-4e59-954b-2be6c01b65e3> ;
    crm:P03_has_range_literal "Le \"Solitaire du bois du Val-Dieu\" est le pseudonyme utilisé par l'auteur des paroles d'un air publié dans le *Mercure Galant* de janvier 1710 (cf. [1710-01_299](https://data-iremus.huma-num.fr/sherlock/mercure-galant/article/1710-01_299))." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<6573d8d9-b3fd-4233-a316-3532b2d7ca93> a crm:PC3_has_note ;
