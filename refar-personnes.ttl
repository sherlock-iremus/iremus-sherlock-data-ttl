<90640d94-b0dc-47bc-9106-38a5ceca7b63> a crm:PC3_has_note ;
    crm:P01_has_domain <bdc0760d-b96e-4e62-9b4d-4858a3407e93> ;
    crm:P03_has_range_literal "Fils de Charles II (1630-1685). Duc de Monmouth et de Buccleuch. Se déclare prétendant au trône à la mort de son père en 1685. Exécuté le 15 juillet 1656 après l'échec de la Rebéllion de Montmouth." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

