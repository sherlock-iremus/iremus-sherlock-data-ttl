    crm:P03_has_range_literal "Fouquet (Louis) (1633-1702), évêque d'Agde (1656-1702), maître de l'oratoire (1661-1680)" ;
    crm:P3.1_has_type <c5402ae4-4ae9-48a1-86ed-c13de0c97d53> .

<8e1649c0-4be4-4500-89e8-d73d60d51e49> a crm:PC3_has_note ;
    crm:P01_has_domain <b455bac2-6481-4cc7-b3db-c60bdc98fc36> ;
    crm:P03_has_range_literal "Commandant des brigades à La Patache (cf. [1687-03b_311](https://data-iremus.huma-num.fr/sherlock/mercure-galant/article/1687-03b_311))." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<8e64dd50-3b91-48e8-97e8-dbe6f09d36c9> a crm:PC3_has_note ;
    crm:P01_has_domain <d4c5ec39-9828-4f00-bff6-94dcdb99c415> ;
    crm:P03_has_range_literal "Charles Trudaine, seigneur de Montigny (1660-1721) fut maître des requêtes (1689), intendant de Lyon (1704-1710), intendant de Bourgogne (1710-1711) après quoi il siégea au Conseil d'État. Il fut membre de l'Académie des sciences, belles-lettres et arts de Lyon de 1704 à 1710." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<8e67bc93-eaf5-468e-b966-f8a8fa947f31> a crm:PC3_has_note ;
    crm:P01_has_domain <c356da4a-3115-4a9b-8ed7-f054e0c7c05c> ;
    crm:P03_has_range_literal "Capitaine de cavalerie au service de Sa Majesté Très Catholique (cf. MG-1699-03_151)." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<8e885bad-29df-48d8-801d-f7ef7198a8a0> a crm:PC3_has_note ;
    crm:P01_has_domain <452701f4-e1cf-4ac3-bc83-03209bbe8e31> ;
    crm:P03_has_range_literal "Marchand des Chartrons de Bordeaux (cf. [1682-09b_015](https://data-iremus.huma-num.fr/sherlock/mercure-galant/article/1682-09b_015))." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<8eb16a2f-7af0-40dd-adf2-cdf240c711f7> a crm:PC3_has_note ;
    crm:P01_has_domain <a9b0063d-55af-46f1-b94a-cb05a39c92cf> ;
    crm:P03_has_range_literal "M. de Farcy était doyen de la faculté de médecine de Paris (cf. [1702-02a_312](https://data-iremus.huma-num.fr/sherlock/mercure-galant/article/1702-02a_312))." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

