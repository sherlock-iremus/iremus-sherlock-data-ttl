<21c27414-caca-442d-8661-332d44f75840> a crm:PC3_has_note ;
    crm:P01_has_domain <b2ecedf7-6ba0-4a77-9432-a3a43fe1d63c> ;
    crm:P03_has_range_literal "Marc-Antoine Deslandes fût chanoine du chapitre de la cathédral de Tréguier de 1677 à 1702, archidiacre de la même ville de 1688 à 1708 ainsi que recteur de la paroisse de Saint-Michel de Saint-Brieuc de 1702 à 1708 (cf. CHARLES, Olivier, Chanoines de Bretagne : Carrières et cultures d'une élite cléricale au siècle des Lumières. Nouvelle édition [en ligne]. Rennes, Presses universitaires de Rennes, 2004 (généré le 23 mars 2021). Disponible sur Internet : http://books.openedition.org/pur/17414 ; ISBN : 9782753524699 ; DOI : https://doi.org/10.4000/books.pur.17414, consulté le 22 mars 2021)." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<21d320a3-2d08-4a39-a0c4-9ec250a0c41d> a crm:PC3_has_note ;
    crm:P01_has_domain <958cdf45-9cfb-4db8-b9b9-d20b078343bf> ;
    crm:P03_has_range_literal "M. Declassens, « Gentilhomme Liegeois, cy-devant Capitaine dans le Regiment de Grenadiers à cheval de Mr l’Electeur Palatin » assista à la célébration de la fête de Saint-Lazare à l’abbaye de Saint-Germain-des-Prés le 19 décembre 1703 (MG-1703-01\\_210)." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<21e58e66-56e5-46b3-be4a-6d7d29f795d1> a crm:PC3_has_note ;
    crm:P01_has_domain <9ce2a6b0-8f7b-4d95-ba43-20c33689f74c> ;
    crm:P03_has_range_literal "Fils aîné du procureur de la Chambre de Württemberg (cf. Procureur de la Chambre de Württemberg (cf. [1684-11_034](https://data-iremus.huma-num.fr/sherlock/mercure-galant/article/1684-11_034)).)" ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

