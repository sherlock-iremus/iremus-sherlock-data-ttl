<45072d11-9ec4-42e8-bb3d-920dd7f7647b> a crm:PC3_has_note ;
    crm:P01_has_domain <cecc3176-d5d1-4bd9-ae28-3d67c084d414> ;
    crm:P03_has_range_literal "Mlle d'O est l'autrice de deux airs parus dans le *Mercure galant* en 1680. En septembre 1680, le périodique affirme \"[qu'] elle est du Quartier S. Paul, dont elle fait un des plus beaux ornemens, & tres-digne Fille d'une Mere qui ayant esté dans son Printemps la plus aimable du monde, conserve dans son Eté tous les agrémens que peuvent avoir celles de son âge.\" (cf. MG-1680-09a\\_340 et MG-1680-11\\_045)." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

