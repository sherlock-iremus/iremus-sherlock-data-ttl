<e266d0de-6ce9-427d-980b-42136080b63a> a crm:PC3_has_note ;
    crm:P01_has_domain <dcb8c1b2-3429-42ab-a0a4-d6fcbca91506> ;
    crm:P03_has_range_literal "Mlle Le Rouge chante lors d'une concert donné par le Petit concert de Troyes le 27 juillet 1756 pour célébrer la prise du fort Saint-Philippe (cf. Annonces, affiches et avis divers. 8 septembre 1756, n° 36, p. 143). Dans la musique latine et française, elle reçoit \"les applaudissements qu'elle s'attire de plus en plus par ses belles cadences et par le goût de son chant\"." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

