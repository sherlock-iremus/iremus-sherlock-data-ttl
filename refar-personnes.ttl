    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<b64f6c5d-b28d-4ee8-9935-f5c3250c75d6> a crm:PC3_has_note ;
    crm:P01_has_domain <148e9e8e-d1f5-462d-9a38-3eeebd49dd89> ;
    crm:P03_has_range_literal "L'abbé Imperiale assista à la célébration de la fête de Saint-Lazare à l'abbaye de Saint-Germain-des-Prés le 19 décembre 1703 (cf. MG-1703-01_210)." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<b65427d4-3c22-46df-818a-a6b4a9538ff5> a crm:PC3_has_note ;
    crm:P01_has_domain <22588ced-b5f3-4a69-bf0e-5d16c6b2bde8> ;
    crm:P03_has_range_literal "Charles Allard était le fils de Charles Allard (1660 av.- 1717 ap.) et le frère de Pierre Allard (fl. 1699-1703)." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<b6572f65-680d-4565-9cdf-ed96213bae26> a crm:PC3_has_note ;
    crm:P01_has_domain <8c56deb1-c63f-48aa-b5ba-5417f3a99d16> ;
    crm:P03_has_range_literal "M. Bxxxxxx a composé la musique de l'air \"Pour un baiser que j'ai reçu de vous\" (cf. MG-1717-06\\_214)." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<b667a42f-d8e4-484f-84df-2000c0a019b8> a crm:PC3_has_note ;
    crm:P01_has_domain <4ca7e83f-bccb-48c4-99f4-5156fd5538d4> ;
    crm:P03_has_range_literal "Reçut les trois Fleurs de l'Académie des jeux floraux de Toulouse en 1694 (cf. MG-1694-05\\_140)." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<b67ef821-4e78-4890-a034-d01efef8422d> a crm:PC3_has_note ;
    crm:P01_has_domain <530c9569-652c-4e2b-abcc-7528883a8db1> ;
