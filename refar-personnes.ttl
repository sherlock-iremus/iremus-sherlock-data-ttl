    crm:P03_has_range_literal "Hauberat (Jean) (v. 1656-1724), inspecteur des Bâtiments du roi à Chaville (1700-1718), puis à Meudon (1718-1722…)" ;
    crm:P3.1_has_type <c5402ae4-4ae9-48a1-86ed-c13de0c97d53> .

