    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<51ccdfd3-9a4d-43a3-b86d-450bfdb3e0a6> a crm:PC3_has_note ;
    crm:P01_has_domain <dbb2add3-a3ff-46d9-bef0-28303e11db51> ;
    crm:P03_has_range_literal "Lieutenant général des armées, Gouverneur de Dole et Châtillon-sur-Seine (cf. MG-1687-03b\\_317), Baron puis Comte de Frolois (1683), Seigneur de Vannaire" ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<5223aa7a-b525-4b63-8267-406df3653760> a crm:PC3_has_note ;
    crm:P01_has_domain <7265f98f-e651-4668-948e-d2ee761d95d6> ;
    crm:P03_has_range_literal "Francisco Antonio marquis d'Eguaras y Pasquier fut envoyé extraordinaire du roi d'Espagne, désigné en juillet 1701 pour aller à la cour de France de la part de Philippe V présenter ses compliments de condoléance au Roi au sujet de la mort de Monsieur, duc d'Orléans, son frère (cf. Mercure galant, octobre 1701, p. 300sq)." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<52377aa8-00e7-41bf-b063-4cbcd4841f09> a crm:PC3_has_note ;
