<a520b6ce-6bf4-4a74-b9c2-53f40ca24250> a crm:PC3_has_note ;
    crm:P01_has_domain <7433f5a5-2aad-4b44-b31a-887d227b6e8d> ;
    crm:P03_has_range_literal "Jean-François Sarrasin est un écrivain français du XVIIe siècle. Il est proche des Scudéry, notamment de Madeleine avec laquelle il a échangé des vers. Il a aussi soutenu Georges de Scudéry en 1639 dans son attaque contre Corneille avec un Discours de la tragédie et alla jusqu'à demander à l’Académie de déclarer la pièce de Scudéry l’Amour tyrannique le chef-d’œuvre de la scène française (cf. https://fr.wikipedia.org/wiki/Jean-Fran%C3%A7ois\\_Sarrasin consulté le 14 janvier 2021)." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<a52d1e90-c478-4129-ab46-7f8b9c131240> a crm:PC3_has_note ;
    crm:P01_has_domain <de268a54-fd7e-4b86-9372-24e8ef9193cf> ;
    crm:P03_has_range_literal "Président et lieutenant général à Niort (cf. MG-1692-08a\\_044)." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<a5521d5a-c076-4149-9b28-6f711535a83e> a crm:PC3_has_note ;
    crm:P01_has_domain <54c5e6d4-c884-445c-a63e-c03b6ab91d94> ;
    crm:P03_has_range_literal "Julien Clopin fut vicomte maïeur de la ville de Dijon de 1703 à 1711 (cf. <https://fr.wikipedia.org/wiki/Mairie_de_Dijon#Historique>, consulté le 19 avril 2021)." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<a55adfb1-2e76-4d42-a0ee-3c24e1593fcf> a crm:PC3_has_note ;
    crm:P01_has_domain <f2e7e513-dbe6-41bf-99da-9d19c0f97452> ;
    crm:P03_has_range_literal "Courtanvaux (François-César Le Tellier, marquis de) (1718-1781), capitaine-colonel des Cent-Suisses de la Garde ordinaire du roi (1740-1745), président de l'Académie royale des sciences (1769 ; 1775)" ;
    crm:P3.1_has_type <c5402ae4-4ae9-48a1-86ed-c13de0c97d53> .

<a55b3748-6fa3-4e61-a84a-0d4113720533> a crm:PC3_has_note ;
