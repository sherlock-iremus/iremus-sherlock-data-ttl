    crm:P01_has_domain <9b743eaf-ec86-42d4-82be-f96435ea0fc3> ;
    crm:P03_has_range_literal "Monsieur de Paratte (fl. 1707) est cité dans le Mercure galant en tant que \"Maréchal de Camp, & qui commande en chef dans le Comté de Nice\" (cf. [1707-02_126](https://data-iremus.huma-num.fr/sherlock/mercure-galant/article/1707-02_126))." ;
