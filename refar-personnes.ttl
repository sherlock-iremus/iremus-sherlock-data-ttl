    crm:P03_has_range_literal "Virginio Valle était lieutenant général de la cavalerie du royaume de Naples (cf. [1680-03a_120](https://data-iremus.huma-num.fr/sherlock/mercure-galant/article/1680-03a_120))." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

