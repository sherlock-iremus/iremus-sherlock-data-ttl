<cf352974-acb9-4ac2-93bb-0c7462d6f9d6> a crm:PC3_has_note ;
    crm:P01_has_domain <2a655236-ee99-4ab8-93a8-77fb53969c58> ;
    crm:P03_has_range_literal "La Houssaye (Félix Le Pelletier de) (1663-1723), conseiller au Châtelet de Paris (1682-1687), Conseiller au parlement de Paris (1687-1690), maître des requêtes de l'Hôtel du roi (1690…), intendant de Soissons (1694-1698), de Montauban (1698-1699), d'Alsace (1699-1715), maître des requêtes honoraire (1707…), conseiller d'État semestre (1708…), conseiller au Conseil des Finances de la Régence (1715…), conseiller d'État ordinaire (1719…), directeur du département des Fermes Générales (1720…), contrôleur général des finances (1720-1721), prévôt et maître des cérémonies commandeur de l'ordre du Saint-Esprit (03/1721-06/1721)." ;
    crm:P3.1_has_type <c5402ae4-4ae9-48a1-86ed-c13de0c97d53> .

<cf68bb35-dcf3-4c6b-8c24-43a20d0743e5> a crm:PC3_has_note ;
    crm:P01_has_domain <535d38df-2d53-4c4e-ac91-1e55ec692388> ;
    crm:P03_has_range_literal "Le Mercure galant indique que Jean Foloppe était avocat du roi (cf. [1704-07b_292](https://data-iremus.huma-num.fr/sherlock/mercure-galant/article/1704-07b_292)). Les archives civiles de la Seine Maritime précisent qu’il est devenu « avocat du roi au siège présidial de Caudebec » entre 1676 et 1690 (Inventaire-sommaire des Archives Départementales antérieures à 1790 de Seine inférieure, archives civiles, série C- 1328)." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<cf801ee1-ec08-4085-9c58-027f50d829b9> a crm:PC3_has_note ;
    crm:P01_has_domain <fecff36d-9ae5-446e-8644-dab82d0c8a59> ;
    crm:P03_has_range_literal "Jean Marius était un inventeur français et créateur notamment du clavecin brissé et du clavecin à maillets (cf. COHEN, Albert, «Marius, Jean»,Grove Music Online,2001, Oxford University Press (généré le 07/04/2021). Disponible en ligne: <https://www.oxfordmusiconline.com/grovemusic/view/10.1093/gmo/9781561592630.001.0001/omo-9781561592630-e-0000017820> .DOI: <https://doi.org/10.1093/gmo/9781561592630.article.17820>)." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<cf80af50-8170-4c62-992b-2192150e778f> a crm:PC3_has_note ;
    crm:P01_has_domain <a8bf5a05-79f8-49ba-ab22-cbf31e2366a2> ;
    crm:P03_has_range_literal "Subdélégué de l'Intendant et Maître des Eaux et Forêts à Compiègne (cf. [1687-03b_107](https://data-iremus.huma-num.fr/sherlock/mercure-galant/article/1687-03b_107))." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<cfc93383-fb54-4f4c-bb04-09d9dfac4337> a crm:PC3_has_note ;
    crm:P01_has_domain <d6cd088c-0708-4022-8805-35fe659faf9c> ;
    crm:P03_has_range_literal "Grevenbroeck (Johann Wilhelm, baron de), ministre plénipotentiaire de l'électeur palatin en France (…1750-1757…)" ;
