    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<eb5f6304-fe34-48d1-b556-8f693952a6bb> a crm:PC3_has_note ;
    crm:P01_has_domain <5368e3cf-a305-41fc-ac86-7eddeaf9012d> ;
    crm:P03_has_range_literal "Giovanni Antonio Luppazzoli succède en 1702 à son père Francesco en tant que consul de Venise à Smyrne (cf. https://journals.openedition.org/cdlm/11234 ; http://tesi.cab.unipd.it/45361/1/Tesi\\_Umberto\\_Signori.pdf, consulté le 11 juin 2021)." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<eb622ea6-1f31-4992-b7b6-f4f8a703852c> a crm:PC3_has_note ;
    crm:P01_has_domain <5956eb8d-e5c3-4030-a2c1-38df227a775b> ;
    crm:P03_has_range_literal "M. de Granville, de Riom, est l'auteur d'un ouvrage publié dans la livraison d'août 1702 du Mercure galant (cf. [1702-08_125](https://data-iremus.huma-num.fr/sherlock/mercure-galant/article/1702-08_125))." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<eb7bb674-3f19-4f0b-9376-4969a400d63a> a crm:PC3_has_note ;
    crm:P01_has_domain <4822e333-ae92-43c7-b54f-ce7869891404> ;
    crm:P03_has_range_literal "Graveur et peintre (?), actif entre 1653 et 1697) (Véronique Meyer, *Pour la plus grande gloire du roi : Louis XIV en thèses*, Rennes, Centre de recherche du château de Versailles/Presses universitaires de Rennes, 2017, p. 357). « On ignore tout de Levesque. Un peintre du nom de Laurent, actif entre 1653-1697, qui a représenté en 1691 une vue cavalière de l'abbaye de Sainte-Geneviève (Paris, musée Carnavalet, topo. GC XXVI B), pourrait être notre graveur. » (Véronique Meyer, *Pour la plus grande gloire du roi : Louis XIV en thèses : Catalogue*, Rennes, Centre de recherche du château de Versailles/Presses universitaires de Rennes, 2017, p. 401)." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<eb8175d6-f80c-455a-87dc-693bb6027f9f> a crm:PC3_has_note ;
