    crm:P01_has_domain <7441bdbb-06bb-4e54-822b-ca958f77f909> ;
    crm:P03_has_range_literal "Musicien du duc de Modène." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<a08aa6de-251d-48c0-b8df-231bd7b3cbaa> a crm:PC3_has_note ;
    crm:P01_has_domain <6f050d63-1e6f-4ff5-ba7b-b46821902817> ;
    crm:P03_has_range_literal "M. Alison est l'auteur d'un rondeau et de stances publiés dans le Mercure galant en janvier et février 1702 (cf. [1702-01_140](https://data-iremus.huma-num.fr/sherlock/mercure-galant/article/1702-01_140), [1702-02a_66](https://data-iremus.huma-num.fr/sherlock/mercure-galant/article/1702-02a_66))." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<a105b765-20b0-47a7-abbb-92fee4e809d3> a crm:PC3_has_note ;
    crm:P01_has_domain <cf812ad0-de26-4c39-ac80-3d746cd83c96> ;
    crm:P03_has_range_literal "Amigoni (Jacopo) (1682 ?-1752), peintre et graveur" ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<a116e3c5-8902-4c28-aca6-8ca94fc78aff> a crm:PC3_has_note ;
