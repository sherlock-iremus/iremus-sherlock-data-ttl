<0bd18579-1e53-489c-8868-5ce20d886d53> a crm:PC3_has_note ;
    crm:P01_has_domain <70e2b2c9-dcea-48b6-9957-e2677f70e067> ;
    crm:P03_has_range_literal "M. Bessant, «  de Poitiers  », composa la musique de deux airs parus dans le Mercure galant en août et en septembre 1678 (cf. [1678-08_175](https://data-iremus.huma-num.fr/sherlock/mercure-galant/article/1678-08_175), [1678-09_371](https://data-iremus.huma-num.fr/sherlock/mercure-galant/article/1678-09_371))." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<0bd5eb66-1689-4586-86ed-70f5adcea45c> a crm:PC3_has_note ;
    crm:P01_has_domain <6365fa2b-62b4-4163-9466-e52ca31846ea> ;
    crm:P03_has_range_literal "Conseiller du roi, avocat au Parlement et lieutenant général au Présidial de Caudebec (cf. [1687-03b_275](https://data-iremus.huma-num.fr/sherlock/mercure-galant/article/1687-03b_275))." ;
