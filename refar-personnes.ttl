    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<0a2ff1e0-490f-4457-9da4-97dd2f53cd20> a crm:PC3_has_note ;
    crm:P01_has_domain <7ae4cbf1-36ec-4b4b-a517-16f0fc29dfb3> ;
    crm:P03_has_range_literal "Hardion (Jacques) (1686-1766), précepteur, censeur royal, secrétaire du comte de Morville, écrivain principal de la Marine royale (1721…), puis des Affaires étrangères (…1762), précepteur de Mesdames de France (1748), garde de la bibliothèque particulière du roi à Versailles et du Cabinet des livres à la suite de la cour (…1736-1766)" ;
    crm:P3.1_has_type <c5402ae4-4ae9-48a1-86ed-c13de0c97d53> .

<0a692150-f7b7-4b29-96af-589ed85f35be> a crm:PC3_has_note ;
    crm:P01_has_domain <e87e6f31-0d27-4847-9d4f-d70d53d40cd6> ;
    crm:P03_has_range_literal "M. Buquet, d'Abbeville, est l'auteur des paroles d'un air publié en septembre 1691 (cf. [1691-09_311](https://data-iremus.huma-num.fr/sherlock/mercure-galant/article/1691-09_311))." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<0a705e7f-47db-45dd-919a-f53671b85f4c> a crm:PC3_has_note ;
    crm:P01_has_domain <1a5724d1-80b7-4344-9d9e-448bc6564b87> ;
    crm:P03_has_range_literal "Gentilhomme marseillais (cf. MG-1680-04_254)." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<0a806b3c-7201-40fa-bfec-2d1190694fec> a crm:PC3_has_note ;
    crm:P01_has_domain <2ccf59e0-a6f4-4248-a674-b30321c26896> ;
    crm:P03_has_range_literal "Mlle Bataille est l'auteur de quatre airs publiés dans le Mercure galant entre 1699 et 1702. Dans sa livraison de novembre 1699, le rédacteur du Mercure galant parle d'elle en ces termes : \"C'est une jeune personne de seize ans, qui possede a fonds la Musique, & le Clavessin. Elle execute à livre ouvert les pieces les plus difficiles, & les transpose sur tous les tons qu'on veut, avec une facilité qui passe l'imagination. Plusieurs Maistres des plus habiles qui on été témoins de ce qu'elle sçait faire, ont esté surpris de sa capacité. Elle enseigne aux personnes de son sexe, & va donner ses Leçons accompagnée d'une Mere, dont la sagesse & la conduite paroissent avantageusement dans l'éducation qu'elle s'est attachée à luy donner. Elle demeure dans la ruë Christine, entre Madame de Monchal, & Mr de Montelon. (MG-1699-11\\_089).\" Elle mit en musique trois poèmes de Tamiriste, pseudonyme d'un lecteur et auteur publiée dans le périodique qui le mentionne entre 1681 et 1709." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<0a9b061c-2858-4061-a422-1c1dc39ccfcd> a crm:PC3_has_note ;
    crm:P01_has_domain <f913906c-ce44-45dc-8a54-f0f5582e383a> ;
    crm:P03_has_range_literal "Viguier général de Montpellier (cf. MG-1678-03_214)." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<0ab924f7-9719-4f3d-82fb-ee89e7b45ed3> a crm:PC3_has_note ;
