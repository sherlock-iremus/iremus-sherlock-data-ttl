<4fe52559-6751-4f93-a020-4cbb48217c82> a crm:PC3_has_note ;
    crm:P01_has_domain <165ea0ba-61b9-4b96-aa88-ebe4164ca4dd> ;
    crm:P03_has_range_literal "Chanoine de la cathédrale de Troyes, auteur du livret d'un Divertissement sur le retour de la paix mis en musique par M. Nerat, donné par la Société philarmonique de Troyes en juillet 1763." ;
