<b4146c08-7c12-446e-b072-c690f49e2fe6> a crm:PC3_has_note ;
    crm:P01_has_domain <e4d115ec-b455-40a2-afe4-d1fe46444d3b> ;
    crm:P03_has_range_literal "M. Prevost était un compositeur, candidat au concours pour le poste de sous-maître de musique de la Chapelle Royale (cf. MG-1683-04_310). Lors de la publication d'un air dans le *Mercure galant*, il est indiqué qu'il était «  ci-devant maître de musique de la cathédrale de Clermont en Auvergne  » (cf. MG-1687-04_160)." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<b42a5ffa-7a0c-4fed-ad4b-4590c0057ae5> a crm:PC3_has_note ;
    crm:P01_has_domain <cc26c53d-7151-4323-b528-4ed152d0e372> ;
    crm:P03_has_range_literal "Jésuite lyonnais (cf. MG-1710-03_115)." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<b4372058-695e-4e56-adc1-a843e65fbd4e> a crm:PC3_has_note ;
