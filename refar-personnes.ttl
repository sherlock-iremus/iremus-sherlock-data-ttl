<958d2a27-c796-48b1-9d95-16436843e6af> a crm:PC3_has_note ;
    crm:P01_has_domain <6236e5d0-1d03-4970-b02e-03d171739efe> ;
    crm:P03_has_range_literal "M. Lesgu est l'auteur de trois airs publiés en 1678 dans le *Mercure galant* (cf. [1678-05_211](https://data-iremus.huma-num.fr/sherlock/mercure-galant/article/1678-05_211), [1678-06_071](https://data-iremus.huma-num.fr/sherlock/mercure-galant/article/1678-06_071), [1678-10_328](https://data-iremus.huma-num.fr/sherlock/mercure-galant/article/1678-10_328))." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<9595a138-e1da-4d3c-9290-df5a67dc8c88> a crm:PC3_has_note ;
    crm:P01_has_domain <9f9e8281-359b-467e-984d-9b99dcbfd93e> ;
    crm:P03_has_range_literal "Abbé commendataire de l'abbaye de Saint-Laurent, élu doyen de Saint-Thomas-du-Louvre le 1er janvier 1691 (cf. MG-1691-01\\_242)." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<95b06036-258a-4e10-b344-5b19595610b3> a crm:PC3_has_note ;
    crm:P01_has_domain <6d81e1f4-cf00-4e70-a4ae-87b4e02d9be5> ;
    crm:P03_has_range_literal "M. Guitrandi (ou Guitrandy) , d'Avignon, fut publié à plusieurs reprises dans le Mercure galant, notamment en octobre 1693 (cf. [1693-10a_055](https://data-iremus.huma-num.fr/sherlock/mercure-galant/article/1693-10a_055)) et en avril 1702 (cf. MG-1702-04\\_79)." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<95b74e3a-6ad2-4012-b387-02a2ee042f47> a crm:PC3_has_note ;
    crm:P01_has_domain <ad01b762-c049-4538-85ee-e57721a97840> ;
    crm:P03_has_range_literal "Major de Dieppe (cf. MG-1682-11_244)." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<95dcb259-f56e-44da-ad70-74de4f20bb01> a crm:PC3_has_note ;
    crm:P01_has_domain <8c3db074-f2e3-46d7-93db-b8e7f55f91d7> ;
    crm:P03_has_range_literal "Bailli de Nogent-le-Roi (cf. MG-1682-10b\\_233)." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<95f55deb-7291-4438-ae28-f73afa5af6f6> a crm:PC3_has_note ;
    crm:P01_has_domain <04bdbc3b-6d06-4ae9-82bd-8d6b70b51230> ;
    crm:P03_has_range_literal "Carcavi (Pierre de) (1603-1684), commis à la garde de la Bibliothèque et du Cabinet des médailles du roi (1666-1683)" ;
    crm:P3.1_has_type <c5402ae4-4ae9-48a1-86ed-c13de0c97d53> .

<95ff87bc-1621-4069-89ff-434bed1c6a0f> a crm:PC3_has_note ;
    crm:P01_has_domain <d34d29ab-7f26-405a-8490-d87f1d154170> ;
    crm:P03_has_range_literal "M. Pillet était le principal du collège de Dormans en 1704 (cf. [1704-08_203](https://data-iremus.huma-num.fr/sherlock/mercure-galant/article/1704-08_203))." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<96044381-c9c9-401f-8474-e99557c02842> a crm:PC3_has_note ;
    crm:P01_has_domain <749fcdf2-48f8-4290-82d2-48318fe1730a> ;
    crm:P03_has_range_literal "Gentilhomme picard (cf. MG-1685-11_069)." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<9674dd46-1b36-4ffc-9fae-083b144e6c77> a crm:PC3_has_note ;
    crm:P01_has_domain <56a00468-6e44-4d79-870e-ac87a38637e2> ;
    crm:P03_has_range_literal "Mlle Boucault a participé à un bal chez M. de Saint-Philibert à Château-Gontier pour célébrer la naissance du duc de Bretagne (cf. MG-1704-07b_393)." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<96836197-0c79-4aa4-a0c7-f98b301bff63> a crm:PC3_has_note ;
    crm:P01_has_domain <a6da8b76-57f3-4f14-b3e0-66f128f536cf> ;
    crm:P03_has_range_literal "Renel (Henriette Fitzjames, marquise de) (1705-1739), dame du palais de la reine (1728-1739)" ;
    crm:P3.1_has_type <c5402ae4-4ae9-48a1-86ed-c13de0c97d53> .

<9691f78f-5db2-4054-88c5-99c3bf7e83ba> a crm:PC3_has_note ;
    crm:P01_has_domain <c8fdc0a8-1927-4e4a-b4bc-ca8d2b3a5aa8> ;
    crm:P03_has_range_literal "Dit le président Denys , maire de Chaumont-en-Bassigny (cf. [1687-03b_081](https://data-iremus.huma-num.fr/sherlock/mercure-galant/article/1687-03b_081))." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<969dee3f-8012-4dec-9003-91bad12a20ea> a crm:PC3_has_note ;
    crm:P01_has_domain <510d87b3-e5b0-4620-8e20-5dca4bb2ef6b> ;
    crm:P03_has_range_literal "Péradon (Jean-Pierre) (1743-1816), garçon du château (…1782-1785…), commissaire de la commission temporaire des arts pour la botanique (…1795…), inspecteur des jardins et pépinières de Versailles (…1796-1797…)" ;
    crm:P3.1_has_type <c5402ae4-4ae9-48a1-86ed-c13de0c97d53> .

<96ab3aaa-3d5e-4aa7-8ae3-d5b86b81ea93> a crm:PC3_has_note ;
    crm:P01_has_domain <f825ea78-64da-4a0a-bc7d-17ac9c7b4498> ;
    crm:P03_has_range_literal "Lieutenant de la garde allemande de Naples (cf. [ 1680-03a_120](https://data-iremus.huma-num.fr/sherlock/mercure-galant/article/ 1680-03a_120))." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<96df59a9-4afa-467d-a62d-a9dc3e7eed94> a crm:PC3_has_note ;
    crm:P01_has_domain <b915ade0-247a-4247-bb61-2177da1b7e08> ;
    crm:P03_has_range_literal "Belleval (?-?), inspecteur des Bâtiments du roi" ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<96e0d8eb-1100-4de8-a21a-9718882e193c> a crm:PC3_has_note ;
    crm:P01_has_domain <d734e917-de84-4109-825c-39e811596647> ;
    crm:P03_has_range_literal "Tissu (Claude), ordinaire de la musique de la Chambre du roi (…1649-1679), musicien ordinaire de la reine (…1652-1665…)" ;
    crm:P3.1_has_type <c5402ae4-4ae9-48a1-86ed-c13de0c97d53> .

<96e34444-8256-4f15-a523-bf1f33302388> a crm:PC3_has_note ;
    crm:P01_has_domain <63489540-c09b-4617-ab4b-b97bb89f91af> ;
    crm:P03_has_range_literal "Blanzy (Jérôme Bignon de) (1698-1743), conseiller au parlement de Paris (1716…), maître des requêtes (1719…), intendant de La Rochelle (1726-1737), puis à Soissons (1737-1743), bibliothécaire du roi (1741…), conseiller d'état (1743…)" ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<97075e39-48f2-461d-be13-4059f37d67ec> a crm:PC3_has_note ;
    crm:P01_has_domain <6b2ce12b-edfe-4f42-baaa-2104cbfdeb80> ;
    crm:P03_has_range_literal "M. Guillery est mentionné en tant que compositeur d'un Te Deum laudamus en musique, chanté le 10 juillet 1704 en l'église des Saints Innocents à Paris (cf. MG-1704-07b\\_246)." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<9714f054-c1b0-43f4-9c7c-a8bab65c0674> a crm:PC3_has_note ;
    crm:P01_has_domain <5bd2495b-3457-42fe-aaac-f4aa7f08cbac> ;
    crm:P03_has_range_literal "Patris de Cougousse (Louis de) (1773-1811), page de la comtesse d'Artois (1787-1789), sous-lieutenant dans la légion de Mirabeau (1793), sous-lieutenant dans la légion d'Hœnloe (1795-…)" ;
    crm:P3.1_has_type <c5402ae4-4ae9-48a1-86ed-c13de0c97d53> .

<971dde81-96de-4ee0-9821-ae30955a9c3c> a crm:PC3_has_note ;
    crm:P01_has_domain <1d3f66ba-bef7-4566-a104-578d536932e2> ;
    crm:P03_has_range_literal "Gentilhomme bordelais (cf. MG-1682-09b\\_015)." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<9722456c-7090-4382-a417-78ac58abb706> a crm:PC3_has_note ;
    crm:P01_has_domain <8dd78a25-a07b-4778-bd9c-c10aed9bb208> ;
    crm:P03_has_range_literal "Auteur d'un sonnet publié dans la livraison d'août 1702 du Mercure galant (cf. [1702-08_5](https://data-iremus.huma-num.fr/sherlock/mercure-galant/article/1702-08_5)), résidant à Saint-Laurent dans le Périgord. M. Robert publia en juillet de la même année l'épitaphe de Nicolas-Antoine Lebègue (MG-1702-07a\\_268), mais rien ne permet d'affirmer avec certitude qu'il s'agit d'une seule et même personne." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<9731192a-e4d9-4bc0-ac3c-64505b8746a2> a crm:PC3_has_note ;
    crm:P01_has_domain <cbcc1b2b-a4fc-4625-8fec-ee83211dedc6> ;
    crm:P03_has_range_literal "Ambassadeur hollandais (1694.05)." ;
    crm:P3.1_has_type <c5402ae4-4ae9-48a1-86ed-c13de0c97d53> .

<973d05cf-91ab-42bc-b533-6731d8f6fdab> a crm:PC3_has_note ;
    crm:P01_has_domain <801ba49a-c6e9-44a3-bf7b-1227229c65b1> ;
    crm:P03_has_range_literal "Écuyer de Madame la Duchesse de Bourgogne, Mathieu Douart était le fils de Mathieu Douart (1643-1711), avocat du roi, et de Marie de Rivault (1640 ca-1718)." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<974378c1-bcbe-4400-81f2-7270fbafde8a> a crm:PC3_has_note ;
    crm:P01_has_domain <a31584eb-6125-4da9-bff3-edd33bb877cd> ;
    crm:P03_has_range_literal "Lieutenant du roi à Amiens (cf. MG-1691-05_223)." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<9748e114-5574-45fc-85d1-53ac2ee484da> a crm:PC3_has_note ;
    crm:P01_has_domain <a55451ed-db87-45d6-9547-cf7944b75c3b> ;
    crm:P03_has_range_literal "Compositeur, candidat au concours pour le poste de sous-maître de musique de la Chapelle Royale (cf. MG-1683-04_310)." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<9769bf49-0e26-488d-bd99-effd12dba56a> a crm:PC3_has_note ;
    crm:P01_has_domain <ec792fc3-1794-4d04-8ec1-b749e2f5da81> ;
    crm:P03_has_range_literal "épouse de Nicolas Méliand, intendant de Normandie (1679.01 ; 1682.11)" ;
    crm:P3.1_has_type <c5402ae4-4ae9-48a1-86ed-c13de0c97d53> .

<97750f54-cb9f-4cd8-8cbe-45cf20dda983> a crm:PC3_has_note ;
    crm:P01_has_domain <f23861a4-7640-4ff4-8af7-6008e4eafb4f> ;
    crm:P03_has_range_literal "Curé et vicaire perpétuel de la paroisse de Saint-Jean-d'Angély (cf. MG-1685-10\\_292)." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<97978153-ed1d-49e9-9cbc-5157e93e205f> a crm:PC3_has_note ;
    crm:P01_has_domain <39cf34ed-bba5-4d2e-bb12-62c3b0faf7e4> ;
    crm:P03_has_range_literal "M. Nolet de Cadhilac remporta le prix des Lanternistes de Toulouse en 1702. Le Mercure galant dit de lui qu'il est né \"pour ainsi dire, dans le sein des Muses. Son illustre Famille les a toujours cultivées, & c'est là particulierement qu'elles aiment à faire entendre leurs charmants Concerts\" (cf. MG-1702-07a\\_9)." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<97af5bd6-eae2-48a3-b71e-9b5b9f0d5a05> a crm:PC3_has_note ;
    crm:P01_has_domain <9def4108-01bf-4aff-9b2e-97c31bbb3af6> ;
    crm:P03_has_range_literal "Compositeur et bassoniste." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<97b0a4d7-ff9a-48b0-8fae-0035aba3c24a> a crm:PC3_has_note ;
    crm:P01_has_domain <d592dec6-5990-498e-ac9a-881f7b905fba> ;
    crm:P03_has_range_literal "Participa aux réjouissances du Carnaval de la cour de Lorraine en 1699 (cf. MG-1699-03_151)." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<97c65fc5-79a1-4bcb-bd4c-599d846c07fd> a crm:PC3_has_note ;
    crm:P01_has_domain <08d0f0e0-2295-4b1a-a050-7348ba45cfa6> ;
    crm:P03_has_range_literal "Intendant de justice des trois évêchés (cf. [1681-08_53](https://data-iremus.huma-num.fr/sherlock/mercure-galant/article/1681-08_53)) après avoir occupé les mêmes fonctions à Caen (novembre 1676-1677)." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<97e86c55-4da8-46b5-bb56-7b52ada9187a> a crm:PC3_has_note ;
    crm:P01_has_domain <df60b06a-81a5-47c0-8538-a5059bced29d> ;
    crm:P03_has_range_literal "Procureur du roi en la ville de Luzy (cf. MG-1698-02\\_026)." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<981b7f00-c02b-42a2-9619-732c465c00fb> a crm:PC3_has_note ;
    crm:P01_has_domain <249daaa4-d418-44cf-8c86-c0d19bc1d7e0> ;
    crm:P03_has_range_literal "En 1675, Marguerite de Quibly succéda sa tante homonyme en tant qu’abbesse à l’abbaye de la Déserte à Lyon (cf. https://gallica.bnf.fr/ark:/12148/bpt6k5819645n/f138.item.r=%22marguerite%20de%20quibly%22, consulté le 23 avril 2021). En 1732, elle fut succédée par Antoinette de Châtillon, cependant, le Mercure galant signale en 1710 que “Me de Châtillon” était abbesse de la Déserte, formulant ainsi une erreur dans l’identification de cette personne." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<9836b55d-4380-47d5-a938-5d3a9a8d0bec> a crm:PC3_has_note ;
    crm:P01_has_domain <329db659-22a5-447b-a14a-dd8f3f26a4b3> ;
    crm:P03_has_range_literal "Un M. Paulin, «  bénéficier de Notre-Dame  », est mentionné à deux reprises dans le Mercure Galant de 1704, en tant qu'auteur d'un Te Deum en musique donné au couvent des Célestins le 6 juillet 1704 (cf. [1704-07b_150a](https://data-iremus.huma-num.fr/sherlock/mercure-galant/article/1704-07b_150a)) et à l'église des Augustins du faubourg Saint-Germain le 14 juillet (cf. MG-1704-07b\\_246), pour célébrer la naissance du duc de Bretagne, arrière-petit-fils de Louis XIV. Il est possible qu'il s'agisse de Frédéric-Hubert Paulin, auteur d'un recueil de motets (1705 ca) et d'airs sérieux et à boire (1705)." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<983cc98c-c7f8-4549-9b88-6a5632c99dff> a crm:PC3_has_note ;
    crm:P01_has_domain <de6a5a39-4e26-4f2c-83d5-96807c966699> ;
    crm:P03_has_range_literal "L'abbé Dionis, abbé commendataire de Notre-Dame de Beaulieu en Rouergue (1690-1739) et prieur de Saint-Andéol de Parisot (1690-1709), a participé aux réjouissances données à Saint-Antonin à l'occasion de la naissance du duc de Bretagne (cf. [1704-08_307](https://data-iremus.huma-num.fr/sherlock/mercure-galant/article/1704-08_307))." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<985d588f-4e82-45bf-91c4-a08629887f91> a crm:PC3_has_note ;
    crm:P01_has_domain <75a2ecf4-7d32-410b-a746-27ff547928ca> ;
    crm:P03_has_range_literal "Juge des quatre faubourgs à Troyes (cf. MG-1698-03_038)." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<9870667b-a6a2-46b9-9cea-72ccf3925e77> a crm:PC3_has_note ;
    crm:P01_has_domain <8c365810-e1ce-4b2d-a970-a038ded2c2ca> ;
    crm:P03_has_range_literal "Intendant de la Flandre (1672-1680)." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<987fc055-a227-47b5-94b4-484a598beee7> a crm:PC3_has_note ;
    crm:P01_has_domain <1e48b96d-aee0-4345-903a-0b8bd73cb911> ;
    crm:P03_has_range_literal "Religieuse à l'abbaye royale Saint-Sauveur de Beaucaire (cf. MG-1694-04_123)." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<988e8a1d-ec7f-4523-ae6a-a4c00d570c6f> a crm:PC3_has_note ;
    crm:P01_has_domain <e4d5137f-7717-443f-8912-a2ad007e951f> ;
    crm:P03_has_range_literal "Charles Le Pul a été consul, puis viguier de Béziers (1649-1713)." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<98959eac-cb9a-42e2-bbc5-dc692d541e1e> a crm:PC3_has_note ;
    crm:P01_has_domain <acc176b0-6570-4f0c-adc6-f573b7f7b263> ;
    crm:P03_has_range_literal "Hérault d'armes (cf. MG-1678-09_375) ; « le plus ancien et le premier hérault d'armes de France » (cf. MG-1684-10_007)." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<98b228ca-29c4-4f4e-a93b-40bd2e48b7b1> a crm:PC3_has_note ;
    crm:P01_has_domain <9614f4d9-b363-4bef-9138-3df74391a5ee> ;
    crm:P03_has_range_literal "Avocat au présidial d'Agen (cf. [1696-12_225](https://data-iremus.huma-num.fr/sherlock/mercure-galant/article/1696-12_225))." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<98b3b35a-b376-4181-8022-1c5b7a572d21> a crm:PC3_has_note ;
    crm:P01_has_domain <3eb85029-1189-435d-89a0-c341b81e5e30> ;
    crm:P03_has_range_literal "Gouverneur de Grenoble (1686.10)." ;
