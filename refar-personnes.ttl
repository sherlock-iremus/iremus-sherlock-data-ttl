<ff138b66-73a4-4e65-8cb5-0d2f653a82ed> a crm:PC3_has_note ;
    crm:P01_has_domain <2b5082f4-ce23-4c20-9fc7-858fe17b85d2> ;
    crm:P03_has_range_literal "Le Père Capistron, auteur d’un idylle chanté pour le duc d’Anjou et ses frères en 1701, est mentionné dans le Mercure galant comme étant le frère de l’académicien Jean Galbert de Campistron, secrétaire des Galères et du duc de Vendôme." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

