<1df8515d-d331-4de8-a597-9db4713b53ec> a crm:PC3_has_note ;
    crm:P01_has_domain <486cc0bf-52d3-45b7-a57f-cafe996be1a7> ;
    crm:P03_has_range_literal "Desmarets de Vaubourg (Jean-Baptiste) (1646-1740), conseiller au parlement de Paris (1678…), maître des requêtes (1681…), intendant de Béarn (1685-1687), d'Auvergne (1687-1691), de Lorraine (1691-1698), de Franche-Comté (1698-1700), maître des requêtes honoraire (1699…), intendant de Rouen (1700-1701), directeur des affaires commerciales au contrôle général des Finances (1701…), conseiller d'État (1709…), membre du conseil de commerce (1715…)" ;
    crm:P3.1_has_type <c5402ae4-4ae9-48a1-86ed-c13de0c97d53> .

<1e0ef349-a309-41df-be65-c9d1bf1db9da> a crm:PC3_has_note ;
