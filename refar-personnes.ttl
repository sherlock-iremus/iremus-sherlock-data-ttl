    crm:P3.1_has_type <c5402ae4-4ae9-48a1-86ed-c13de0c97d53> .

<0c0e1eb7-2c68-4255-92ec-df18d6c32cc1> a crm:PC3_has_note ;
    crm:P01_has_domain <a8584bbd-475a-4198-8ae4-385cd88941db> ;
