    crm:P03_has_range_literal "Mailly (Marie-Jeanne de Talleyrand-Périgord, marquise puis duchesse de) (1747-1792), dame pour accompagner la dauphine (1770-1774), dame du palais (1774-1775), dame d'atours de la reine (1775-1781)" ;
    crm:P3.1_has_type <c5402ae4-4ae9-48a1-86ed-c13de0c97d53> .

<2251ca4e-5c82-4f62-b3a3-a043c231ffe4> a crm:PC3_has_note ;
    crm:P01_has_domain <7966d0be-1c5c-4d71-ae3b-2b1cf6cdaf9e> ;
    crm:P03_has_range_literal "M. Maurin, « dont les Peres, & les Ayeuls possedent depuis long-temps les principales Charges de la Chambre des Comptes », assista à la célébration de la fête de Saint-Lazare à l’abbaye de Saint-Germain-des-Prés le 19 décembre 1703 (cf. [1703-01_210](https://data-iremus.huma-num.fr/sherlock/mercure-galant/article/1703-01_210))." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<22593855-924b-4c9a-aac0-3e6eab327e77> a crm:PC3_has_note ;
    crm:P01_has_domain <56c9c346-49ea-47a0-80f0-b779fc24e076> ;
    crm:P03_has_range_literal "Pierre Allard était le fils de Charles Allard (1660 av.- 1717 ap.) et le frère de Charles Allard (?-1711)." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<227df062-3cf5-458b-ac07-6e4551e30483> a crm:PC3_has_note ;
    crm:P01_has_domain <36e30e6e-3d60-4a7a-a722-bd9909cab970> ;
    crm:P03_has_range_literal "Robert Dupré a été envoyé extraordinaire du roi de France à Florence en 1704." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<22b6857a-0873-4eb2-8451-f21e01f5415d> a crm:PC3_has_note ;
    crm:P01_has_domain <3b61589d-11f4-4d8a-9500-e0c29cdd57e9> ;
    crm:P03_has_range_literal "Joachim de la Chétardie (1636-1714) était “directeur dans les séminaires de Limoges, du Puy et de Bourges, [puis] Curé de Saint-Sulpice à Paris de 1696 à sa mort (29 juin 1714) (cf. http://beauchesne.immanens.com/appli/article.php?id=12223, consulté le 9 mars 2021)." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

