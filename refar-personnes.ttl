<09ea4cee-898a-4606-af20-d6d89b1d6dcd> a crm:PC3_has_note ;
    crm:P01_has_domain <e88fe35c-0829-4248-80ab-55f6ed055a97> ;
    crm:P03_has_range_literal "Alexandre Bessie du Peloux (?-1718) était secrétaire de l'Académie de Villefranche-sur-Saône (cf. MG-1680-09a\\_252)." ;
