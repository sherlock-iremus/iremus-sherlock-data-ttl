    crm:P03_has_range_literal "Participa aux réjouissances de la cour de Hanovre pour le Carnaval de l'année 1693 (cf. MG-1693-04_208)." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<70f0941f-e4a6-446e-b283-e7aaeaf6cbc8> a crm:PC3_has_note ;
    crm:P01_has_domain <32089b24-0a8c-4778-abfe-c082a13b2c6f> ;
    crm:P03_has_range_literal "Joseph l’Espinay a été le curé de Sceaux de 1700 à 1716, d’après Michel Charaire (cf. Histoire de la ville de Sceaux depuis son origine jusqu'à nos jours, Sceaux, Charaire, Paris, Picard,1883, p. 515 (cf. https://gallica.bnf.fr/ark:/12148/bpt6k6527179v/f570.item, consulté le 21 avril 2021)." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<71074417-1e26-46be-a451-c0126fea5d15> a crm:PC3_has_note ;
    crm:P01_has_domain <15090833-a167-4aca-8c20-70bcf28a83ea> ;
    crm:P03_has_range_literal "Premier président de la chambre des comptes de Rouen (cf. [1682-07_310](https://data-iremus.huma-num.fr/sherlock/mercure-galant/article/1682-07_310))." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<71139606-516d-4523-abdc-da9c85e608ba> a crm:PC3_has_note ;
