    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<0dbc3b0c-6a94-4981-b2a2-2cc0ac23c670> a crm:PC3_has_note ;
    crm:P01_has_domain <9e3015d5-887d-4ee1-bd8a-71d6ebf45f3e> ;
