<0dc32226-7db8-4acc-9382-2aa77418443d> a crm:PC3_has_note ;
    crm:P01_has_domain <bb5fc14d-f679-40cf-826a-8b87551654b5> ;
    crm:P03_has_range_literal "Le Mercure galant mentionne Madame du Teilley , fille d'Honneur de la défunte reine d'Espagne, Marie-Louise d'Orléans, qui a participé aux réjouissances publiques organisées à Château-Gontier pour la naissance du duc de Bretagne en 1704 (cf. MG-1704-07b\\_393)." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<0dce9ced-82bd-476c-aca7-108792db89fc> a crm:PC3_has_note ;
    crm:P01_has_domain <9c379742-ee57-47d0-a643-c66dac43a2e4> ;
    crm:P03_has_range_literal "Matignon (Edmée-Charlotte de Brenne, marquise de) (1702-1756), dame du palais de la reine (1725-1741)" ;
    crm:P3.1_has_type <c5402ae4-4ae9-48a1-86ed-c13de0c97d53> .

<0dd4df20-f190-444f-837a-509399e71f4a> a crm:PC3_has_note ;
    crm:P01_has_domain <d84b06d5-8000-43b6-a732-2aa90683d8c6> ;
    crm:P03_has_range_literal "Joseph de Fontanès de Chemé-La Vallette (1673-1759) fut chanoine-comte de Lyon. Il était le neveu de Claude de Saint-Georges, Archevêque de Lyon (cf. Vicomte de Montravel, « Fontanès », Revue historique, archéologique, littéraire et pittoresque du Vivarais illustrée, Paris, Dumont, Lyon, Brun fils, Privas, Imprimerie centrale, 1907, t. XV, n° 7, p. 325 ; https://gallica.bnf.fr/ark:/12148/bpt6k9770351s, consulté le 23 avril 2021)." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<0deb26bf-6086-432b-ba5c-d7956666c6ef> a crm:PC3_has_note ;
    crm:P01_has_domain <f6ab33c1-d16c-414a-a9be-2e49af5cc816> ;
    crm:P03_has_range_literal "Joan de Rojas y Solorzano, auteur d'un sonnet en espagnol publié dans le *Mercure galant* de février 1702, était secrétaire de Philippe V d'Espagne (cf. MG-1702-02a\\_301)." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<0dedd79c-09d5-4813-85a3-ac0eb68761d8> a crm:PC3_has_note ;
    crm:P01_has_domain <d13ee2cf-4f6a-4a5e-943a-0abadab078ac> ;
    crm:P03_has_range_literal "Avocat, maire perpétuel de Clamecy (1696-1723)." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

