<edbdf275-ad85-48f8-9bc0-baa37f56420e> a crm:PC3_has_note ;
    crm:P01_has_domain <544e00d1-3bea-4100-aaa9-03a935493fec> ;
    crm:P03_has_range_literal "G. Montbard a publié en 1708 une estampe (Illustrissimus Ecclesiae Princeps D. D. Carolus Le Goux de la Berchere […].). Il est mentionné dans le *Mercure galant* d'août 1710 en tant que graveur d'une estampe d'une cornaline antique du cabinet du roi (cf. MG-1710-08_074)." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<edd032bd-355b-466d-8b5c-322876dc496f> a crm:PC3_has_note ;
