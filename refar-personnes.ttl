<94f22b76-9504-4e59-9405-da15943832b6> a crm:PC3_has_note ;
    crm:P01_has_domain <a9e0a1e5-e2e4-421d-9d64-c9cd2bc77732> ;
    crm:P03_has_range_literal "M. le Redde mit en musique un air, paru dans le *Mercure galant* de mars 1679 (cf. MG-1679-03\\_042). Le poème de cet air a été écrit par M. Noël, avocat à Chartres. Peut-être pourrait-il s'agir de Nicolas Le Redde, marchand bourgeois à Nonancourt. Il était le père de Nicolas Le Redde qui épouse Marie Piet à Chartres en juin 1717 et était décédé à cette date (cf. \"France, Eure-et-Loir, Parish and Civil Registration, 1526-1902\", database, FamilySearch (https://www.familysearch.org/ark:/61903/1:1:69SP-4VW2 : 1 July 2021), Nicolas le Redde)." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<95162bc1-81f8-461d-89a3-622896aab0e7> a crm:PC3_has_note ;
