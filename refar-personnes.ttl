<b2bd6552-3cc0-49c4-a062-8f6bafcb9278> a crm:PC3_has_note ;
    crm:P01_has_domain <931631c9-6b88-4c32-974a-a69b6e379d15> ;
    crm:P03_has_range_literal "Gaspard de Fontenu a été consul de France à Livourne (1704-1707) puis à Smyrne (1707-1731). Il assura également l'interim de l'ambassade de Constantinople (Istanbul) entre 1728 et 1730 (cf. le Fonds Fontenu conservé aux Archives nationales (cote 727AP/1-727AP/7: https://www.siv.archives-nationales.culture.gouv.fr/siv/rechercheconsultation/consultation/ir/pdfIR.action?irId=FRAN\\_IR\\_057321)." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<b2c193d0-f16a-4a5f-aaec-828c776374da> a crm:PC3_has_note ;
    crm:P01_has_domain <9f3c1604-a486-4691-9da6-358c3907c0b1> ;
    crm:P03_has_range_literal "Bournezeau (Jean de Creil de) (1644-1709), conseiller au Châtelet, conseiller au parlement de Paris, première chambre d'enquête (1671…), maître des requêtes ordinaire de l'Hôtel du roi (1676…), intendant à Moulins (1684-1686), intendant à Orléans (1686-1694), conseiller d'État (1694…)" ;
    crm:P3.1_has_type <c5402ae4-4ae9-48a1-86ed-c13de0c97d53> .

<b2cfe8b3-b070-4be1-b5a3-103ce246a9e1> a crm:PC3_has_note ;
    crm:P01_has_domain <9ec01d0d-c742-4bff-bc09-01563df4a770> ;
    crm:P03_has_range_literal "Résident du roi de France à Genève (cf. MG-1680-07\\_224 ; MG-1682-10b\\_190)." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<b2f9be45-0f62-4c1b-83b8-4103e009fdca> a crm:PC3_has_note ;
