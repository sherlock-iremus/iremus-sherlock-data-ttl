<b47fab19-298b-4378-a569-b6ac39c3b573> a crm:PC3_has_note ;
    crm:P01_has_domain <1a6202e0-d98b-40c8-8e03-9f8a3ee460dd> ;
    crm:P03_has_range_literal "M. de Montigny, \"du quai des Célestins\", expliqua l'énigme parue dans le *Mercure galant* de janvier 1679 (cf. [1679-02_345](https://data-iremus.huma-num.fr/sherlock/mercure-galant/article/1679-02_345))." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<b48abe05-c4b3-4b9f-be60-177626367fbe> a crm:PC3_has_note ;
    crm:P01_has_domain <35e894ea-e14a-41ab-80ed-e116a14b443b> ;
    crm:P03_has_range_literal "Jean Nicollin a été maire de Béziers de 1698 à 1709 (cf. Société archéologique, scientifique et littéraire de Béziers, 2003, p. 62, consultable en ligne, https://gallica.bnf.fr/ark:/12148/bpt6k9604996h/f64.item, consulté le 16 juin 2021)." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<b4927e83-d816-4d30-b506-183bc432502d> a crm:PC3_has_note ;
    crm:P01_has_domain <d6989dab-b41e-4ce9-b190-48e12967b57c> ;
    crm:P03_has_range_literal "M. Du Parc est un compositeur qui publia de nombreux airs entre 1678 et 1705." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<b49f3ce1-124e-43c3-b0cd-dfdbcff21517> a crm:PC3_has_note ;
    crm:P01_has_domain <00df8f51-5fec-4883-936e-06dd6aacc111> ;
    crm:P03_has_range_literal "Nicolas le Camus était maître des requêtes au Conseil d'État, ainsi que premier président de la Cour des Aides de Paris." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<b4a88a5b-32d8-4f83-a52b-6cffcb7b35d8> a crm:PC3_has_note ;
    crm:P01_has_domain <bdf5ac2c-c793-493c-b9ae-eb92922906d9> ;
    crm:P03_has_range_literal "Bernage (Louis de) (1663-1737), conseiller au Grand Conseil (1687…), maître des requêtes de l'Hôtel du roi (1689-1714), intendant à Limoges (1694-1702), en Franche-Comté (1702-1708), à Amiens (1708-1717), maître des requêtes honoraire (1717…), intendant du Languedoc (1718-1724), conseiller d'état semestre (1718…)" ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

