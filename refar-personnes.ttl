<50050224-1e5f-4e0a-9a7d-45bfc01db244> a crm:PC3_has_note ;
    crm:P01_has_domain <38145418-c956-4c68-8024-5af69e26fdf6> ;
    crm:P03_has_range_literal "Guillaume Quéru était maître à danser, membre de l’Académie Royale de Danse (cf. Lettres patentes du roy, pour l'établissement de l'Académie royale de danse en la ville de Paris. Vérifiées en Parlement le 30 mars 1662. Paris, 1663, p. 8)." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<500aed43-f66f-49e3-8fd1-22beeff6f79c> a crm:PC3_has_note ;
    crm:P01_has_domain <927c9898-8fb5-4c2f-8a3f-a0b4bba3f13c> ;
    crm:P03_has_range_literal "Épiphane Nicaud (fl. 1710) a été provincial des récollets de Lyon (cf. Jean-Baptiste Martin, Histoire des églises et chapelles de Lyon, tome 1, Lyon, H. Lardanchet, 1908-1909, p. 357 ; https://gallica.bnf.fr/ark:/12148/bpt6k5788167w/f406.item.r, consulté le 20 avril 2021)." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<5010a8c2-67b8-4763-9242-29dcca36d086> a crm:PC3_has_note ;
    crm:P01_has_domain <8becd5f9-5371-46c6-ac7a-a25c48215d55> ;
    crm:P03_has_range_literal "Villars (Amable-Gabrielle de Noailles, duchesse de) (1706-1771), dame du palais (1727-1742), dame d'atours de la reine (1742-1768), puis de la dauphine (1770-1771)" ;
    crm:P3.1_has_type <c5402ae4-4ae9-48a1-86ed-c13de0c97d53> .

<5019eb49-0f05-4183-bd78-c92ba6b1ea1a> a crm:PC3_has_note ;
    crm:P01_has_domain <2fdcd452-4d36-415f-a56d-b5401a3f2fd5> ;
    crm:P03_has_range_literal "Converti au catholicisme en décembre 1684 (cf. MG-1685-01_067)." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<50288939-ca9a-4d3a-ae1c-fce4c6294937> a crm:PC3_has_note ;
    crm:P01_has_domain <24b2b90f-757d-42e1-a931-5dcbe820c996> ;
    crm:P03_has_range_literal "Né et mort à Pont-l'évêque, Marin Dières est notamment l'auteur de la Relation du voyage du Port-Royal de l'Acadie (Rouen, 1708) et de poésies diverses publiées pour la plupart dans le Mercure galant. Sur cet auteur, cf. Relation du voyage du Port-Royal de l'Acadie suivi de Poésies diverses, éd. critique par Normand Doiron, Presses de l'Université de Montréal, 1997, 601 p. (<https://doi.org/10.2307/j.ctv69t8zr>)" ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<5048771d-9a16-4859-9a4d-e9aa1d31fc34> a crm:PC3_has_note ;
    crm:P01_has_domain <864fe785-4993-45b8-901a-00f00c4056cb> ;
    crm:P03_has_range_literal "Loubet (? -1755), inspecteur des carrières de marbres des Pyrénées (1747-1755)" ;
    crm:P3.1_has_type <c5402ae4-4ae9-48a1-86ed-c13de0c97d53> .

<5052fe32-5271-4d3f-bdba-a4d93a6b226a> a crm:PC3_has_note ;
    crm:P01_has_domain <e3114172-fc50-4048-a0d8-dfc12c6a4b56> ;
    crm:P03_has_range_literal "Goeren de La Salle (Pierre) (?-?), concierge du château du Val et garde du petit parc" ;
    crm:P3.1_has_type <c5402ae4-4ae9-48a1-86ed-c13de0c97d53> .

<505ce737-c794-4ac0-b44b-a281e139f549> a crm:PC3_has_note ;
    crm:P01_has_domain <f1e4e7db-6342-4d27-909d-74ce092c90ed> ;
    crm:P03_has_range_literal "Jean-Baptiste Sabatini était peintre de la ville de Nevers. Il travaille parallèlement pour divers châteaux, églises ou hôtels particuliers des environs (église de Parigny-les-Vaux, 1689). Il semble s’être installé définitivement à Nevers, puis à Bourges (cf. https://www.academie-sabl-dijon.org/celebration/deces-de-jean-baptiste-battista-sabatini-peintre/, consulté le 15 juin 2021)." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<50620cc3-9bfb-4349-b7de-338fcc4ba523> a crm:PC3_has_note ;
    crm:P01_has_domain <14d8b569-71e5-4acb-be3e-a06695baeb7b> ;
    crm:P03_has_range_literal "Directeur de l'Académie de Soissons (cf. MG-1693-05_242)." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<508df3f4-e719-4bf9-92c2-a0a3cd427799> a crm:PC3_has_note ;
    crm:P01_has_domain <7986de3e-47b0-4734-b4a2-3d12d7d4e79f> ;
    crm:P03_has_range_literal "Gissey (Henri) (1621-1673), ingénieur et dessinateur des Menus Plaisirs du roi (1663)" ;
    crm:P3.1_has_type <c5402ae4-4ae9-48a1-86ed-c13de0c97d53> .

<50944b5a-2e0d-46c9-96f9-fa329be29cd6> a crm:PC3_has_note ;
    crm:P01_has_domain <9cad3603-921c-4bfa-8287-87998a29dee4> ;
    crm:P03_has_range_literal "Jacques Dubuisson composa et publia plus de 300 airs entre 1678 et 1710." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<50f71596-06c9-4c0b-90e2-36b5f9d6fa31> a crm:PC3_has_note ;
