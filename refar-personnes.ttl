<68ed0adf-6b90-4910-a113-b335d1df315e> a crm:PC3_has_note ;
    crm:P01_has_domain <14c5a1ef-bf49-4643-a762-1859c44f1178> ;
    crm:P03_has_range_literal "M. de L. C. est l'auteur des paroles d'un air publié dans le *Mercure Galant* de juin 1702 (cf. [1702-06a_309](https://data-iremus.huma-num.fr/sherlock/mercure-galant/article/1702-06a_309))." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<68edaea3-357a-4942-b544-f3985920be82> a crm:PC3_has_note ;
    crm:P01_has_domain <82d17469-c1a8-4899-b332-50981ab86b0a> ;
    crm:P03_has_range_literal "Premier Président du Parlement de Normandie (1692-1703). Épouse en 1679 Marie-Anne de la Guillaumie." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<6904510b-10ea-4c7a-93d0-f403df5feb8f> a crm:PC3_has_note ;
    crm:P01_has_domain <a6b64293-ba26-422e-874d-944b5b1cd330> ;
