<6f4aeec6-8a64-4f00-baad-6223192e0d63> a crm:PC3_has_note ;
    crm:P01_has_domain <98d51e28-2826-45b5-a174-cfe1b22d66bd> ;
    crm:P03_has_range_literal "Exécuteur du testament de la princesse Palatine (cf. MG-1684-10_091)." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<6f5561b4-a5b2-46d3-aa1f-f760cd9adf23> a crm:PC3_has_note ;
    crm:P01_has_domain <99dffc21-b6ea-4d6d-b63c-29b7773e89cc> ;
    crm:P03_has_range_literal "\"Mr le Comte de Rocquebrune\" est l'auteur d'un air publié dans le *Mercure Galant* de juin 1681 (cf. MG-1681-06\\_88)." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<6f76b8bf-2075-4e29-a01a-3026fef66206> a crm:PC3_has_note ;
    crm:P01_has_domain <5b8f1c56-ba7c-4c7b-8a28-e5d1d7d5f072> ;
    crm:P03_has_range_literal "Testelin (Henri) (1616-1695), peintre (1648-1681), secrétaire (1650-1681) et professeur (1656-1681) de l'Académie royale de peinture et de sculpture" ;
    crm:P3.1_has_type <c5402ae4-4ae9-48a1-86ed-c13de0c97d53> .

<6f832f34-1a48-4e7a-98f7-3c7fa95552ee> a crm:PC3_has_note ;
    crm:P01_has_domain <1a0bcda4-9561-4631-be21-f8163f38b830> ;
    crm:P03_has_range_literal "Langers (François) (?-1681), ordinaire de la musique de la Chapelle (1668-1681) et de la musique de la Chambre (1669-1681), musicien de la reine (1674-1680)." ;
    crm:P3.1_has_type <c5402ae4-4ae9-48a1-86ed-c13de0c97d53> .

<6f8e1b09-4189-4502-a8fc-cbf2f20ebfda> a crm:PC3_has_note ;
    crm:P01_has_domain <8a4c2cb9-4bd3-4ddb-8222-31022e5c1ccf> ;
    crm:P03_has_range_literal "Premier président à la cour des aides de Clermont-Ferrand (cf. MG-1687-03b\\_322)." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<6fc53619-2b64-4cba-98de-b754a3a89490> a crm:PC3_has_note ;
    crm:P01_has_domain <075810e2-56ca-4ea4-b800-49c4f5a0e8fe> ;
    crm:P03_has_range_literal "Turola (Charles-Lavinio) (?-1693), garde-meuble du duc Mazarin, garde général du Garde-Meuble de la Couronne (1685-1693)" ;
    crm:P3.1_has_type <c5402ae4-4ae9-48a1-86ed-c13de0c97d53> .

<6fd17f85-ae61-4553-bcad-9e64c8b3402d> a crm:PC3_has_note ;
    crm:P01_has_domain <9627d212-c695-4882-8827-5e9afe9326ba> ;
    crm:P03_has_range_literal "Avocat à Bordeaux (cf. MG-1697-12_167)." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<6fd9eab7-31a6-4bbd-862a-b30b66808a18> a crm:PC3_has_note ;
    crm:P01_has_domain <73ca78c2-ac87-4a57-8c6b-60cd1cd788cd> ;
    crm:P03_has_range_literal "Lieutenant du roi (cf. [1678-12_092](https://data-iremus.huma-num.fr/sherlock/mercure-galant/article/1678-12_092))." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<6fda1c67-9882-4fa4-9cb3-e154f7a9bc3e> a crm:PC3_has_note ;
    crm:P01_has_domain <a69bf250-9e4b-44a7-a2eb-9590fa17c8ed> ;
    crm:P03_has_range_literal "M. Du Breuil de Vignancourt est l'auteur d'airs parus dans le *Nouveau Mercure* entre 1714 et 1716. D'après la livraison de novembre 1714, M. du Breuil de Vignancourt était un \"digne élève du fameux Lambert\" (cf. MG-1714-11\\_345). Un commentaire de Dusfresny dans le *Mercure* de novembre 1715 (cf. MG-1715-11\\_090) permet de lui attribuer un air signé sous le pseudonyme \"Amoureux oïsif des bords de Marne\" : il indique en effet que sous ce pseudonyme se cache l'auteur du poème et de la musique, et accompagne cet air de sa partition gravée portant le nom de \"De Breüil de Vignancourt\"." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<6ff9907b-b3d1-4926-b72f-152755526f59> a crm:PC3_has_note ;
    crm:P01_has_domain <cd65aa3e-80c7-4770-b1e7-e131aff62ba2> ;
    crm:P03_has_range_literal "Abbé, grand trésorier de la cathédrale de Rouen (cf. MG-1687-01a\\_248)." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<70411805-8b04-424d-ad24-540626655313> a crm:PC3_has_note ;
    crm:P01_has_domain <73d7007e-526b-4c23-bd6b-57629512e93a> ;
    crm:P03_has_range_literal "Hérault d'armes au titre du régiment de Charolais (cf. [1678-09_375](https://data-iremus.huma-num.fr/sherlock/mercure-galant/article/1678-09_375), [1684-10_007](https://data-iremus.huma-num.fr/sherlock/mercure-galant/article/1684-10_007))." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<706141e2-ec2f-4f7d-bbb9-0806ce67d3fb> a crm:PC3_has_note ;
    crm:P01_has_domain <822fc37f-b325-4976-9961-ee5334c57ce1> ;
    crm:P03_has_range_literal "Maître de musique de Marie-Louise d'Orléans (1662-1689) (cf. MG-1679-11\\_213)." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<708bf3b9-1d54-4503-b7dc-320b4dc26dd6> a crm:PC3_has_note ;
    crm:P01_has_domain <0b265bab-6c22-4050-a75d-72f437a7bd72> ;
    crm:P03_has_range_literal "Participa aux réjouissances du Carnaval de la cour de Lorraine en 1699 (cf. MG-1699-03_151)." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<70b1934a-eb1d-4b12-ac46-f2179a06bf31> a crm:PC3_has_note ;
