<04979792-e2cf-4420-be43-263a296a3a4d> a crm:PC3_has_note ;
    crm:P01_has_domain <8ed87974-4398-4790-af97-d3505f4d53f7> ;
    crm:P03_has_range_literal "Le chanteur Jean Daniel, qui publia trois airs dans le *Mercure galant*, était neveu par alliance de Bertrand de Bacilly dont il épousa la nièce, Marie-Gatienne (cf. [1678-12_103](https://data-iremus.huma-num.fr/sherlock/mercure-galant/article/1678-12_103), [1680-07_298](https://data-iremus.huma-num.fr/sherlock/mercure-galant/article/1680-07_298), [1680-08_312](https://data-iremus.huma-num.fr/sherlock/mercure-galant/article/1680-08_312))." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<04a37685-e010-4193-9230-063421174077> a crm:PC3_has_note ;
