    crm:P03_has_range_literal "Rolland (Louis) (v. 1670-1740), garde à cheval des rigoles de Saclay (1713-1715) puis inspecteur des jardins et bosquets du château de Versailles (1715-1740)" ;
    crm:P3.1_has_type <c5402ae4-4ae9-48a1-86ed-c13de0c97d53> .

