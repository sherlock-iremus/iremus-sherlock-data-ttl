    crm:P03_has_range_literal "Jacques de Vaux a été premier président de la chambre de comptes de l’élection de Nevers (cf. Le Bayer, Jacques. Mémoire de la généralité de Moulins, Moulins : L. Grégoire, 1906, p. 121)." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<51948b46-b782-4c91-8bd8-d883d8eefe01> a crm:PC3_has_note ;
