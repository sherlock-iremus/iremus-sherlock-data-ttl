    crm:P03_has_range_literal "M. de Pulvigny est l'auteur d'un air paru dans le *Mercure galant* de juin 1681 (cf. MG-1681-06\\_88)." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<82ff0c7e-cc05-4ed3-8176-7a270fa8d7af> a crm:PC3_has_note ;
    crm:P01_has_domain <d1701451-efe9-47ce-b5c7-c4dbba1dc711> ;
    crm:P03_has_range_literal "écuyer du dauphin dans un carrousel (cf. [1685-04_246](https://data-iremus.huma-num.fr/sherlock/mercure-galant/article/1685-04_246))." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

