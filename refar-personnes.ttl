<db7bd2a9-fa82-4586-9994-30d52a19c624> a crm:PC3_has_note ;
    crm:P01_has_domain <03fd5ae8-eae4-41ab-9412-237c16008531> ;
    crm:P03_has_range_literal "Enseigne au Régiment des Gardes françaises en 1654, promu lieutenant en 1656 puis Major de son Régiment en 1670. Il leva son propre régiment de Dragons en 1674. Gouverneur et grand bailli des ville et citadelle de Tournai (voir Chronologie historique-militaire par M. Pinard, t. 6, 1763). Il était également l'oncle de M. de Combes, lieutenant général de Riom (MG-1687-04\\_297)." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<db9a88cd-7d16-4c3a-8a8b-a76e56cf9b5d> a crm:PC3_has_note ;
    crm:P01_has_domain <e95c449e-f1f9-45ae-93f9-54b0e03a35dc> ;
    crm:P03_has_range_literal "Écuyer, docteur en droit. Lieutenant particulier du marquisat de Saint Symphorien, juge, avocat à Vienne. Conseiller du Roi, maître ordinaire à la Chambre des Comptes de Grenoble en 1698." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<dbac1370-c366-4deb-9b8e-4d81c4d7c9ac> a crm:PC3_has_note ;
