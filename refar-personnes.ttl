<0d15f395-67c7-45ea-984d-7e86ac2fcc13> a crm:PC3_has_note ;
    crm:P01_has_domain <28c8f37f-fb70-4dc2-84b7-84179b8b485d> ;
    crm:P03_has_range_literal "\"D'Abbeville\", auteur d'un *Dialogue de Pallas et des Muses* paru en mars 1692 dans le *Mercure galant* (cf. MG-1692-03\\_283)." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

