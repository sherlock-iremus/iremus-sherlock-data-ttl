<9da35cf7-dcbf-49b0-8a76-1c16fe87cba2> a crm:PC3_has_note ;
    crm:P01_has_domain <e2ef4b6a-b41c-450a-8051-3f2a5dfc2cfd> ;
    crm:P03_has_range_literal "Prêtre, docteur en théologie de la Faculté de Paris, doyen et chanoine de l'église royale et collégiale Saint-Thomas-du-Louvre, demeurant, en 1671, au doyenné de la dite église (cf. https://www.siv.archives-nationales.culture.gouv.fr/siv/IR/FRAN\\_IR\\_041104) et décédé début 1691 (cf. MG-1691-01\\_242)." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<9da7c33a-9804-47f4-9b5a-13bdc0107a4d> a crm:PC3_has_note ;
    crm:P01_has_domain <94dfe782-8139-42c0-a66a-032493c4690b> ;
    crm:P03_has_range_literal "Amelot de Chaillou (Antoine-Jean) (1732-1795), secrétaire d'état de la Maison du roi (1776-1783)" ;
