    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<b6875ba3-dbee-4bbe-b5f7-384bb665037f> a crm:PC3_has_note ;
    crm:P01_has_domain <81015d1d-0487-4c77-8d0f-1de9857d0423> ;
    crm:P03_has_range_literal "Participa aux réjouissances de la cour de Hanovre pour le Carnaval de l'année 1693 (cf. MG-1693-04_208)." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<b6931254-3643-4c17-a3be-0caab4e7b6bc> a crm:PC3_has_note ;
    crm:P01_has_domain <01d49cac-ac1b-42ac-a08b-2709f4ca97e8> ;
    crm:P03_has_range_literal "Gratien Raoul, récollet, nommé professeur de théologie en 1703, fut élu en 1708 supérieur du couvent de Port-Louis. Il séjourna dans la colonie de l’Île Royale de 1710 à 1715 puis entre 1754 et 1758, cette fois-ci en qualité de de Supérieur de l’île Saint-Jean. Il mourut probablement autour de 1780 (cf. Marc-Antoine Alix, Missionnaires bretons dans les Nouveaux Mondes (XVIe-XVIIIe siècles, Mémoire de Master 2, Université Rennes 2 Haute-Bretagne, 2016-2017, Annexes, p. 186, https://dumas.ccsd.cnrs.fr/dumas-01586706/file/2017\\_MM2\\_ALIX\\_M\\_A\\_vol.%202.pdf, consulté le 12 avril 2021)." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<b6ab04a5-f079-484d-9245-f78bc91a8a28> a crm:PC3_has_note ;
    crm:P01_has_domain <048c0adf-cac2-46e2-a8b7-822690ddce60> ;
    crm:P03_has_range_literal "Participa à une fête galante donnée à DIe en 1681 (cf. MG-1681-09\\_25)." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<b6b6a77e-9506-4beb-a6d7-86c86e5afa00> a crm:PC3_has_note ;
    crm:P01_has_domain <48208206-5419-4ebc-a2ba-f08d56ba517d> ;
    crm:P03_has_range_literal "Paul-Joseph Douradou de Cambefort a été curé de Notre-Dame-de-Bonne-Nouvelles depuis 1696 à sa mort en 1722, et abbé commendataire de Saint-Pierre de Maurs, du diocèse de Saint-Flour (cf. Ségolène Dainville-Barbiche, «Prosopographie des curés de Paris (1695-1789)», dans Devenir curé à Paris.Institutions et carrières ecclésiastiques (1695-1789), sous la direction deSégolènede Dainville-Barbiche. Paris cedex 14, Presses Universitaires de France, «Le Noeud Gordien», 2005, p. 425-511. URL : <https://www.cairn.info/devenir-cure-a-paris--9782130543404-page-425.htm>)" ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<b6bf687c-d2da-4650-81d3-e1b5616df1f8> a crm:PC3_has_note ;
    crm:P01_has_domain <569e3233-6334-4521-8b26-d9d03b9d8d73> ;
    crm:P03_has_range_literal "Premier gentilhomme de la chambre du roi (surv. 1670 ; tit. 1704-1739), grand bailli de Valois (1658), gouverneur de Paris (1704)." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<b6d107cd-6a79-45c4-b834-5ab6e14243e0> a crm:PC3_has_note ;
    crm:P01_has_domain <c9c0e4be-e9be-44f2-b36e-896a50d8c3a6> ;
    crm:P03_has_range_literal "Maire de Château-Thierry (cf. MG-1698-01\\_021)." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<b6d9a4b1-2eb8-49c5-874b-20259f1528e0> a crm:PC3_has_note ;
    crm:P01_has_domain <07abdc82-5a40-4a8d-a659-6b05af5cbb8f> ;
    crm:P03_has_range_literal "Mlle de Villecourt a participé à un bal chez M. de Saint-Philibert à Château-Gontier pour célébrer la naissance du duc de Bretagne (cf. [1704-07b_393](https://data-iremus.huma-num.fr/sherlock/mercure-galant/article/1704-07b_393))." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<b6dd3557-8bdb-4fdd-a6a3-765339026b4d> a crm:PC3_has_note ;
    crm:P01_has_domain <8fd20b13-7d0a-405e-8645-e4176a1923d6> ;
    crm:P03_has_range_literal "La Briffe (Jean-Arnaud de ; comte de Ferrière) (v. 1649-1700), maître des requêtes (1676…), président du Grand Conseil (1683…), intendant à Rouen (1686-1687), procureur général du parlement de Paris (1689-1700)" ;
    crm:P3.1_has_type <c5402ae4-4ae9-48a1-86ed-c13de0c97d53> .

<b6f5f7d8-a419-4baf-b954-4e98f7746b7d> a crm:PC3_has_note ;
    crm:P01_has_domain <f262904e-5680-4a7f-b172-59e9fa134be2> ;
    crm:P03_has_range_literal "Lieutenant de la milice de Mantes-la-Jolie (cf. MG-1698-01_136)." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<b73f24be-b2f3-41f8-be30-0e8bc2721888> a crm:PC3_has_note ;
    crm:P01_has_domain <e25cfae6-03f9-4a75-8b49-35400670c460> ;
