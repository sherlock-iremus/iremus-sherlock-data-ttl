<76799982-e12d-4b10-b17d-7f98b1e17dc0> a crm:PC3_has_note ;
    crm:P01_has_domain <28b7048c-9c9a-4bfb-9ed7-90ef1e59d807> ;
    crm:P03_has_range_literal "Chanoine de l'église Sainte-Croix de Montélimar (cf. MG-1685-05_067)." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<76843e60-ebf7-4877-ad63-5bb42a0ab9c2> a crm:PC3_has_note ;
    crm:P01_has_domain <83c2998b-9d94-4166-83f0-7d01933ae8bc> ;
    crm:P03_has_range_literal "D'après Gilbert Rose, Mathieu Furdaux était maître de musique et \"maître de chœur\" de la cathédrale de Metz, déjà en place en 1672, année où il signa comme parrain au baptême de Jeanne Cécile Brechon, fille d'un des musiciens de la cathédrale. Il était originaire de Verdun et mourut à Metz le 4 février 1688, âgé de 66 ans. Prêtre, il était bénéficier de l'autel Sainte-Catherine en l'église Sainte-Croix ; il était par ailleurs aumônier au parlement de Metz (cf. Gilbert Rose, *Metz et la Musique au XVIIIe siècle,* Metz, éditions Serpenoise, 1992, p. 31)." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<76989cfa-e359-4f70-81fa-1ef06da65ca5> a crm:PC3_has_note ;
    crm:P01_has_domain <76fe07cd-2112-4f97-8180-621bdfa6d08f> ;
