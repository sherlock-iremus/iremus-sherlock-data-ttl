    crm:P01_has_domain <d91cfd0f-e9ff-4bef-9d54-f6b4dd30e112> ;
    crm:P03_has_range_literal "Lieutenant de la compagnie des chevaliers du jeu de l'arquebuse de Provins (cf. [1686-10a_073](https://data-iremus.huma-num.fr/sherlock/mercure-galant/article/1686-10a_073))." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<d10a5a3f-d21f-47cb-b4b8-6687a7230758> a crm:PC3_has_note ;
