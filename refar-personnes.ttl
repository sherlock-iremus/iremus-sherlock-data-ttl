    crm:P03_has_range_literal "Domenico Doria prit part aux manifestations organisées par la République de Gênes pour la réception de Philippe V d'Espagne en novembre 1702 (cf. MG-1702-12\\_191)." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<c72d53ce-c41b-45f7-a662-0bfc69887595> a crm:PC3_has_note ;
    crm:P01_has_domain <8b4ed048-1b36-4c08-926c-18e60e7d7bae> ;
    crm:P03_has_range_literal "Syndic de l'université de Paris (cf. MG-1682-09a_087)." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<c7316ade-a0fb-4984-a8e1-c519c28a6d62> a crm:PC3_has_note ;
    crm:P01_has_domain <3d0aeef8-b1c9-4c77-9c1a-7192e843667a> ;
    crm:P03_has_range_literal "Voir [Geoffrey Turnovsky](https://www.cairn.info/publications-de-Geoffrey-Turnovsky--653952.htm), \"**Les lecteurs du *Mercure galant*. Trois aperçus\", *[Auctorialité, voix et publics dans Le Mercure Galant,](https://www.cairn.info/revue-dix-septieme-siecle.htm)* [éd. A. Piéjus, D. Blocker,](https://www.cairn.info/revue-dix-septieme-siecle.htm) *[Dix-septième siècle](https://www.cairn.info/revue-dix-septieme-siecle.htm)* [270 (2016/1](https://www.cairn.info/revue-dix-septieme-siecle-2016-1.htm)), p. 65-80 ;**https://www.cairn.info/revue-dix-septieme-siecle-2016-1-page-65.htm." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<c7394d5d-eeac-41b8-9e8a-0fc7ca8d0123> a crm:PC3_has_note ;
    crm:P01_has_domain <e4d115ec-b455-40a2-afe4-d1fe46444d3b> ;
    crm:P03_has_range_literal "M. Prevost était un compositeur, candidat au concours pour le poste de sous-maître de musique de la Chapelle Royale (cf. [1683-04_310](https://data-iremus.huma-num.fr/sherlock/mercure-galant/article/1683-04_310)). Lors de la publication d'un air dans le *Mercure galant*, il est indiqué qu'il était «  ci-devant maître de musique de la cathédrale de Clermont en Auvergne  » (cf. MG-1687-04_160)." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<c760e66d-911c-4578-8ee7-a05b26b08c56> a crm:PC3_has_note ;
    crm:P01_has_domain <30619b2e-507a-435a-87db-fb5c33cb8c16> ;
    crm:P03_has_range_literal "Gouverneur de Pontoise (cf. MG-1679-03_007)." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<c773b333-ed42-4270-9ba5-ae3f43589010> a crm:PC3_has_note ;
    crm:P01_has_domain <0b28c95e-eaeb-45ca-8472-87e16f5a3833> ;
    crm:P03_has_range_literal "Giovanni Battista Roca prit part aux manifestations organisées par la République de Gênes pour la réception de Philippe V d'Espagne en novembre 1702 (cf. [1702-12_191](https://data-iremus.huma-num.fr/sherlock/mercure-galant/article/1702-12_191))." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<c773e1d3-ef0d-4233-9d3d-1bc976a8efe4> a crm:PC3_has_note ;
    crm:P01_has_domain <c33113ed-51d6-4b62-b3d4-c513a53f780e> ;
    crm:P03_has_range_literal "Docteur régent de la faculté de droit de Paris (cf. [1685-09_256](https://data-iremus.huma-num.fr/sherlock/mercure-galant/article/1685-09_256))." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<c784b987-6a5c-4cca-bf65-a508bb9352aa> a crm:PC3_has_note ;
    crm:P01_has_domain <3e1f9909-5e33-43df-84d3-c021cd0d13ea> ;
    crm:P03_has_range_literal "M. Bernard (fl. 1697) était receveur général de la commanderie de Launay (cf. MG-1697-09\\_257 )." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<c7884f10-9bb5-4b39-82a7-155c7430e501> a crm:PC3_has_note ;
    crm:P01_has_domain <a30ba462-e4a1-4503-a720-53824731d40e> ;
    crm:P03_has_range_literal "Parisot (Claude) (actif 1685-1719), ingénieur, inspecteur des Bâtiments du roi (…1702-1719…)" ;
    crm:P3.1_has_type <c5402ae4-4ae9-48a1-86ed-c13de0c97d53> .

<c7ab9d1c-c8c6-4186-96e5-3c89f6cf982b> a crm:PC3_has_note ;
    crm:P01_has_domain <bea47dee-4009-4be4-848e-3665b71abcf2> ;
    crm:P03_has_range_literal "Poncet (Jean) (?-?), prêtre, curé d'Usseaux (1688-1724…)" ;
    crm:P3.1_has_type <c5402ae4-4ae9-48a1-86ed-c13de0c97d53> .

<c7ae6751-3f5e-4426-856d-b9d08fcb3296> a crm:PC3_has_note ;
    crm:P01_has_domain <8277e2db-5e1c-4388-a337-a47d33a592d4> ;
    crm:P03_has_range_literal "Compositeur de la cantate *L'Apologie des femmes*." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<c7b94bba-b1df-461e-ac12-7adbcabbe5bf> a crm:PC3_has_note ;
    crm:P01_has_domain <44aff363-62da-44f6-bc6d-d77bbcfe15c2> ;
    crm:P03_has_range_literal "Le chevalier de Théron, capitaine dans le régiment de Lanoy, est l'auteur d'une Ode sur la fortune parue dans le Mercure galant. D'après le périodique, il est le neveu du père Vital Théron (MG-1703-01\\_112)." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<c7c17fa3-961a-45fc-9201-c913850f3e20> a crm:PC3_has_note ;
    crm:P01_has_domain <16e54fcf-b9e8-4636-a901-47f2b4dab896> ;
    crm:P03_has_range_literal "Premier consul de Montpellier (cf. [1682-09b_125](https://data-iremus.huma-num.fr/sherlock/mercure-galant/article/1682-09b_125))." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<c7e9edb1-ccf9-4d35-adbc-ba14434319be> a crm:PC3_has_note ;
    crm:P01_has_domain <743194f4-c16d-4672-a5f8-6b2c1ce33bf6> ;
    crm:P03_has_range_literal "Autrice d'une cantate (Achille sur le corps de Patrocle) mise en musique par Horzizki." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<c80015ea-35b5-4e86-9689-bb90f9117dff> a crm:PC3_has_note ;
    crm:P01_has_domain <5171c535-40aa-40ca-80ee-d52f7e9b9a5c> ;
    crm:P03_has_range_literal "Marchand des Chartrons de Bordeaux (cf. MG-1682-09b\\_015)." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<c80b8271-40cc-4749-b19c-79e16e629e41> a crm:PC3_has_note ;
    crm:P01_has_domain <9b312415-9ab5-4e7b-ade3-ca8f331cd321> ;
    crm:P03_has_range_literal "Mlle de Fontenelle a participé à un bal chez M. de Saint-Philibert à Château-Gontier pour célébrer la naissance du duc de Bretagne (cf. MG-1704-07b\\_393)." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<c83f4139-17c1-44b8-9813-bae56eb5d5ff> a crm:PC3_has_note ;
    crm:P01_has_domain <7cc3a948-f40e-435f-8581-f8b23af9c64b> ;
    crm:P03_has_range_literal "Président des enquêtes et prévôt des marchands à Paris (cf. [1684-10_007](https://data-iremus.huma-num.fr/sherlock/mercure-galant/article/1684-10_007))." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<c8669b38-7442-4975-a31f-d834985903ab> a crm:PC3_has_note ;
    crm:P01_has_domain <eb188841-853c-4bbc-adfd-09d53d51fefe> ;
    crm:P03_has_range_literal "Député de la Régence de Mecklenbourg (cf. [1693-02a_096](https://data-iremus.huma-num.fr/sherlock/mercure-galant/article/1693-02a_096))." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<c86c5136-0cd4-48a0-bf74-0e5ec2e9224e> a crm:PC3_has_note ;
    crm:P01_has_domain <57281046-da03-4987-998e-6ec4a8a5589c> ;
    crm:P03_has_range_literal "M. de Rochebrune est l'auteur des paroles d'un air publié dans le *Mercure Galant* en janvier 1717 (cf. [1717-01_218](https://data-iremus.huma-num.fr/sherlock/mercure-galant/article/1717-01_218)). Peut-être s'agit-il de Claude Guérin de Rochebrune (1660-1719), polygraphe et parolier dont Voltaire disait être le fils illégitime (Pearson, *Voltaire almighty* ..., 2005, p. 9)." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<c87735f6-3299-47c8-928b-1f136763442a> a crm:PC3_has_note ;
    crm:P01_has_domain <9e38274d-ced3-4152-9698-901dbb5ef71b> ;
    crm:P03_has_range_literal "Bachelier en théologie et principal du collège de Châtillon-sur-Seine (cf. MG-1690-10_059)." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<c890da07-615f-429b-a759-fde2e429a4e6> a crm:PC3_has_note ;
    crm:P01_has_domain <18c4fe2c-4450-4513-b305-2a45ec16af38> ;
    crm:P03_has_range_literal "Le père jésuite Joseph Mahoudeau a remporté le prix de l'ode française décerné à Caen en février 1702. Son ode est publiée dans le Mercure galant du même mois (cf. MG-1702-02a\\_251). D'après ce périodique, Mahoudeau a également remporté le prix de l'épigramme latine dont un exemplaire publié à Caen en 1702 est conservé à la BnF (https://catalogue.bnf.fr/ark:/12148/cb308600558)." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<c8a5356c-fb7b-457c-a11b-145d1a702bb5> a crm:PC3_has_note ;
    crm:P01_has_domain <1bf2e572-88c8-4208-b10f-a7feaaaeae09> ;
    crm:P03_has_range_literal "Conseiller au présidial de Bourg-en-Bresse (cf. [1678-12e_064](https://data-iremus.huma-num.fr/sherlock/mercure-galant/article/1678-12e_064), [1678-12e_344](https://data-iremus.huma-num.fr/sherlock/mercure-galant/article/1678-12e_344), [1679-09_072](https://data-iremus.huma-num.fr/sherlock/mercure-galant/article/1679-09_072)). Voir aussi Geoffrey Turnovsky, \"Les lecteurs du Mercure galant. Trois aperçus\", *Auctorialité, voix et publics dans Le Mercure Galant*, éd. A. Piéjus, D. Blocker, *Dix-septième siècle,* 270 (2016/1), p. 65-80 (cf. https://www.cairn.info/revue-dix-septieme-siecle-2016-1-page-65.htm)." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<c8d5fbf9-6052-4b7a-bcfb-c57a4d46308a> a crm:PC3_has_note ;
    crm:P01_has_domain <656ff7d3-d442-48a2-be01-ffeb359c53da> ;
    crm:P03_has_range_literal "L'abbé Roy, chanoine de Saint-Jacques de l'Hôpital, était âgé de 80 ans en 1718 (cf. [1718-08_188](https://data-iremus.huma-num.fr/sherlock/mercure-galant/article/1718-08_188))." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<c8ea18a0-81b6-4333-87c9-ba764bd0d108> a crm:PC3_has_note ;
    crm:P01_has_domain <6a61ff13-971f-41e9-976f-037d71297694> ;
    crm:P03_has_range_literal "Camon (Marc-François de Lassus, seigneur de) (1692-1780), contrôleur général des marbres du roi dans les Pyrénées (1724-1759…)" ;
    crm:P3.1_has_type <c5402ae4-4ae9-48a1-86ed-c13de0c97d53> .

<c8fa0b8c-600a-43c9-82a3-19e6c0541c7d> a crm:PC3_has_note ;
    crm:P01_has_domain <06dcf0a1-acec-4256-82e8-80ba9ed281cd> ;
    crm:P03_has_range_literal "M. Normandeau l'aîné, \"cy-devant Page de la Chapelle du Roy\" (cf. MG-1699-09\\_205), ne doit pas être confondu avec M. Normandeau, auteur de deux airs parus dans le *Mercure galant* en 1689 et 1691 (cf. MG-1689-06a\\_114 et MG-1691-09\\_311a). Ce dernier était peut-être le père de l'ancien page." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<c8fd50b3-59e7-4e94-99bd-5f57a5123d04> a crm:PC3_has_note ;
    crm:P01_has_domain <996965cc-1055-45aa-92b9-c993808b17cd> ;
    crm:P03_has_range_literal "Musicien du duc de Württemberg (cf. MG-1684-11_034)." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<c9002ceb-5771-452f-932b-1e5f39168824> a crm:PC3_has_note ;
    crm:P01_has_domain <3ebd4c3e-d347-4544-a666-b430ee8ec45b> ;
    crm:P03_has_range_literal "Mademoiselle Conradi a chanté à l’Opéra de Hambourg entre 1690 et 1710 (cf. <http://www.quellusignolo.fr/sopranos/conradi.html>, consulté le 25 mars 2021). Dans le ballet «Sieg der Schönheit über die Helden», présenté lors du mariage du prince de Prusse en 1706, elle a joué les rôles de Vénus et de la Prusse." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<c909599c-346f-4f47-bfd0-65128f5ea471> a crm:PC3_has_note ;
    crm:P01_has_domain <42301316-7bce-4458-a130-870b46d44d55> ;
    crm:P03_has_range_literal "Christian-Louis Ier (1623-1692), duc de Mecklembourg (1658-1692)" ;
    crm:P3.1_has_type <c5402ae4-4ae9-48a1-86ed-c13de0c97d53> .

<c91163a0-9ac1-45a0-8321-1ef220cbca5f> a crm:PC3_has_note ;
    crm:P01_has_domain <aa5fbc5d-a188-43e1-b4ff-4bc95855d40f> ;
    crm:P03_has_range_literal "Page des chasses à la cour de Wurtemberg en novembre 1684." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<c929f95d-495d-410f-847f-5f26c5534a1b> a crm:PC3_has_note ;
    crm:P01_has_domain <31a6ffe1-b5ef-49f2-8cd9-7672deef9e08> ;
    crm:P03_has_range_literal "Antin (Françoise-Gillette de Montmorency-Luxembourg, duchesse d') (1704-1768), dame du palais de la reine (1725-1757)" ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<c9442265-e944-4ac6-8ed7-2ab5d772845b> a crm:PC3_has_note ;
    crm:P01_has_domain <1fde3570-6610-45df-bf78-d06f087217ea> ;
    crm:P03_has_range_literal "Participa aux réjouissances du Carnaval de la cour de Lorraine en 1699 (cf. MG-1699-03_151)." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<c9598af7-3c08-43b5-8937-2cee965979f2> a crm:PC3_has_note ;
    crm:P01_has_domain <78f286fe-087e-4e48-a5cf-5b6be3bad97d> ;
    crm:P03_has_range_literal "Le Mercure de juillet 1705 propose des paroles de M. de Choisel mises en musique par M. de Maiz et précise qu'\"ils sont tous les deux de la Flèche en Anjou\" (cf. [1705-07_109](https://data-iremus.huma-num.fr/sherlock/mercure-galant/article/1705-07_109))." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<c9638f94-d662-4f03-a4d1-98b7d96f6e59> a crm:PC3_has_note ;
    crm:P01_has_domain <c7431e3e-963d-4875-842e-1b4e3f2a69ae> ;
    crm:P03_has_range_literal "Gouverneur de l'Orléanais, pays Chartrain et Blaisois (cf. [1687-03b_415a](https://data-iremus.huma-num.fr/sherlock/mercure-galant/article/1687-03b_415a))." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<c973d80c-b40b-4dc8-abc1-e42a49bee2a2> a crm:PC3_has_note ;
    crm:P01_has_domain <d93cd9f3-c267-497d-b1f8-c94c96434557> ;
    crm:P03_has_range_literal "M. Boussonel organisa les festivités données à l'occasion de la pose de la première pierre du port Saint-Charles, près de Narbonne (cf. MG-MG-1705-03_238)." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<c9959048-e452-4054-9251-2a4e545a0f72> a crm:PC3_has_note ;
    crm:P01_has_domain <487e576a-9c9b-40c8-afeb-94fe3f77e24d> ;
    crm:P03_has_range_literal "Apparenté à la maison de Brinswick (cf. MG-1680-05_122)." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<c99b0dec-43e4-4e56-b54f-2c4fcb89de97> a crm:PC3_has_note ;
    crm:P01_has_domain <43ec09af-da4b-43ed-8fef-99406fb51fd3> ;
    crm:P03_has_range_literal "Syndic général des marchands privilégiés selon la cour (cf. [1704-07b_198b](https://data-iremus.huma-num.fr/sherlock/mercure-galant/article/1704-07b_198b))." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<c9ad0b96-0b5a-4ddb-a750-eb368a183bbb> a crm:PC3_has_note ;
    crm:P01_has_domain <f2399f07-3006-4777-9ea6-e7d7e931f669> ;
    crm:P03_has_range_literal "Épouse de M. Bazin, intendant de justice des trois évéchés de Metz (cf. MG-1681-08_053)." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<c9bde6f0-8a13-4937-a4d1-da1f000e3ff6> a crm:PC3_has_note ;
    crm:P01_has_domain <01eb3c56-823c-48f6-8b89-68c1fbbbaa45> ;
    crm:P03_has_range_literal "Gaillard de La Bouëxière (Jean) (1676-1759), fermier général (1722-1758)" ;
    crm:P3.1_has_type <c5402ae4-4ae9-48a1-86ed-c13de0c97d53> .

<c9c8826b-9a48-487f-96a4-e526db562693> a crm:PC3_has_note ;
    crm:P01_has_domain <fc3d195c-572e-4254-a0de-318939e3b867> ;
    crm:P03_has_range_literal "Chanoine de Soissons (cf. MG-1686-03_240)." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<c9ca1de4-4b7f-4a0f-842b-a1cb5e9c559a> a crm:PC3_has_note ;
    crm:P01_has_domain <0f34642e-05ac-493a-a84d-2fb8b2aa94ea> ;
    crm:P03_has_range_literal "Le Mercure galant mentionne Madame de Fontenelle qui a participé aux réjouissances publiques organisées à Château-Gontier pour la naissance du duc de Bretagne en 1704 (cf. [1704-07b_393](https://data-iremus.huma-num.fr/sherlock/mercure-galant/article/1704-07b_393))." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

