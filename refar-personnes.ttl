    crm:P03_has_range_literal "Chaperon (Jean-Louis) (1718-?), garçon du Garde-Meuble à Marly, puis concierge de l'hôtel du duc de Grouchy à Paris (…1781…)" ;
    crm:P3.1_has_type <c5402ae4-4ae9-48a1-86ed-c13de0c97d53> .

