    crm:P03_has_range_literal "Intendant du prince de Conti et maire perpétuel et lieutenant de police de Pézenas (cf. MG-1701-12_092)." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<fdaf8a76-9422-4365-b65b-cc25eb0acb2d> a crm:PC3_has_note ;
    crm:P01_has_domain <8c15ac65-6a4f-4172-a378-c2f7959c3fa6> ;
    crm:P03_has_range_literal "Fer (Nicolas de) (1646-1720), géographe du roi, géographe du roi d'Espagne (1702…), du dauphin (1688?-1711), cartographe, éditeur d'estampes" ;
    crm:P3.1_has_type <c5402ae4-4ae9-48a1-86ed-c13de0c97d53> .

