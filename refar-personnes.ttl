<01c2a5aa-5ca7-47ad-920b-7af2f61c437e> a crm:PC3_has_note ;
    crm:P01_has_domain <4689332c-e034-4bd6-8280-0d5b3faa9146> ;
    crm:P03_has_range_literal "M. de Monbrun est l'auteur des paroles d'airs publiés dans le *Mercure Galant* d'octobre 1681 (cf. [1681-10_125](https://data-iremus.huma-num.fr/sherlock/mercure-galant/article/1681-10_125), [1681-10_375](https://data-iremus.huma-num.fr/sherlock/mercure-galant/article/1681-10_375)) et janvier 1682 (cf. MG-1682-01\\_275). Le *Mercure Galant* d'octobre 1681 précise qu'il est conseiller au Parlement de Toulouse." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<020ce5be-bcfb-4eb5-bea3-97f2438ad2f2> a crm:PC3_has_note ;
    crm:P01_has_domain <544e00d1-3bea-4100-aaa9-03a935493fec> ;
    crm:P03_has_range_literal "G. Montbard a publié en 1708 une estampe (Illustrissimus Ecclesiae Princeps D. D. Carolus Le Goux de la Berchere […].). Il est mentionné dans le Mercure galant d'août 1710 en tant que graveur d'une estampe d'une cornaline antique du cabinet du roi (cf. MG-1710-08\\_074)." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<0218f452-1a09-4fad-9856-d2dd6aa613b2> a crm:PC3_has_note ;
