    crm:P03_has_range_literal "Bouville (Nicolas-Louis Jubert, comte de) (1700-1770), mousquetaire (1718), capitaine au régiment Royal-Dragons (1719), maître de camp de cavalerie (1740), brigadier (1747), maréchal de camp (1758)" ;
