<e769a1c7-baf1-434f-9138-0f4a4dc066cc> a crm:PC3_has_note ;
    crm:P01_has_domain <329db659-22a5-447b-a14a-dd8f3f26a4b3> ;
    crm:P03_has_range_literal "Un M. Paulin, «  bénéficier de Notre-Dame  », est mentionné à deux reprises dans le Mercure Galant de 1704, en tant qu'auteur d'un Te Deum en musique donné au couvent des Célestins le 6 juillet 1704 (cf. MG-1704-07b\\_150a) et à l'église des Augustins du faubourg Saint-Germain le 14 juillet (cf. MG-1704-07b\\_246), pour célébrer la naissance du duc de Bretagne, arrière-petit-fils de Louis XIV. Il est possible qu'il s'agisse de Frédéric-Hubert Paulin, auteur d'un recueil de motets (1705 ca) et d'airs sérieux et à boire (1705)." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<e7774c49-f55f-421f-819f-aab1bd6d884d> a crm:PC3_has_note ;
    crm:P01_has_domain <c4aac78e-ff1e-40f4-b5e0-5f83a7ca1104> ;
    crm:P03_has_range_literal "Participa aux réjouissances de la cour de Hanovre pour le Carnaval de l'année 1693 (cf. MG-1693-04_208)." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<e79a94bf-1037-4125-bdd0-2045ab289c93> a crm:PC3_has_note ;
    crm:P01_has_domain <186a3531-b0c7-4d70-b623-0c53627ab84c> ;
    crm:P03_has_range_literal "Angelo Olivieri est mentionné en tant que Musicien du cardinal Charles Barberin (cf. MG-1702-03\\_153)." ;
