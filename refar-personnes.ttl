<e9eb9463-59e4-4849-8b5f-bbbb486fe7c5> a crm:PC3_has_note ;
    crm:P01_has_domain <b16cb221-9e94-49f7-be0a-8e25c2f307f4> ;
    crm:P03_has_range_literal "Maître de musique. Compositeur d'une cantate (*La feinte*) et d'autres ouvrages de musique" ;
