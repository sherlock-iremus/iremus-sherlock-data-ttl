<4dcf8e8a-957e-45dd-9e5e-cebdfa299c84> a crm:PC3_has_note ;
    crm:P01_has_domain <2d7a5be7-6f02-4a07-9d47-56b091422dd9> ;
    crm:P03_has_range_literal "Avocat au parlement de Provence, receveur général des Finances (1663), conseiller du roi en la cour des Comptes, Aides et Finances de Provence (1671) ; épouse le 4 février 1663 Thérèse Dise, née en 1633 à Aix." ;
    crm:P3.1_has_type <c5402ae4-4ae9-48a1-86ed-c13de0c97d53> .

<4de038d4-50bf-468b-860a-ddbe94343d74> a crm:PC3_has_note ;
