<d0e64f8f-0f57-40e9-bd0d-57403ade490c> a crm:PC3_has_note ;
    crm:P01_has_domain <c92abf15-c74d-4e91-885d-286ad32d0522> ;
    crm:P03_has_range_literal "Jérôme Bignon a été successivement intendant de la généralité de Rouen (1693-1694), intendant de la généralité d'Amiens et des pays reconquis (1694-1708) puis prévôt des marchands de Paris (1708-1716). Il a été élu membre de l'Académie des inscriptions et belles-lettres en 1705 (cf. https://fr.wikipedia.org/wiki/J%C3%A9r%C3%B4me\\_Bignon\\_(1658-1725), consulté le 12 avril 2021)." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

