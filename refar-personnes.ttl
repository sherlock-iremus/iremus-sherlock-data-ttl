<8d55a302-4d41-4405-986e-b41f695bbe5f> a crm:PC3_has_note ;
    crm:P01_has_domain <c5a9a789-92f4-45ba-a585-170eaec1f0d4> ;
    crm:P03_has_range_literal "Mlle de Castille est l'autrice d'un poème, qui sera mis en musique, publié dans le *Mercure galant* d'avril 1680 (cf. MG-1680-04\\_242)." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

