<83e8809e-6f14-4f90-b635-429d4c9710fb> a crm:PC3_has_note ;
    crm:P01_has_domain <715ba952-ebee-4fe5-843d-dd6863be4e01> ;
    crm:P03_has_range_literal "\"Ombre des Tuileries\" est l'auteur des paroles d'un air publié dans le *Mercure Galant* de mai 1698 (cf. MG-1698-05\\_280)." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<8406aca7-f5d4-431a-89c1-b7c7ac256e89> a crm:PC3_has_note ;
    crm:P01_has_domain <f760ab70-c8f9-45f8-8da4-a977c26067eb> ;
    crm:P03_has_range_literal "Le *Mercure galant* fait mention en juillet 1704 d'un comte de la Bretesche, frère du marquis de la Bretesche, lieutenant général des armées du roi. L'arbre généalogique présentant plusieurs frères, le comte est difficilement identifiable sans informations complémentaires." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<84105adb-5233-4b63-b8ee-7d147f8c0db1> a crm:PC3_has_note ;
    crm:P01_has_domain <62faf773-8a21-472b-933e-a78e5ae7d84d> ;
    crm:P03_has_range_literal "Marie-Angélique de La Porte de Villoiseau (dite Madame la Presidente de la Gravelle), était l'épouse du Premier Président au Présidial de Château-Gonthier, René d'Héliand, seigneur de la Gravelle (1657-1724)." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<841771d0-7da3-4d41-9281-eee418afd0de> a crm:PC3_has_note ;
    crm:P01_has_domain <603c95db-7341-40d6-8d50-8b91e6692b62> ;
    crm:P03_has_range_literal "Le comte de Priego prit part aux manifestations organisées par la République de Gênes pour la réception de Philippe V d'Espagne en novembre 1702 (cf. [1702-12_191](https://data-iremus.huma-num.fr/sherlock/mercure-galant/article/1702-12_191))." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<841f3b1a-e2fe-4d11-983e-59fed5a8035a> a crm:PC3_has_note ;
    crm:P01_has_domain <599b666c-0b0b-496b-932b-1e74d3089e7f> ;
    crm:P03_has_range_literal "M. Genais, auteur de la musique d'un air paru dans le Mercure galant en mars 1684, était alors maître de musique  à Tours (cf. MG-1684-03\\_348)." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

