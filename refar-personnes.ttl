<beb1672e-3c37-4d0b-b014-b45499036784> a crm:PC3_has_note ;
    crm:P01_has_domain <31a432ef-d73b-4432-a30b-a2718bfb2c0e> ;
    crm:P03_has_range_literal "L'abbé Charlet est l'auteur d'odes latines dont une Sur la guerre présente publiée dans le Mercure galant d'août 1702 dans la traduction de l'abbé Mauguin (cf. [1702-08_211](https://data-iremus.huma-num.fr/sherlock/mercure-galant/article/1702-08_211))." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<bebe5437-a020-441c-a647-0dad0113a597> a crm:PC3_has_note ;
    crm:P01_has_domain <d31c14e5-ef9a-4617-9993-c1e68a60df63> ;
    crm:P03_has_range_literal "Laurent Degas était magistrat et prévôt des marchands à Lyon. Il est également l'un des fondateurs de l'Académie des sciences, belles-lettres et arts de Lyon." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<bec9120c-efcc-4c99-af3b-92cb2204ca37> a crm:PC3_has_note ;
    crm:P01_has_domain <8f35d019-0bb2-41b2-834c-66d466c46367> ;
    crm:P03_has_range_literal "Le Noir (Jean-Charles-Pierre) (1732-1807), conseiller au Châtelet de Paris (1752…), lieutenant criminel au Châtelet de Paris (1759…), lieutenant général de la police de Paris (1774-1775 puis 1776-1785), maître des requêtes (1765…), président du Grand Conseil (1768…), conseiller d'État (1775…), bibliothécaire du roi (1784-1789)" ;
    crm:P3.1_has_type <c5402ae4-4ae9-48a1-86ed-c13de0c97d53> .

<bef73e5d-d2ee-46d1-9559-8cad30e72396> a crm:PC3_has_note ;
    crm:P01_has_domain <6b2ce12b-edfe-4f42-baaa-2104cbfdeb80> ;
    crm:P03_has_range_literal "M. Guillery est mentionné en tant que compositeur d'un Te Deum laudamus en musique, chanté le 10 juillet 1704 en l'église des Saints Innocents à Paris (cf. [1704-07b_246](https://data-iremus.huma-num.fr/sherlock/mercure-galant/article/1704-07b_246))." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

