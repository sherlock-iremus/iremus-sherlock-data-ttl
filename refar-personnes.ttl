<8d85dd43-baf8-4b90-996a-b06444b99155> a crm:PC3_has_note ;
    crm:P01_has_domain <31a432ef-d73b-4432-a30b-a2718bfb2c0e> ;
    crm:P03_has_range_literal "L'abbé Charlet est l'auteur d'odes latines dont une Sur la guerre présente publiée dans le Mercure galant d'août 1702 dans la traduction de l'abbé Mauguin (cf. MG-1702-08\\_211)." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<8daf7e33-47c5-4ae8-b350-c6d7e9b6bfc6> a crm:PC3_has_note ;
    crm:P01_has_domain <0c12ce1c-541d-413c-9030-a7d2b08e50fa> ;
    crm:P03_has_range_literal "Le Mercure galant de juillet 1704, consacré aux réjouissances pour la naissance du duc de Bretagne, mentionne M. Lhuillier, alors Grand-Maître du collège du Cardinal Lemoine (cf. MG-1704-07b\\_130). Les mémoires de la Société de l'histoire de Paris et de l'Ile-de-France publié en 1876 indiquent que Claude Leullier occupa ce poste de 1694 à sa mort en 1733 (https://gallica.bnf.fr/ark:/12148/bpt6k63057479). Dans leur article, Marie-Madeleine Compère et Boris Noguès lui attribuent la fonction de principal du collège du Cardinal Lemoine aux mêmes dates mais situent sa mort en 1732 («  La direction d'établissement dans les collèges de l'université de Paris sous l'Ancien Régime  », dans Histoire de l'éducation, 2001 ; https://journals.openedition.org/histoire-education/829)." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<8dcbeadf-7609-48df-a7ff-47f6fbf59d44> a crm:PC3_has_note ;
    crm:P01_has_domain <91345ba5-2291-4675-8c8c-e19962375a0e> ;
    crm:P03_has_range_literal "Belzunce (Adélaïde-élisabeth d'Hallencourt de Dromesnil, marquise de) (1747-1770), dame pour accompagner Madame Adélaïde (1763-1770)" ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<8dd82f73-873b-4f78-8674-ef6d55305210> a crm:PC3_has_note ;
    crm:P01_has_domain <6856ea59-763a-42fe-aa59-7335e4f4b955> ;
    crm:P03_has_range_literal "Fleury (Hercule-André de) (1653-1743), cardinal (1726-1743), ministre d'État (1726-1743)" ;
    crm:P3.1_has_type <c5402ae4-4ae9-48a1-86ed-c13de0c97d53> .

<8e0b2c92-bd68-484e-a796-528e46929c6b> a crm:PC3_has_note ;
    crm:P01_has_domain <ebc31a2e-3193-4965-bf20-b1f9334c179e> ;
    crm:P03_has_range_literal "M. le Febvre est mentionné en tant que gouverneur de la pompe de la Samaritaine, située sur le Pont-Neuf (cf. [1704-07b_47](https://data-iremus.huma-num.fr/sherlock/mercure-galant/article/1704-07b_47))." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<8e11de85-227d-4b89-95b3-aa4b6e6a9e3a> a crm:PC3_has_note ;
    crm:P01_has_domain <b6bca571-4a3d-42c6-b7ec-0bfcf9a22f95> ;
    crm:P03_has_range_literal "Poète, auteur du poème de la cantate *Le Feu de la ville*." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<8e15f943-362a-4af9-afa4-6e23fd2fc5b2> a crm:PC3_has_note ;
