<76711684-03fd-481f-93f6-cb808d52360f> a crm:PC3_has_note ;
    crm:P01_has_domain <fd232b9e-1aa7-4401-b2b3-940cac960ccd> ;
    crm:P03_has_range_literal "M. Bellot, chevalier, participa à une course traditionnellement organisée à Saint-Quentin (Picardie) (cf. [1680-05_089](https://data-iremus.huma-num.fr/sherlock/mercure-galant/article/1680-05_089))." ;
