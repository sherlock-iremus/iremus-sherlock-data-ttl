<b62b89df-27c2-48cb-9d06-e835db6146c6> a crm:PC3_has_note ;
    crm:P01_has_domain <6a02fda3-c2bd-4abb-ae7e-32bc28be0426> ;
    crm:P03_has_range_literal "Auteur d'un madrigal publié dans le *Mercure galant* (cf. 1697-01_148)." ;
