<0c9ff50b-951f-4c07-8371-3d43354cb366> a crm:PC3_has_note ;
    crm:P01_has_domain <78f286fe-087e-4e48-a5cf-5b6be3bad97d> ;
    crm:P03_has_range_literal "Le Mercure de juillet 1705 propose des paroles de M. de Choisel mises en musique par M. de Maiz et précise qu'\"ils sont tous les deux de la Flèche en Anjou\" (cf. MG-1705-07\\_109)." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<0d10c40d-e098-4e60-b7fd-9981471f8c03> a crm:PC3_has_note ;
