<b5122d86-1ad5-406d-a07c-93775b51b001> a crm:PC3_has_note ;
    crm:P01_has_domain <632aa3cc-5dfd-40bc-b019-9bc72ef54973> ;
    crm:P03_has_range_literal "\"de Caen\", auteur d'une explication en vers de l'énigme de la mouche parue dans le Mercure galant (cf. MG-1678-12e\\_375)." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<b55811fa-55e1-40a6-9d1e-4dcf168ed01e> a crm:PC3_has_note ;
    crm:P01_has_domain <e12b8e76-b46e-4d9f-bb05-3c675c638af7> ;
