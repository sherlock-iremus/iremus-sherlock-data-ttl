    crm:P03_has_range_literal "Poète, auteur des paroles de la cantate Mars et Thétis parue en 1769." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<ea0c5fe4-cfe7-4da0-a9a2-10bf0b5065fd> a crm:PC3_has_note ;
    crm:P01_has_domain <adeffde6-7401-4838-936a-3a75ba3fef54> ;
    crm:P03_has_range_literal "Capitaine au régiment Piemont, gouverneur du château de Meudon (cf. [1686-09b_295](https://data-iremus.huma-num.fr/sherlock/mercure-galant/article/1686-09b_295))." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<ea19432f-e75e-4ebb-a55b-cc656450132c> a crm:PC3_has_note ;
    crm:P01_has_domain <0c6d91b5-157e-4c17-81e7-cb3e9ea3e2a2> ;
    crm:P03_has_range_literal "Gabrielle Glé de La Cotardais, marquise de la Vallière, était l'épouse de Jean-François de La Baume Le Blanc (1642-1676), marquis de La Vallière et la belle-soeur de Louise-Françoise de La Baume Le Blanc (1644-1710), duchesse de La Vallière, favorite de Louis XIV." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<ea62e151-318f-48df-9651-90bd0849b3ef> a crm:PC3_has_note ;
    crm:P01_has_domain <a69bf250-9e4b-44a7-a2eb-9590fa17c8ed> ;
    crm:P03_has_range_literal "M. Du Breuil de Vignancourt est l'auteur d'airs parus dans le *Nouveau Mercure* entre 1714 et 1716. D'après la livraison de novembre 1714, M. du Breuil de Vignancourt était un \"digne élève du fameux Lambert\" (cf. [1714-11_345](https://data-iremus.huma-num.fr/sherlock/mercure-galant/article/1714-11_345)). Un commentaire de Dusfresny dans le *Mercure* de novembre 1715 (cf. MG-1715-11\\_090) permet de lui attribuer un air signé sous le pseudonyme \"Amoureux oïsif des bords de Marne\" : il indique en effet que sous ce pseudonyme se cache l'auteur du poème et de la musique, et accompagne cet air de sa partition gravée portant le nom de \"De Breüil de Vignancourt\"." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<ea7af3f1-d97c-4c30-a88d-b67ed03f20ac> a crm:PC3_has_note ;
    crm:P01_has_domain <c9d15fc7-ac9b-4a2f-ab50-b2e809b1463c> ;
    crm:P03_has_range_literal "lieutenant du roi (1681.12)" ;
    crm:P3.1_has_type <c5402ae4-4ae9-48a1-86ed-c13de0c97d53> .

<ea808850-7354-46f0-b82d-e1155fede719> a crm:PC3_has_note ;
    crm:P01_has_domain <6bc3ec38-1797-4cb8-8633-65a70b1ce20f> ;
    crm:P03_has_range_literal "Premier échevin d'Alençon (cf. MG-1682-11_268)." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<ea80ed55-3485-4638-821d-2f007c2cb6f7> a crm:PC3_has_note ;
    crm:P01_has_domain <0a8d7ee8-dbe1-4035-8939-24d3338d5bf7> ;
    crm:P03_has_range_literal "M. de La Barre, «  de Tours  », est l'auteur d'un conte publié dans le *Mercure galant* (cf. MG-1685-03\\_033)." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<eac79f52-c57d-4578-8273-d1a0ad06f408> a crm:PC3_has_note ;
