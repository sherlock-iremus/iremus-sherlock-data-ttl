<1cb284af-8078-4b29-b61c-65dcddc14e69> a crm:PC3_has_note ;
    crm:P01_has_domain <816bf254-08f6-4c59-9cb1-d91d2a533ad9> ;
    crm:P03_has_range_literal "M. Pageau est l'auteur des paroles d'un air publié dans le *Mercure Galant* d'août 1679 (cf. MG-1679-08\\_362). Dans sa présentation de l'air, le rédacteur du *Mercure* précise que M. Pageau est avocat au Parlement." ;
