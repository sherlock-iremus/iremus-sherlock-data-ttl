    crm:P03_has_range_literal "Binet (Louis-Jacques) (v. 1659-1731), garçon de la Chambre du roi (v. 1664-1718), portier du château-neuf de Saint-Germain-en-Laye (1691…), huissier de la salle (1693-1731), coffretier et malletier de la Chambre et Garde-robe (1694...), premier valet de Garde-robe (1718-1731), gouverneur et conducteur des volières de la basse-cour de Château Neuf (...-1731)" ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

