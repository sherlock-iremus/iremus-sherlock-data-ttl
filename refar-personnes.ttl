<51b909fe-559c-48d0-8dc7-ebc268fbe29b> a crm:PC3_has_note ;
    crm:P01_has_domain <775655c0-3660-4758-b0ec-7b13a0f706ac> ;
    crm:P03_has_range_literal "Mme de Régis est l'auteur d'un sonnet publié dans la livraison d'août 1702 (cf. [1702-08_5](https://data-iremus.huma-num.fr/sherlock/mercure-galant/article/1702-08_5)), demeurant à Mansonville." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

