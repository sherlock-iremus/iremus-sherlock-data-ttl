    crm:P03_has_range_literal "Nointel (Louis Béchameil de) (1649-1718), substitut du procureur général du parlement de Paris (1669…), conseiller au parlement de Paris (1670…), maître des requêtes ordinaire de l'Hôtel du roi (1674…), commissaire du roi aux États de Bretagne (1679…), intendant à Tours (1680-1689), en Champagne (1689-1691), en Bretagne (1691-1705), conseiller d'État semestre (1704…), inspecteur général des vivres et étapes (1709…), conseiller d'État extraordinaire (1712…), conseiller au Conseil de commerce (…1718…)" ;
    crm:P3.1_has_type <c5402ae4-4ae9-48a1-86ed-c13de0c97d53> .

<3b6d7776-72e4-4e11-b032-8a8d5533bc67> a crm:PC3_has_note ;
    crm:P01_has_domain <40e7f73f-7a8e-463b-8299-ae38233a2dce> ;
    crm:P03_has_range_literal "Le Mercure galant mentionne Madame la Présidente de Champagne qui a participé aux réjouissances publiques organisées à Château-Gontier pour la naissance du duc de Bretagne en 1704 (cf. [1704-07b_393](https://data-iremus.huma-num.fr/sherlock/mercure-galant/article/1704-07b_393))." ;
