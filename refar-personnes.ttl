<bc57f4e9-94a4-4c38-95c3-83027e6fcbc2> a crm:PC3_has_note ;
    crm:P01_has_domain <35b0da01-6f9a-4a1a-9d4d-ea03a475defa> ;
    crm:P03_has_range_literal "Luiggi Sampieri était le fils du marquis Filippo Maria Sampieri et de Costanza Scappi (pour un arbre de la famille, cf. http://badigit.comune.bologna.it/books/sol/mostratalon/pannello%201%20albero%20SAMPIERI%20.pdf)." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<bc65542a-9cc0-4607-ade9-5df6a397635f> a crm:PC3_has_note ;
    crm:P01_has_domain <f379276f-4bf5-483c-b1c1-a58c3c723391> ;
    crm:P03_has_range_literal "M. Charles, \"disciple de M. Brossant\" (cf. [1706-04_375](https://data-iremus.huma-num.fr/sherlock/mercure-galant/article/1706-04_375)), est l'auteur de la musique d'airs parus dans le Mercure galant entre 1706 et 1710. Peut-être convient-il de lire \"Brossard\" et non \"Brossant\"." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<bc824678-0bfb-4887-956c-49ce4dc940f0> a crm:PC3_has_note ;
