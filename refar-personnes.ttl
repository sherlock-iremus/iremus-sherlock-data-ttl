    crm:P3.1_has_type <c5402ae4-4ae9-48a1-86ed-c13de0c97d53> .

<5f18d167-14e5-4ec6-b501-1836c5966507> a crm:PC3_has_note ;
    crm:P01_has_domain <a6fc1723-a57f-4ed5-947d-42732ea461f7> ;
    crm:P03_has_range_literal "Don José Domingo Benito de Gurrea y Aragón a exercé la charge de gouverneur du royaume d'Aragon entre 1696 et 1705/6 (cf. Gómez Zorraquino, José Ignacio, *Patronazgo y clientelismo :Instituciones y ministros reales en el Aragón de los siglos XVI y XVII*, Prensas de la Universidad de Zaragoza,29 avr. 2016, p. 256)." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<5f1b75e1-92d5-4088-9b40-31e23b79f538> a crm:PC3_has_note ;
    crm:P01_has_domain <a4cbac91-cd6d-4f2f-84d9-d947ccc57717> ;
    crm:P03_has_range_literal "Avocat au Parlement de Paris, Conseiller du roi au Grand conseil (cf. MG-1679-10a_171), père de Charles-François de Montholon." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<5f690269-c523-4c16-8636-ac91db81e5fc> a crm:PC3_has_note ;
    crm:P01_has_domain <5429cd36-e2ad-456a-a381-bfb190036728> ;
    crm:P03_has_range_literal "Auteur du texte d'une cantate (*Ariane*) mise en musique par Duluc, Jean-Baptiste." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<5f7c9c5c-2b4e-4134-bb6e-d159312793e9> a crm:PC3_has_note ;
    crm:P01_has_domain <161de655-5f02-4c43-b887-73c3e7967f3c> ;
    crm:P03_has_range_literal "M. Chaleil de Sougues est l'auteur d'un madrigal publié dans le Mercure galant de février 1702 (cf. [1702-02a_85](https://data-iremus.huma-num.fr/sherlock/mercure-galant/article/1702-02a_85))." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<5f87cadf-bbbb-47a4-8a12-09fa1a8a81a1> a crm:PC3_has_note ;
    crm:P01_has_domain <1e03ef5f-60c3-4fc3-8f78-bd6fb9fa56f1> ;
    crm:P03_has_range_literal "Religieux de l'ordre de Saint-François à Montpellier (cf. MG-1687-03b_354)." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<5f8f8cc8-069f-453f-872d-6bb3cd73a13e> a crm:PC3_has_note ;
    crm:P01_has_domain <4fbd4cb4-e543-45ce-88ba-fad40775b993> ;
    crm:P03_has_range_literal "D'après le Mercure galant, un motet de M. Dubuisson, \"Pensionnaire de la Musique de Sa Majesté\", fut chanté à Fontainebleau durant la messe du roi (cf. [1707-10a_306](https://data-iremus.huma-num.fr/sherlock/mercure-galant/article/1707-10a_306))." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<5f9912b0-1347-4d40-a71a-f29ce037afc4> a crm:PC3_has_note ;
    crm:P01_has_domain <8ed87974-4398-4790-af97-d3505f4d53f7> ;
    crm:P03_has_range_literal "Le chanteur Jean Daniel, qui publia trois airs dans le *Mercure galant*, était neveu par alliance de Bertrand de Bacilly dont il épousa la nièce, Marie-Gatienne (cf. MG-1678-12\\_103 ; MG-1680-07\\_298 et MG-1680-08\\_312)." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<5f9b3db9-cf02-498b-8e1f-4ecb8b9720ad> a crm:PC3_has_note ;
    crm:P01_has_domain <231a1a81-c42e-45b5-83fc-bf8cd3b53ed5> ;
    crm:P03_has_range_literal "Raphaël Imbert est un augustin déchaussé provençal, auteur d'un Noël paru dans le Mercure galant en décembre 1702 (cf. MG-1702-12_185)." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<5fa18bd6-a93c-4190-8c1f-f760fffcb2bc> a crm:PC3_has_note ;
    crm:P01_has_domain <b4d3fb39-4581-49a8-861c-4d2eceed4381> ;
    crm:P03_has_range_literal "Jacobin à Paris (cf. MG-1708-08_236)." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<5fb77471-7a9b-49eb-89e0-1da5ecb27d58> a crm:PC3_has_note ;
    crm:P01_has_domain <09ae7b45-9bcd-4222-9e1f-485e7aaf75e7> ;
    crm:P03_has_range_literal "Supérieur des Célestin d’Avignon (1682.10)" ;
    crm:P3.1_has_type <c5402ae4-4ae9-48a1-86ed-c13de0c97d53> .

<5fd58502-09d4-47d9-9551-95f652e42b20> a crm:PC3_has_note ;
    crm:P01_has_domain <6459a4cf-570f-4df8-a73f-e8bcfed4eb78> ;
    crm:P03_has_range_literal "François Pétis de la Croix, orientaliste, fut aussi interprète de Louis XIV et enseigna l'arabe au Collège de France." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<5ff837c6-db86-40db-9dc5-133ed6dc49af> a crm:PC3_has_note ;
    crm:P01_has_domain <0f29e8f3-7658-419b-aafb-33aa33ee7f11> ;
    crm:P03_has_range_literal "Commissaire général de la Marine à Toulon (1666), à Marseille (1670), au Havre (1671), Intandant général des Galères à Marseille (1675-79, 1680-1684), intendant général des Galères de Toulon (1679), maître ordinaire de la Chambre des Comptes (1688)." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<6006c283-4340-444c-bac3-e2597119b1e4> a crm:PC3_has_note ;
    crm:P01_has_domain <e63278f3-0b9b-41e7-9abb-f2dc943e4a92> ;
    crm:P03_has_range_literal "Jean-Rémy Hénault (1648-1737), fermier général et père de Charles-Jean-François, acheta pour son fils la Lieutenance des Chasses et le Gouvernement de Corbeil à sa sortie de l'Oratoire (Claude Jordan et al., Suite de la clé, Journal historique des matières du temps, Ganeau, Paris, juin 1771, vol. 109, p. 443). Un article du Mercure galant consacré aux réjouissances pour la naissance du duc de Bretagne indique qu'il se distingua alors par la fête qu'il fit donner à Corbeil dans le cadre de ses nouvelles fonctions (cf. [1704-07b_281](https://data-iremus.huma-num.fr/sherlock/mercure-galant/article/1704-07b_281))." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<6008c200-9ddc-48cf-87ae-474fa1b44905> a crm:PC3_has_note ;
    crm:P01_has_domain <fdc4b2f4-88e0-4ca8-8fdd-baf6ae154033> ;
    crm:P03_has_range_literal "Régent de rhétorique au collège des Jésuites de Rennes (1695.05)." ;
    crm:P3.1_has_type <c5402ae4-4ae9-48a1-86ed-c13de0c97d53> .

<602a7396-3b19-4a27-ad64-8b3cd01b5b6c> a crm:PC3_has_note ;
    crm:P01_has_domain <5b777c93-129b-4b82-911d-b76ebc29d4ac> ;
    crm:P03_has_range_literal "Desmadrys (François) (?-1699), intendant d'Ypres et de Dunkerque (1680)" ;
    crm:P3.1_has_type <c5402ae4-4ae9-48a1-86ed-c13de0c97d53> .

<60590671-4cc1-41c8-8110-c0f674ca9661> a crm:PC3_has_note ;
    crm:P01_has_domain <75eddf53-3b2b-49dd-b959-51c7e6af43c3> ;
    crm:P03_has_range_literal "Lefebvre (Philippe) (v. 1630 - 1698), contrôleur des dedans du château de Versailles (1672-1698), contrôleur général triennal des Bâtiments du roi (1672-1698), intendant et contrôleur général de l’Argenterie, Menus Plaisirs et Affaires de la Chambre du roi, greffier de l'ordre de Saint-Louis (1693-1698)" ;
    crm:P3.1_has_type <c5402ae4-4ae9-48a1-86ed-c13de0c97d53> .

<605cfb8b-d2d9-43aa-bf67-50ea101258a7> a crm:PC3_has_note ;
    crm:P01_has_domain <f3109bda-9b52-4374-b4e7-d5e2680ffed8> ;
    crm:P03_has_range_literal "Cosnac (Daniel-Joseph de) (1700-1741), maître de l'oratoire (1732-1738), évêque de Die (1734-1741)" ;
    crm:P3.1_has_type <c5402ae4-4ae9-48a1-86ed-c13de0c97d53> .

<605f6d70-13de-44ac-9f7f-20e89fbfe0b6> a crm:PC3_has_note ;
    crm:P01_has_domain <dd00f3a4-cab5-4fc8-9385-46dc3f75c826> ;
    crm:P03_has_range_literal "Échevin à La Ferté-Milon (cf. MG-1687-03b_407)." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<606bcf22-7008-4445-a3df-1eb2e72e91b8> a crm:PC3_has_note ;
    crm:P01_has_domain <c4d1d247-c367-4185-98d9-6b40620dbc27> ;
    crm:P03_has_range_literal "Mlle de Saint-Quentin est l'autrice des paroles d'un air publié dans le *Mercure Galant* de décembre 1707 (cf. MG-1707-11-12\\_566) et d'un *Traité de la Possibilité de l'Immortalité Corporelle* évoqué dans le *Mercure Galant* de novembre 1692 et dans celui de janvier 1693. En 1804, le *Dictionnaire* de Fortunée Briquet écrit à son propos : \"SAINT-QUENTIN, (Mademoiselle de) fille d'un avocat de mérite, au parlement de Paris, vécut vers la fin du 17e. siècle. Elle était très-versée dans la philosophie de Descartes. On lui doit un traité, *Sur la possibilité de l'immortalité corporelle*, avec une réponse aux objections qui lui furent faites. Cet ouvrage fit beaucoup de bruit lorsqu'il parut.\" (Fortunée Briquet, *Dictionnaire historique, biographique et littéraire des Françaises et étrangères naturalisées en France*, Paris, Treuttel et Würtz, 1804.)" ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<606e4407-6a3f-42de-b7b9-1f7d7115dfe5> a crm:PC3_has_note ;
    crm:P01_has_domain <e010153c-d947-4a2a-b7b1-691bfab94d36> ;
    crm:P03_has_range_literal "Agostino Mari Torreri prit part aux manifestations organisées par la République de Gênes pour la réception de Philippe V d'Espagne en novembre 1702 (cf. MG-1702-12\\_191)." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<607c9019-c412-4c56-9a43-fc2bed1facc0> a crm:PC3_has_note ;
    crm:P01_has_domain <9446be51-ecd1-4e44-b645-6015d4ecdd25> ;
    crm:P03_has_range_literal "Maître de danse de Marie-Anne-Christine-Victoire de Bavière, dauphine de France." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<609b5b06-da5b-473b-8a3b-6c37d24c7c5a> a crm:PC3_has_note ;
    crm:P01_has_domain <2de9c93b-60d7-4c23-ad8d-bdaa2644601e> ;
    crm:P03_has_range_literal "Chanoine de Soissons et membre de l'académie de la même ville (cf. [1687-03a_262](https://data-iremus.huma-num.fr/sherlock/mercure-galant/article/1687-03a_262))." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<60a11e33-8827-41c2-b677-86f35592bd11> a crm:PC3_has_note ;
    crm:P01_has_domain <08a8e82e-50b3-4da3-a796-0276c450fb22> ;
    crm:P03_has_range_literal "Huissier du cabinet du roi (cf. MG-1682-10b_072)." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<60be4a32-7c46-40cb-b3d1-d3e8828a8d7a> a crm:PC3_has_note ;
    crm:P01_has_domain <8384cc96-655e-48fe-b708-6b483238b426> ;
    crm:P03_has_range_literal "La Vieuville (Charles-Emmanuel de Coskaer de) (1679-1730), aumônier du roi (1716-1730)" ;
    crm:P3.1_has_type <c5402ae4-4ae9-48a1-86ed-c13de0c97d53> .

<60d2f63d-c1c6-4459-ae52-b33ef60c180a> a crm:PC3_has_note ;
    crm:P01_has_domain <0727534d-b2ac-4fbb-aad6-9f6a87673e26> ;
    crm:P03_has_range_literal "Hénin (Adélaïde-Félicité-Étiennette de Guinot de Monconseil, princesse d') (1750-1823), dame du palais (1778-1789)" ;
    crm:P3.1_has_type <c5402ae4-4ae9-48a1-86ed-c13de0c97d53> .

<60d35c90-0276-4cb3-89aa-5070989a6226> a crm:PC3_has_note ;
    crm:P01_has_domain <0b65fb12-e8cf-40b0-b27f-86c7d51173b8> ;
    crm:P03_has_range_literal "Demoiselle de la cour de Hanovre, fille du général major Flemming (cf. [1681-08_144](https://data-iremus.huma-num.fr/sherlock/mercure-galant/article/1681-08_144))." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<60f899b4-21f0-448f-977b-e3552a71d034> a crm:PC3_has_note ;
    crm:P01_has_domain <a573739d-b2bd-4072-8924-b632640016d0> ;
    crm:P03_has_range_literal "Capitaine chevalier du guet de Paris (cf. MG-MG-1682-09b_331b)." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<61067f58-b430-4f85-b347-30b6648e32e0> a crm:PC3_has_note ;
    crm:P01_has_domain <07abdc82-5a40-4a8d-a659-6b05af5cbb8f> ;
    crm:P03_has_range_literal "Mlle de Villecourt a participé à un bal chez M. de Saint-Philibert à Château-Gontier pour célébrer la naissance du duc de Bretagne (cf. MG-1704-07b\\_393)." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<61146ddc-b374-4dd9-b297-d1ea6c93e889> a crm:PC3_has_note ;
    crm:P01_has_domain <0466a2a3-a61a-467f-a6e9-d98081630c2d> ;
    crm:P03_has_range_literal "élisabeth Pidou de Saint-Olon était la fille de François Pidou de Saint-Olon? Elle est l'autrice d'un air paru dans le *Mercure galant* (cf. [1700-04_215](https://data-iremus.huma-num.fr/sherlock/mercure-galant/article/1700-04_215))." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<611fbd57-2831-4506-9f34-40df4b5dfb8b> a crm:PC3_has_note ;
    crm:P01_has_domain <5d0eabdd-bdf8-4324-bbaf-b9c6fc0b5e57> ;
    crm:P03_has_range_literal "Gouverneur de l'ordre des Chevaliers de Saint-Georges (cf. [1679-06_036](https://data-iremus.huma-num.fr/sherlock/mercure-galant/article/1679-06_036))." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<6139bcda-4c41-4a1c-b2e5-9d3f57b1f2bf> a crm:PC3_has_note ;
    crm:P01_has_domain <dbea4436-bdeb-49ea-a8a1-b3c26b3e20a2> ;
    crm:P03_has_range_literal "Sève (Guillaume de) (1638-1696), intendant de Montauban (1669), de Bordeaux et de Béarn (1673-1678), premier président au parlement de Metz (1681), intendant des Trois-Évêchés (1691)." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<61475739-94ab-4389-835e-edc29fdbe8b3> a crm:PC3_has_note ;
    crm:P01_has_domain <7db2e3e6-3234-4758-8b9b-2516355708f1> ;
    crm:P03_has_range_literal "Médailleur allemand." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<615883f9-1839-49e2-b733-1270fdf37bf2> a crm:PC3_has_note ;
    crm:P01_has_domain <d6c3a737-80e4-4c5f-91bd-c1a4d6beca66> ;
    crm:P03_has_range_literal "M. de la Tour est l'auteur de sept airs publiés dans le Mercure galant entre 1678 et 1720 (2 en 1678, 1 en 1693, 1 en 1705, 3 en 1719 et 1720). Il est toutefois difficile de savoir s'il s'agit du même compositeur ou non." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<61632252-b0c5-4e9a-a347-461bf0ab9b1e> a crm:PC3_has_note ;
    crm:P01_has_domain <492c9626-daca-45e6-b965-b5513b61331c> ;
    crm:P03_has_range_literal "Juste (Marie-Jeanne) (active en 1773), peintre du Cabinet du roi" ;
    crm:P3.1_has_type <c5402ae4-4ae9-48a1-86ed-c13de0c97d53> .

<61782a4c-e7f2-4676-9aea-4314a63df972> a crm:PC3_has_note ;
    crm:P01_has_domain <f68b2600-393f-4a26-a9f7-e5cad77a34b0> ;
    crm:P03_has_range_literal "Sandrié (Jérôme) (1693-1767), maître charpentier à Paris et des Bâtiments du roi" ;
    crm:P3.1_has_type <c5402ae4-4ae9-48a1-86ed-c13de0c97d53> .

<61fcf3d9-3f6e-4f7e-b28a-69754530c0f4> a crm:PC3_has_note ;
    crm:P01_has_domain <0c661022-7bc2-4cea-888f-723214dc35c1> ;
    crm:P03_has_range_literal "M.-I.-G.-A de la Mothe-Houdancourt fut gouvernante des enfants royaux de 1709 à 1710." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<62054cbe-ce9f-4fad-9187-0bac88bf9161> a crm:PC3_has_note ;
    crm:P01_has_domain <00cfae11-79f1-44da-93ef-d06e2565b506> ;
    crm:P03_has_range_literal "M. du Careau composa la musique de quatre airs parus dans le Mercure galant en 1707 (cf. [1707-02_19](https://data-iremus.huma-num.fr/sherlock/mercure-galant/article/1707-02_19), [1707-02_163](https://data-iremus.huma-num.fr/sherlock/mercure-galant/article/1707-02_163), [1707-05_134](https://data-iremus.huma-num.fr/sherlock/mercure-galant/article/1707-05_134), [1707-11-12_160](https://data-iremus.huma-num.fr/sherlock/mercure-galant/article/1707-11-12_160))." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<620f6ec6-a231-47e9-b7df-0ec9265a2af1> a crm:PC3_has_note ;
    crm:P01_has_domain <51ed1529-59a0-403c-86d5-f2171cad1391> ;
    crm:P03_has_range_literal "M. l'abbé Roy «  Chanoine de S. Jacques de l'Hopital, âgé de 80 ans  » est l'auteur du poème d'un air en l'honneur de Louise-Adélaïde de Savoie publié dans la livraison d'août 1718 du Mercure galant (cf. MG-1718-08\\_188)." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<6216fb81-7653-4c63-a3f4-b479ec7e65e1> a crm:PC3_has_note ;
    crm:P01_has_domain <b2839e57-1157-481f-9b0f-76d3eef7c4ef> ;
    crm:P03_has_range_literal "L'abbé Gualtieri, frère de Filippo Antonio Gualtieri, nonce ordinaire du Pape à Paris, assista à la célébration de la fête de Saint-Lazare à l’abbaye de Saint-Germain-des-Prés le 19 décembre 1703 (MG-1703-01\\_210)." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

