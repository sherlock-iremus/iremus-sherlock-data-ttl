<1c0e5442-7735-4f6e-9240-d82003c04f42> a crm:PC3_has_note ;
    crm:P01_has_domain <fd76b1ee-98b0-4460-ba99-822d9556313b> ;
    crm:P03_has_range_literal "M. Maugard, de Troyes, est l'auteur d'une paraphrase du psaume Exaudiat publiée dans le Mercure galant d'août 1702 (cf. [1702-08_176](https://data-iremus.huma-num.fr/sherlock/mercure-galant/article/1702-08_176)). Si l'on se fie au texte de l'épître en vers à Louis Nivelle publiée dans le périodique en février 1702, c'est le même M. Maugard qui en est l'auteur (MG-1702-02a\\_146)." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<1c48e5e4-026c-4320-b07e-853f631ceb83> a crm:PC3_has_note ;
    crm:P01_has_domain <2bb63b71-7360-481b-a700-71d45524e1d8> ;
    crm:P03_has_range_literal "Bourdelin (Louis-Claude) (1696-1777), professeur de chimie et pharmacie du Jardin royal (1743-1777), premier médecin de Mesdames (1762…), doyen de la Faculté de médecine" ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

