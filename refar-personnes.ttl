<0139e083-5c4c-4728-b6c3-96d1acd1287b> a crm:PC3_has_note ;
    crm:P01_has_domain <b7a21c58-d24d-4430-adce-53b873ab904e> ;
    crm:P03_has_range_literal "Vincent Hantier était abbé au collège des Jésuites du Havre (cf. Albert Anthiaume, \\_Le Collège du Havre, contribution à l'histoire de l'enseignement secondaire en France et particulièrement au Havre (1579-1865)\\_, Tome 1, Le Havre, 1905, p. 344). Arrivé à Paris (1689), il change son  nom en Antier." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<015dd348-2801-4dec-89d1-9301c775df21> a crm:PC3_has_note ;
