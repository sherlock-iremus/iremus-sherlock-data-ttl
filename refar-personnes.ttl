<e9f76abf-d253-4514-a358-301dc3ad6ac8> a crm:PC3_has_note ;
    crm:P01_has_domain <de6a5a39-4e26-4f2c-83d5-96807c966699> ;
    crm:P03_has_range_literal "L'abbé Dionis, abbé commendataire de Notre-Dame de Beaulieu en Rouergue (1690-1739) et prieur de Saint-Andéol de Parisot (1690-1709), a participé aux réjouissances données à Saint-Antonin à l'occasion de la naissance du duc de Bretagne (cf. MG-1704-08\\_307)." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<ea046c00-3e7e-4e24-bb5c-b77a6d256105> a crm:PC3_has_note ;
    crm:P01_has_domain <963a09b1-e183-4a5d-a0f4-9bd2f21a5fb0> ;
    crm:P03_has_range_literal "M. du Four, \"Musicien de Toulouse\", composa la musique d'un air publié dans le Mercure galant (cf. [1689-09_376](https://data-iremus.huma-num.fr/sherlock/mercure-galant/article/1689-09_376))." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<ea0ae116-98a3-404a-886e-cb44221e9ee9> a crm:PC3_has_note ;
