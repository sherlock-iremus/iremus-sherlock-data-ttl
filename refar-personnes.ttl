<4e75f599-191d-4e68-b4b7-e28fc9818993> a crm:PC3_has_note ;
    crm:P01_has_domain <d3cf1a9c-a77f-417c-9886-8fb43e34f65a> ;
    crm:P03_has_range_literal "Claude Philippe Auburtin fut « reçut avocat au Parlement de Metz le 12 septembre 1678. Il fut maire alternatif de Metz en 1707-1712 et 1720-1738 (cf. étienne Broglin, Dictionnaire biographique sur les pensionnaires de l'académie royale de Juilly (1651-1828) Tome I, 2017, p. 533)." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

