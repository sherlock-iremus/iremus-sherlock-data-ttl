    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<c65aa812-944f-4131-871d-16bd5a13c8fe> a crm:PC3_has_note ;
    crm:P01_has_domain <4689332c-e034-4bd6-8280-0d5b3faa9146> ;
    crm:P03_has_range_literal "M. de Monbrun est l'auteur des paroles d'airs publiés dans le *Mercure Galant* d'octobre 1681 (cf. MG-1681-10\\_125 ; MG-1681-10\\_375) et janvier 1682 (cf. MG-1682-01\\_275). Le *Mercure Galant* d'octobre 1681 précise qu'il est conseiller au Parlement de Toulouse." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

