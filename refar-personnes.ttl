<a61a1da1-db22-4cc8-beb2-67547e884fc5> a crm:PC3_has_note ;
    crm:P01_has_domain <c6174b29-7226-40da-a705-00f95f602e27> ;
    crm:P03_has_range_literal "M. Le Comte est l'auteur des paroles d'un air publié dans le *Mercure* *Galant* d'août 1698, qui précise qu'il est \"Conseiller au Parlement de Toulouse\" (cf. MG-1698-08\\_127)." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<a633ee24-2565-4504-918a-f8b72d0c1564> a crm:PC3_has_note ;
    crm:P01_has_domain <8247c51c-4b9a-4826-b038-4ef3e20a87d0> ;
    crm:P03_has_range_literal "Cossé (Adélaïde-Diane-Hortense Mancini-Mazarini, duchesse de) (1742-1808), dame d'atours de la dauphine, puis de la reine (1770-1775)" ;
    crm:P3.1_has_type <c5402ae4-4ae9-48a1-86ed-c13de0c97d53> .

<a63db2de-97c4-4a20-b7f6-fe25616ecc17> a crm:PC3_has_note ;
    crm:P01_has_domain <bcb07a0d-c20d-4ce8-a2b0-15e60393a2b8> ;
    crm:P03_has_range_literal "Surintendante de la Maison de la reine (1660-1661)." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<a63f2972-696d-40bd-8acd-d5858e2739f6> a crm:PC3_has_note ;
    crm:P01_has_domain <bbb4c5ac-e104-4add-941d-31f533b4e77f> ;
    crm:P03_has_range_literal "Prêtre provençal, auteur d'une tragédie Le siècle d'or dans l'Isle de Malte, sous les Regne de son Eminence Nicolas de Cotoner publiée et représentée à Malte en janvier 1680 (cf. [1680-03a_012](https://data-iremus.huma-num.fr/sherlock/mercure-galant/article/1680-03a_012))." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<a64cab03-6ad6-44a6-8d1c-e6b8c256b783> a crm:PC3_has_note ;
    crm:P01_has_domain <7d3b47ab-5621-4a05-934a-2390ab03251c> ;
    crm:P03_has_range_literal "Consul de Grenoble (cf. MG-1693-07\\_196) en 1693, conseiller du roi, premier assesseur de l'hôtel de ville de Grenoble en 1710 et 1724, greffier en chef des insinuations ecclésiastiques du diocèse de Grenoble en 1729." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<a6738010-ac9d-4b61-b1c2-c8ef9e7a8c48> a crm:PC3_has_note ;
