    crm:P3.1_has_type <c5402ae4-4ae9-48a1-86ed-c13de0c97d53> .

<76a77f5e-204c-4de8-977e-d8eb71ce563a> a crm:PC3_has_note ;
    crm:P01_has_domain <1dc8031b-7b19-4d64-9e64-b34f88e98837> ;
    crm:P03_has_range_literal "M. Rigault, \"de Tours\", publia deux airs dans le *Mercure galant* (cf. [1678-06_316](https://data-iremus.huma-num.fr/sherlock/mercure-galant/article/1678-06_316), [1678-12_049](https://data-iremus.huma-num.fr/sherlock/mercure-galant/article/1678-12_049))." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

