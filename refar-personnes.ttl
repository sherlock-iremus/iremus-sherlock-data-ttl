    crm:P03_has_range_literal "Du Plessis d'Argentré (Charles) (1673-1740), aumônier du roi (1709-1725), évêque de Tulle (1725-1740)" ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

