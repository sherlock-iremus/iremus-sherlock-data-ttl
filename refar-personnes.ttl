<074d6272-8dfa-4130-99bc-0d1dc3c927f3> a crm:PC3_has_note ;
    crm:P01_has_domain <7d3b47ab-5621-4a05-934a-2390ab03251c> ;
    crm:P03_has_range_literal "Consul de Grenoble (cf. [1693-07_196](https://data-iremus.huma-num.fr/sherlock/mercure-galant/article/1693-07_196)) en 1693, conseiller du roi, premier assesseur de l'hôtel de ville de Grenoble en 1710 et 1724, greffier en chef des insinuations ecclésiastiques du diocèse de Grenoble en 1729." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

