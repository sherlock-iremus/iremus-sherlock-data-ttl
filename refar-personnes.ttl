<e9617da5-b5c9-4b2e-a5f8-7f2f419fbc0a> a crm:PC3_has_note ;
    crm:P01_has_domain <46d86c4a-f495-4a21-b8b2-91c3f9310647> ;
    crm:P03_has_range_literal "On connaît de Mlle Laurant un air paru dans le Mercure galant (cf. [1687-08a_101](https://data-iremus.huma-num.fr/sherlock/mercure-galant/article/1687-08a_101)) et un Concert donné à la Dauphine dans les grands appartements de Versailles, copié par l'atelier Philidor en 1690 (F-V/ Ms mus 133)." ;
