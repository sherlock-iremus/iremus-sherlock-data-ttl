<d15e6540-a118-403e-b359-d056bccddde0> a crm:PC3_has_note ;
    crm:P01_has_domain <dc782aff-a132-4d3e-a1bd-b44193d6627f> ;
    crm:P03_has_range_literal "Boquet (Louis-René) (1717-1814), dessinateur d'habits, entrepreneur de décorations et fabricant d'accessoires pour les Menus Plaisirs et pour l'Académie royale de musique (1751-1789), dessinateur en chef des habits de fêtes et cérémonies (1764-1789), inspecteur général des Menus Plaisirs (1781-1789)" ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

