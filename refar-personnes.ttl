    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<53fe3578-d0dc-4277-895c-77a19fb14f4b> a crm:PC3_has_note ;
    crm:P01_has_domain <4f8d1de7-4640-4702-b0ac-d89e6582c39d> ;
    crm:P03_has_range_literal "M. de La Coste pourrait avoir proposé une nouvelle harmonisation de l'air \"Ainsi que mon amour\" publié anonymement dans le Mercure galant de septembre 1700 (cf. [1700-09_144](https://data-iremus.huma-num.fr/sherlock/mercure-galant/article/1700-09_144)). Cette harmonisation est parue dans le Recueil d'airs sérieux et à boire (Paris, Ballard, juillet 1700)." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<54144399-dd8b-452c-ac1e-d45b11a0a5d0> a crm:PC3_has_note ;
