<a42a5d2a-d6f5-41f8-8d37-08865e3cd072> a crm:PC3_has_note ;
    crm:P01_has_domain <eaffe7f7-53a7-487d-b734-59e57d999be4> ;
    crm:P03_has_range_literal "Louise-Diane-Françoise de Clermont-Gallerande, duchesse de Brancas (1711-1784) fut dame pour accompagner Mesdames aînées (1746-1750) ; dame d'honneur de la dauphine en survivance (1750-1762) puis en titre (1762-1767) ; dame d'honneur de la comtesse de Provence (1771-1772)." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<a42f28dc-79bb-4f77-b50d-05c52bf917b4> a crm:PC3_has_note ;
