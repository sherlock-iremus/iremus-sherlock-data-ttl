<3e43f8ed-df4e-4c1a-8768-e7b0cbd455fe> a crm:PC3_has_note ;
    crm:P01_has_domain <a92f5835-5463-439b-a9cd-048cb90ed8f9> ;
    crm:P03_has_range_literal "Bellinzani (Francesco) (1619-1684), intendant du duc de Mazarin (…1666…), inspecteur général du commerce et inspecteur général des manufactures (…1680-1681…)" ;
