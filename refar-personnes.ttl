    crm:P01_has_domain <edc7bc30-1180-4f61-9a17-cd173cf1472a> ;
    crm:P03_has_range_literal "échevin de Troyes (cf. MG-1678-09e\\_309)." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<d4d96f51-fa3e-499d-ab2c-cb8b2dbd0e51> a crm:PC3_has_note ;
    crm:P01_has_domain <2ee13819-1144-4aab-b8ba-d92c6ddf486f> ;
    crm:P03_has_range_literal "«Seigneur de Précy-sur-Marne et d’Arcueil, Pomponne de Refuge, marquis de Refuge (1642-1712), fut successivement lieutenant au bailliage d’Évreux sur démission de son frère (1689), colonel du régiment de Bourbonnais (1672), brigadier d’Infanterie (1676), capitaine d’une compagnie de cadets et gouverneur de Clermont (juin 1685), brigadier d’Infanterie (1676), gouverneur de Charlemont (1685), maréchal de camp (août 1688), lieutenant général des armées (1688). Il terminera sa carrière comme commandant de Franche-Conté (1703) et dans les Trois-Evêchés (1704)» (cf. <http://www.hyacinthe-rigaud.com/catalogue-raisonne-hyacinthe-rigaud/portraits/484-refuge-pomponne-de>, consulté le 1 avril 2021)." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<d4df382e-2a4a-4136-aa37-eb74bf55c0c9> a crm:PC3_has_note ;
    crm:P01_has_domain <283afa56-4a33-4a1e-aed1-4ec6e82cc81f> ;
    crm:P03_has_range_literal "Vincent Puvigné, chantre de la Musique du roi, est mentionné dans les états des officiers de la Maison du roi entre 1680 et 1731 (cf. Marcelle Benoit, Musiques de cour, Paris, A. et J. Picard, 1971)." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<d4f2a38c-f8e2-46d2-af81-b3985a3bd1d9> a crm:PC3_has_note ;
