    crm:P03_has_range_literal "Fille de François Courtel, maître de dans de la cour de Würtemberg, qui dansa dans un ballet donné dans cette cour (cf. [1684-11_034](https://data-iremus.huma-num.fr/sherlock/mercure-galant/article/1684-11_034))." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

