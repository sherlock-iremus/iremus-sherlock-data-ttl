    crm:P03_has_range_literal "Épouse de Pierre de Bérulle (1641-1723), intendant d'Auvergne (1685-1687), de la généralité de Lyon (1687-1694) puis premier président au parlement de Grenoble." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<32047698-882f-4a95-a433-a12c69027289> a crm:PC3_has_note ;
    crm:P01_has_domain <a4e41db5-643f-42d8-ab08-d2c517bcbefd> ;
    crm:P03_has_range_literal "Épouse de M. de La Mothe, lieutenant du roi, commandant de la place de Maubeuge (cf. MG-1700-01_044)." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<322e60f3-c439-458f-bf37-ca9fe58e8801> a crm:PC3_has_note ;
    crm:P01_has_domain <03fd5ae8-eae4-41ab-9412-237c16008531> ;
    crm:P03_has_range_literal "Enseigne au Régiment des Gardes françaises en 1654, promu lieutenant en 1656 puis Major de son Régiment en 1670. Il leva son propre régiment de Dragons en 1674. Gouverneur et grand bailli des ville et citadelle de Tournai (voir Chronologie historique-militaire par M. Pinard, t. 6, 1763). Il était également l'oncle de M. de Combes, lieutenant général de Riom (cf. [1687-04_297](https://data-iremus.huma-num.fr/sherlock/mercure-galant/article/1687-04_297))." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<322f0d63-148d-4e7a-9afa-7293d313bb76> a crm:PC3_has_note ;
    crm:P01_has_domain <78888404-752e-48b6-940f-00fe6cd63c9d> ;
    crm:P03_has_range_literal "Procureur du roi au Châtelet (cf. MG-1684-10_007, secrétaire du roi et de la cour de Parlement de paris, greffier en la grande chambre du Parlement." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<3234e0d7-3577-434d-af85-554191498ed7> a crm:PC3_has_note ;
    crm:P01_has_domain <81045ecd-42ec-418a-9f82-a1f886bc4cef> ;
