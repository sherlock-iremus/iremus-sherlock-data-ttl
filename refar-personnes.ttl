    crm:P01_has_domain <ec5fb315-0d68-4250-aa6e-1cac699263ca> ;
    crm:P03_has_range_literal "Francisco Maria Serra prit part aux manifestations organisées par la République de Gênes pour la réception de Philippe V d'Espagne en novembre 1702 (cf. MG-1702-12\\_191)." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<19944d0e-fb3f-41ae-bd6f-a96a89418e4e> a crm:PC3_has_note ;
    crm:P01_has_domain <b084d5d0-ed77-4272-9dca-86f188021876> ;
    crm:P03_has_range_literal "Premier président du parlement de Paris et garde des sceaux (cf. [1681-05_087](https://data-iremus.huma-num.fr/sherlock/mercure-galant/article/1681-05_087))." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<199f16ac-2ef0-41dd-be27-c6d7ccbf2b32> a crm:PC3_has_note ;
    crm:P01_has_domain <03d48361-9527-4548-9115-757279dcf256> ;
    crm:P03_has_range_literal "Conseiller au parlement (cf. [1678-06_222](https://data-iremus.huma-num.fr/sherlock/mercure-galant/article/1678-06_222))." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<19a20102-fa84-4de5-ab79-57c0c571d851> a crm:PC3_has_note ;
    crm:P01_has_domain <c4323fbe-80d8-4979-980b-700c0f9380cd> ;
    crm:P03_has_range_literal "échevin de Noyons (cf. MG-1690-08\\_072)." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<19c7f33a-d218-4319-a227-ca9f40ce8887> a crm:PC3_has_note ;
    crm:P01_has_domain <c92f5e49-d8b0-4b34-bdf7-d0a3b0cb96dc> ;
    crm:P03_has_range_literal "D'après le *Mercure galant*, M. Normandeau était organiste du Collège de Navarre. Il est l'auteur de deux airs parus dans le périodique en 1689 et 1691 (cf. MG-1689-06a\\_114 et MG-1691-09\\_311a). Il ne doit pas être confondu avec M. Normandeau l'aîné, dont le *Mercure galant* affirme en 1699 qu'il était \"cy-devant Page de la Chapelle du Roy\" (cf. MG-1699-09\\_205) qui pourrait être son fils." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<19d08705-e79a-48f8-92d8-765f1eeca199> a crm:PC3_has_note ;
    crm:P01_has_domain <fdb8d53f-b098-4c25-8d52-b319fcb7c262> ;
    crm:P03_has_range_literal "Dame de Bordeaux (cf. [1682-09b_015](https://data-iremus.huma-num.fr/sherlock/mercure-galant/article/1682-09b_015))." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<19e35661-942d-4007-beb3-a2b4f820a10a> a crm:PC3_has_note ;
    crm:P01_has_domain <9ba4c463-f139-4a1c-b358-21a63535f8fc> ;
    crm:P03_has_range_literal "Capucin à Constantinople (cf. MG-1687-08b\\_254)." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<1a1d679b-b5bf-48cb-8d20-ab418bc0e9a2> a crm:PC3_has_note ;
    crm:P01_has_domain <f640683f-a7f5-4b1b-a7a6-47c092c27352> ;
    crm:P03_has_range_literal "Fils du baron puis marquis d'Ollières et frère de M. de Mirabeau (cf. MG-1687-06a\\_166). On peut l'identifier soit à Augustin d'Agoult d'Ollières, soit à Gaspard d'Agoult d'Ollières." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<1a38b4aa-617b-44e1-a750-67adacb95a84> a crm:PC3_has_note ;
    crm:P01_has_domain <26767cf0-8cae-465d-9f23-c263697e75b0> ;
    crm:P03_has_range_literal "M. Pivin, \"d'un pays où l'on ne fait point de scrupule de faire rimer Trompette avec Conqueste\", est l'auteur de quatre airs parus dans le *Mercure galant* en 1697 et 1698. Le *Mercure galant* indique que l'air paru en novembre 1697 a été chanté à Claye (de nos jours Claye-Souilly), au souper de la duchesse de Lorraine." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<1a5c6921-e7e2-4e62-86be-3c2138f586f9> a crm:PC3_has_note ;
    crm:P01_has_domain <f6a8181f-3697-4d89-ac22-46ad43dc397b> ;
    crm:P03_has_range_literal "Jésuite, ambassadeur de Pologne à Hispahan (cf. MG-1704-11_25)." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<1a6e6105-d82c-4bab-b7da-82a13f25e575> a crm:PC3_has_note ;
    crm:P01_has_domain <e6e99042-16a7-419a-9943-5d390c81e483> ;
    crm:P03_has_range_literal "Épouse de Pierre de Boissy, lieutenant du roi au Château-Trompette de Bordeaux (cf. MG-1701-01_160)." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<1a913fb5-04cf-45ba-a148-6fd8b800f106> a crm:PC3_has_note ;
    crm:P01_has_domain <897a8647-85d0-4bfd-96b9-afcabd894512> ;
    crm:P03_has_range_literal "D'après le *Mercure galant* où il publie un air, M. Riel était \"connu pour un des plus consommez que nous ayons dans la Musique, & le premier Eleve de Mr Lambert\" (cf. MG-1678-08\\_354)." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<1aaedb5c-71cc-4be6-8a26-5eae21f4c72a> a crm:PC3_has_note ;
    crm:P01_has_domain <783337c1-dab8-4d98-b70f-c98600f04457> ;
    crm:P03_has_range_literal "échevin de Semur-en-Auxois (cf. MG-1682-12\\_216) et auteur d'une Relation de ce qui c'est passé de plus considerable dans la rejouissance ordonnée par messieurs les magistrats de la ville de Semur, capitalle d'Auxois, sur la naissance de Monseigneur duc de Bourgogne en l'année 1682 (Pierre Palliot, imprimeur du roi, du rever. evesque duc de Langres, des états, & de la ville, à la Reine de Paix, devant la Cour du Palais, 1682)." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<1ad5bd2a-5597-44ff-9dd8-051332018513> a crm:PC3_has_note ;
