    crm:P03_has_range_literal "Civrac (Marie-Françoise de Pardaillan de Gondrin, marquise de) (1728-1764), dame pour accompagner Mesdames aînées (1747-1752), dame pour accompagner Madame Adélaïde (1752-1755), dame d'atours de Madame Adélaïde (1755-1764)" ;
    crm:P3.1_has_type <c5402ae4-4ae9-48a1-86ed-c13de0c97d53> .

<edd996fd-e4e6-4c66-be6a-52291603907f> a crm:PC3_has_note ;
    crm:P01_has_domain <af620b09-ca75-4a8b-94f0-be6faa285759> ;
    crm:P03_has_range_literal "M. Buquet le fils composa la musique d'un air paru dans le Mercure galant en août 1719 (MG-1719-08\\_148)." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<eddf0ba2-7643-459c-a8b5-66e066959c24> a crm:PC3_has_note ;
    crm:P01_has_domain <be636175-10c2-434c-ab7f-421358ebc342> ;
    crm:P03_has_range_literal "Florent Galland du Désert était maître à danser et fils de François Galland du Désert, Chancelier de l’Académie Royale de Danse (cf. [1680-06_263](https://data-iremus.huma-num.fr/sherlock/mercure-galant/article/1680-06_263)). Avec son frère, François II Galland du Désert, il constituait le duo “Des-Airs” (cf. Powell, John. “Pierre Beauchamps, Choreographer to Molière's Troupe du Roy” dans Music & Letters , Vol. 76, No. 2 (May, 1995), p. 172)." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

