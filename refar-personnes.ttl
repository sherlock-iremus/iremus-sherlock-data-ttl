<a408b328-806b-4ce4-9dbf-c214580ff12e> a crm:PC3_has_note ;
    crm:P01_has_domain <a484f9e1-0673-4df1-a589-14f8140fe9cf> ;
    crm:P03_has_range_literal "Jean Hannès Desjardins (fl. 1689-1731) était hautbois des plaisirs du roi et grand hautbois de la chambre du roi (cf. https://francearchives.fr/fr/facomponent/fc6f4c180c29654db742592bda23f5ba4613ddfa, consulté le 1er juin 2021)." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<a423a7ea-800d-406d-a429-aa6293ce2cd5> a crm:PC3_has_note ;
