    crm:P01_has_domain <bc011297-d793-41fb-9e98-d3231d1dc31b> ;
    crm:P03_has_range_literal "M. de La Terrasse et l'auteur d'un sonnet à la gloire de Philippe V d'Espagne publié dans le Mercure galant d'août 1702 et d'une traduction en vers des Noces de Pelée et de Thétis de Catule (MG-1702-08\\_176)." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

