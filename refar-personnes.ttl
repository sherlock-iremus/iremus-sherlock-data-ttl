    crm:P03_has_range_literal "Ignace-François de Limojon de Saint Didier a présenté en 1701 au duc d'Anjou et à ses frères une ode lors de leur passage à Avignon. Il est aussi mentionné qu'il est le neveu d'Alexandre-Toussaint de Limojon (1630?-1689), chevalier de Saint Didier (cf MG-1701-05B\\_079)." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<78cfff99-f9bf-499c-a0e7-f3ece394cb50> a crm:PC3_has_note ;
    crm:P01_has_domain <158ec798-de03-4f01-888b-f307d2e63aff> ;
    crm:P03_has_range_literal "Il a été attaché au service de la duchesse de 1687 à 1712 (cf. William Ritchey Newton, Almanach de la Cour, : W. R. Newton, copyright 2017, p. 1906)" ;
