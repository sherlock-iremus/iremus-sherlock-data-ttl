<6d8bc3ec-4636-4b12-9f50-208051f04dea> a crm:PC3_has_note ;
    crm:P01_has_domain <a58ed6f2-7d86-4ef5-a277-0ee0e76aef68> ;
    crm:P03_has_range_literal "M. de la Fevrerie était un contributeur du *Mercure Galant* qui publia en février 1695 sa \"Réponse à la Satire contre les Vers irreguliers employée dans le Mercure du mois d'Avril 1694\" (cf. MG-1695\\_02\\_236) et écrivit les paroles d'un air publié dans le *Mercure Galant* de décembre 1708 (cf. MG-1708-12\\_267)." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<6dd25faf-88a8-43ec-b1f0-48198dbc0e8b> a crm:PC3_has_note ;
    crm:P01_has_domain <df436147-738b-450a-bf99-82b750379641> ;
    crm:P03_has_range_literal "Joseph de la Fontaine Solare était un prêtre oratorien." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<6dd36ebd-4b7a-4859-8e14-d51018dbaf77> a crm:PC3_has_note ;
    crm:P01_has_domain <ad07a209-6696-47ae-8a5b-a1e6a7b55b97> ;
    crm:P03_has_range_literal "Arnaud Laborie, prêtre, était membre de l'Académie des Jeux floraux de Toulouse où il a été Maître entre 1679 et 1702. Il fut lauréat en 1672 (pris de l'Églantine), 1676 (prix du Souci) et 1679 (prix de la Violette) (cf. François de Gélis, Histoire critique des jeux floraux depuis leur origine jusqu'à leur transformation en Académie (1323-1694), Toulouse, E. Privat, 1912, p. 157, 284, 316-318) ." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<6e39567f-3340-4ba1-9920-d39a96684b07> a crm:PC3_has_note ;
