<3427d581-c90b-4e5f-8842-3748f1073a58> a crm:PC3_has_note ;
    crm:P01_has_domain <cecc3176-d5d1-4bd9-ae28-3d67c084d414> ;
    crm:P03_has_range_literal "Mlle d'O est l'autrice de deux airs parus dans le *Mercure galant* en 1680. En septembre 1680, le périodiqueaffirme \"[qu'] elle est du Quartier S. Paul, dont elle fait un des plus beaux ornemens, & tres-digne Fille d'une Mere qui ayant esté dans son Printemps la plus aimable du monde, conserve dans son Eté tous les agrémens que peuvent avoir celles de son âge.\" (cf. [1680-09a_340](https://data-iremus.huma-num.fr/sherlock/mercure-galant/article/1680-09a_340), [1680-11_045](https://data-iremus.huma-num.fr/sherlock/mercure-galant/article/1680-11_045))." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

