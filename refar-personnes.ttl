<42922bd4-f1b3-4ce8-9ae2-f625295f0ed9> a crm:PC3_has_note ;
    crm:P01_has_domain <5069b1b3-1e05-4f1e-8aca-bda0bb4e6bc7> ;
    crm:P03_has_range_literal "Nicolas Mathieu (1640 ca.-1706) était “Curé de Saint-André-des-Arts depuis 1678” (cf. de Dainville-Barbiche, Ségolène. « Prosopographie des curés de Paris (1695-1789) », Devenir curé à Paris. Institutions et carrières ecclésiastiques (1695-1789), sous la direction de de Dainville-Barbiche Ségolène. Presses Universitaires de France, 2005, p. 490)." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

