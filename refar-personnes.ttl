<fb294609-bc37-409e-894a-4efaf59ac914> a crm:PC3_has_note ;
    crm:P01_has_domain <0edc62b8-0ae2-4384-8f81-3c23fec9d98b> ;
    crm:P03_has_range_literal "Ferrand (François-Antoine) (1657-1731), conseiller au Châtelet (1677…), lieutenant particulier au Châtelet (1683…), maître des requêtes de l'hôtel du roi (1690-1718…), intendant de Bourgogne (1694-1705), intendant de Bretagne (1705-1716), conseiller au conseil du commerce (1716…), conseiller au conseil de la Marine (…1718…), conseiller d'État (1719…), maître des requêtes honoraire (…1722-1727…), conseiller d'État ordinaire (1728…)" ;
    crm:P3.1_has_type <c5402ae4-4ae9-48a1-86ed-c13de0c97d53> .

<fb2ff532-2dce-4b6e-8a83-6762a408be5a> a crm:PC3_has_note ;
    crm:P01_has_domain <aa1b5e8f-7ca1-4fe6-a030-cb3da39905ee> ;
    crm:P03_has_range_literal "Abbé. Agent diplomatique et artistique de Mazarin puis de Colbert à Rome." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<fb478933-0e5c-4e90-8ca6-2710d795f227> a crm:PC3_has_note ;
    crm:P01_has_domain <01917bf0-401e-4358-b0dd-3810e8b8eb83> ;
    crm:P03_has_range_literal "À propos de Joseph-Antoine Hennequin de Charmont, voir FROSTIN, Charles. Chapitre III. La diversité du réseau Pontchartrain et ses tendances affairistes, dans Les Pontchartrain, ministres de Louis XIV : Alliances et réseau d'influence sous l'Ancien Régime [en ligne], Rennes, Presses universitaires de Rennes, 2006 (généré le 25 mars 2021). Disponible sur Internet : . ISBN : 9782753532113. DOI : https://doi.org/10.4000/books.pur.9190." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<fb522af1-560f-432f-bc46-5e895038d8f2> a crm:PC3_has_note ;
    crm:P01_has_domain <99a3cdf8-6388-4616-9549-e0ecb2585fb6> ;
    crm:P03_has_range_literal "Eugène Durazzo prit part aux manifestations organisées par la République de Gênes pour la réception de Philippe V d'Espagne en novembre 1702 (cf. [1702-12_191](https://data-iremus.huma-num.fr/sherlock/mercure-galant/article/1702-12_191))." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

