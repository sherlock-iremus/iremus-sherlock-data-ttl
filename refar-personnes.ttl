<6d3d7a4b-2d2f-41c2-80db-fc7a33c78492> a crm:PC3_has_note ;
    crm:P01_has_domain <c58a25e4-d572-438e-a414-82485cf26fb7> ;
    crm:P03_has_range_literal "Antoine de Bochart de Champigny (fl. 1699-1739) devint trésorier de la Sainte Chapelle en 1699 (cf. Morand, Sauveur-Jérôme, Histoire de la Sainte Chapelle Royale du Palais, enrichie des planches. Paris: Clousier; Prault, 1790, p. 307 ; cf. https://gallica.bnf.fr/ark:/12148/bpt6k55486886, consulté le 30 avril 2021)." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<6d466e1d-f240-45c0-898a-2a3fc7cea140> a crm:PC3_has_note ;
