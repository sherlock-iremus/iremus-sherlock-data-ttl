<20cdbe76-1317-45c3-8b77-863a5632f2e1> a crm:PC3_has_note ;
    crm:P01_has_domain <6f416c47-13b7-4693-b07e-1f28e8f02a16> ;
    crm:P03_has_range_literal "François de Bertier (1657-1723) a été chevalier et seigneur de Saint-Geniez (Saint-Geniès-Bellevue), mainteneur de l'Académie des Jeux floraux et premier président du Parlement de Pau (1703), puis de Toulouse (1710)” (cf. https://fr.wikipedia.org/wiki/François\\_de\\_Bertier, consulté le 24 mars 2021)." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<20cf05fc-3d13-4e55-ae28-22db36313dd9> a crm:PC3_has_note ;
    crm:P01_has_domain <9b743eaf-ec86-42d4-82be-f96435ea0fc3> ;
    crm:P03_has_range_literal "Monsieur de Paratte (fl. 1707) est cité dans le Mercure galant en tant que \"Maréchal de Camp, & qui commande en chef dans le Comté de Nice\" (cf. MG-1707-02\\_126)." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<20cf55a5-0f37-4a4a-8f3c-7c67004dbe6b> a crm:PC3_has_note ;
    crm:P01_has_domain <f62c4850-224c-4c72-a312-fbf79ad3a4c5> ;
    crm:P03_has_range_literal "Michel I Ancel Desgranges est maître des cérémonies du roi de France de 1691 à 1716 (cf. http://www.chateauversailles-recherche-ressources.fr/jlbweb/jlbWeb?html=notetiquette&ref=2085, consulté le 22 janvier 2021)." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<215aaa7b-d87c-46ad-bc65-ad56bf96ee36> a crm:PC3_has_note ;
