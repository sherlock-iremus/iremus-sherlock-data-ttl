    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<83def351-2b99-4be2-9b8c-2bd27bbe16ef> a crm:PC3_has_note ;
    crm:P01_has_domain <ad8579cf-6152-4454-ab89-0eb9a85bc0a6> ;
    crm:P03_has_range_literal "Gouverneur de Nantes (cf. [1681-08_323](https://data-iremus.huma-num.fr/sherlock/mercure-galant/article/1681-08_323))." ;
