<fe854974-ace7-49fe-935b-9eb78f447125> a crm:PC3_has_note ;
    crm:P01_has_domain <dcbf5c95-5ec8-41e6-b71b-45dec763548e> ;
    crm:P03_has_range_literal "M. Chesnon est l'auteur des paroles d'un air publié dans le *Mercure Galant* de janvier 1679 (cf. MG-1679-01\\_077) et de celles d'un air publié dans le *Mercure galant* de mars 1684 (cf. MG-1684-03\\_348). Les deux articles précisent qu'il est originaire de Tours." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<fe873108-f2ab-4b16-b24a-8625bb0b30a9> a crm:PC3_has_note ;
