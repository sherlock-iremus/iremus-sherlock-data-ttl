    crm:P03_has_range_literal "Premier écuyer de Monsieur le Prince, nommé ambassadeur de France à la cour de Savoie en 1697 (cf. MG-1697-02_253)." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<d66445fc-5313-4721-9f7d-9be9da82053e> a crm:PC3_has_note ;
    crm:P01_has_domain <bb5fc14d-f679-40cf-826a-8b87551654b5> ;
    crm:P03_has_range_literal "Le Mercure galant mentionne Madame du Teilley , fille d'Honneur de la défunte reine d'Espagne, Marie-Louise d'Orléans, qui a participé aux réjouissances publiques organisées à Château-Gontier pour la naissance du duc de Bretagne en 1704 (cf. [1704-07b_393](https://data-iremus.huma-num.fr/sherlock/mercure-galant/article/1704-07b_393))." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

