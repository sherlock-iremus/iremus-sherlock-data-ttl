<190d92c5-af1f-46e1-83e5-231368fce100> a crm:PC3_has_note ;
    crm:P01_has_domain <102552fc-6bcc-4337-9150-cf3b81470543> ;
    crm:P03_has_range_literal "M. Berthet composa la musique de deux airs parus dans les livraisons d'avril et de mai 1678 du Mercure galant (cf. [1678-04_389](https://data-iremus.huma-num.fr/sherlock/mercure-galant/article/1678-04_389), [1678-05_255](https://data-iremus.huma-num.fr/sherlock/mercure-galant/article/1678-05_255))." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<190ded78-6b05-4214-abab-51324ac3ca8e> a crm:PC3_has_note ;
    crm:P01_has_domain <b1cebb99-9423-4e70-a5d9-34402c451c94> ;
    crm:P03_has_range_literal "«  Membre fondateur [1666; directeur en 1667] et plus tard secrétaire perpétuel de l'Académie des Lettres d'Arles, il est chargé en 1666 d'en rédiger les statuts. Dauphine de Sartre [son épouse] l'assiste dans cette tâche. \" Nancy O'Connor, «  Dauphine de Sartre  », *Dictionnaire des femmes de l'ancienne France*, SIEFAR, 2004, <https://siefar.org/dictionnaire/fr/Dauphine_de_Sartre>" ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<193f3ea6-ce67-477a-af32-ed64da0f5354> a crm:PC3_has_note ;
