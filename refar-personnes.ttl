<72f9f73e-bc8b-49a6-938b-a3f5e1bc2e89> a crm:PC3_has_note ;
    crm:P01_has_domain <f42c73d7-0cb9-4cb7-ba3c-eac57372a3db> ;
    crm:P03_has_range_literal "Mlle Choisin composa la musique d'un air paru dans le Mercure galant de mai 1703 (cf. [1703-05_170](https://data-iremus.huma-num.fr/sherlock/mercure-galant/article/1703-05_170))." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<736b8575-2170-421f-8108-3c83f0d0c8cc> a crm:PC3_has_note ;
    crm:P01_has_domain <4f6a9b5a-9508-45af-9f5d-4b7327876ed4> ;
    crm:P03_has_range_literal "Beauchamps (Pierre) (1631-1705), danseur, chorégraphe, maître de danse de Louis XIV (1650-v. 1672), intendant des Ballets du roi (v. 1661-1687), directeur de l'Académie de danse (1680-1687)" ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

