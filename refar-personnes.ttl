    crm:P01_has_domain <d177e08c-d1f5-4766-bebf-f46fa2bba26a> ;
    crm:P03_has_range_literal "Fonbeauzard (Philippe-André de Forest, marquis de) (?-1715), maréchal de camp (1704…)" ;
    crm:P3.1_has_type <c5402ae4-4ae9-48a1-86ed-c13de0c97d53> .

