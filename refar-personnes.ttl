<3f907b54-fdbd-4874-86c2-d33237c3109f> a crm:PC3_has_note ;
    crm:P01_has_domain <aeeb263e-fbc4-4bbb-be18-aebaeb7f9105> ;
    crm:P03_has_range_literal "Le \"Solitaire de Pontoise\" est le pseudonyme utilisé par l'auteur d'un air publié dans le *Mercure Galant* de juillet 1678 (cf. [1678_07_034](https://data-iremus.huma-num.fr/sherlock/mercure-galant/article/1678_07_034))." ;
