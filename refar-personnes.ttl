    crm:P03_has_range_literal "M. Capus, \"Maistre de Musique fort estimé, & étably à Dijon\", composa la musique d'un air paru dans le Mercure galant de septembre 1690 (cf. MG-1690-09\\_111)." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<b25afaf8-d880-40ab-84b5-ee111c785e9f> a crm:PC3_has_note ;
