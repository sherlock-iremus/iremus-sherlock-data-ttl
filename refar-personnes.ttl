<7b88f5ca-96c2-487f-84e7-c7aa04cd495c> a crm:PC3_has_note ;
    crm:P01_has_domain <ddf619f8-f28b-4ad4-bb72-e6192f250aa3> ;
    crm:P03_has_range_literal "Bignon (Jérôme II) (1627-1697), avocat général au parlement de Paris (1656-1673), maître de la Librairie du roi (en survivance 1651-1656, en titre de 1656 à 1684), conseiller d'état (1678…), chef du conseil établi pour l'enregistrement des armoiries (1696…)." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

