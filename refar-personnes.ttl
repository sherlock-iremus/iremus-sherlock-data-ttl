<f2d87084-0270-4ac2-a8b1-571ce882f1db> a crm:PC3_has_note ;
    crm:P01_has_domain <39cf34ed-bba5-4d2e-bb12-62c3b0faf7e4> ;
    crm:P03_has_range_literal "M. Nolet de Cadhilac remporta le prix des Lanternistes de Toulouse en 1702. Le Mercure galant dit de lui qu'il est né \"pour ainsi dire, dans le sein des Muses. Son illustre Famille les a toujours cultivées, & c'est là particulierement qu'elles aiment à faire entendre leurs charmants Concerts\" (cf. [1702-07a_9](https://data-iremus.huma-num.fr/sherlock/mercure-galant/article/1702-07a_9))." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

