    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<b55a822d-9311-42ef-9cdc-668dc0fcc5ca> a crm:PC3_has_note ;
    crm:P01_has_domain <2982f6b4-0f40-43e3-a0a9-3154ff757aae> ;
    crm:P03_has_range_literal "Joseph Fabre était banquier et armateur marseillais, mais aussi trésorier de la Marine, ambassadeur de France au Levant, agent du comté de Savoie, délégué de la ville au Conseil du commerce du roi (cf. Faïence et Porcelaine de Marseille, XVIIe-XVIIIe siècles - Collections du Musée de la Faïence de Marseille, RMN, 1997, p. 15). Il est également l'un des fondateurs de la Compagnie de la Méditerranée en 1685." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<b589f0b6-ca5e-4d6c-a575-bfd65d75c8b1> a crm:PC3_has_note ;
    crm:P01_has_domain <7a227c5b-79a4-415c-a753-0722aadeb4e0> ;
    crm:P03_has_range_literal "Beauvilliers (Marie-Suzanne-Françoise de Creil, duchesse de) (1716-1780), dame pour accompagner Mesdames aînées (1744-1750), dame d'honneur de Mesdames aînées (1750-1752), puis de Madame Adélaïde (1752-1780)" ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<b5a9662b-5b87-42e8-86cd-34ce23dfd061> a crm:PC3_has_note ;
    crm:P01_has_domain <2ce6d283-7062-46dc-895e-831fa8a5d4c3> ;
    crm:P03_has_range_literal "M. du Breuil est l'auteur d'un air paru dans le *Mercure galant* d'août 1714 (cf. MG-1714-08\\_221)." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<b5aa155f-9272-469f-bdce-bb4c4410d274> a crm:PC3_has_note ;
