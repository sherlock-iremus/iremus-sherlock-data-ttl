    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<0d816f13-eaf9-4236-a387-986726f5e95b> a crm:PC3_has_note ;
    crm:P01_has_domain <f8b6f3db-be85-4397-bd2b-e19a095ab5da> ;
