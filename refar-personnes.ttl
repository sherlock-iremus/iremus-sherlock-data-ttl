<04e73a4f-6a53-4e07-b8e2-df703a67964e> a crm:PC3_has_note ;
    crm:P01_has_domain <7d779629-39ad-420e-ad91-e7011bd13d07> ;
    crm:P03_has_range_literal "Giovanni Giacomo Imperiale prit part aux manifestations organisées par la République de Gênes pour la réception de Philippe V d'Espagne en novembre 1702 (cf. MG.1702-12_191)." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<05130918-1004-49d8-8779-aa6272d98ef1> a crm:PC3_has_note ;
    crm:P01_has_domain <54c0e0eb-f7c0-4f52-b907-65c3c9d51725> ;
    crm:P03_has_range_literal "« Jacques de Noailles, né le 3 novembre 1653, reçu chevalier de Malte le 14 août 1657, a été depuis bailly et commandant de Louvières, de Vaulemion de Bourdeaux, de Saint-Thomas de Trinquetaille en Provence, et de la Croie en Brie, lieutenant général des galères et des armées navalles du Roy ; fut nommé ambassadeur de Malte en France, par le grand-maître de cet ordre au mois de juin 1703 (mourut à Paris le 22 avril 1712 en sa 59e année et fut enterré en l’église cathédrale de Paris » (cf. L’histoire généalogique et chronologique de la Maison royale de France, des paris, grands officiers de al Couronne & de la Maison du roi…., 3/ Paris, La Compagnie des Libraires, 1728, t. 4, p. 791, https://books.google.fr/books?id=Hv8IP37ZmjQC&pg=PA791#v=onepage&q&f=false, consulté le 22 mars 2021)." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<052c285d-d53f-42ae-a703-5efad7c1ef1d> a crm:PC3_has_note ;
    crm:P01_has_domain <ce6ecc75-d874-46b1-813a-cb6b0ef2e79d> ;
    crm:P03_has_range_literal "M. Noël est l'auteur des paroles d'un air publié dans le *Mercure Galant* de mars 1679. Le rédacteur du Mercure précise que \"Les Paroles sont de Mr Noël, Homme d'un fort grand merite, & que je vous ay déja dit que la Ville de Chartres avoit choisy pour son Avocat.\" (cf. [1679-03_042](https://data-iremus.huma-num.fr/sherlock/mercure-galant/article/1679-03_042)). Il s'agit de Milles Noël dont l'acte de décès indique qu'il était \"advocat en parlement et de la ville de Chartres\" (cf. [Registres paroissiaux de Saint-Hilaire de Chartres, 31 janvier 1701](https://familysearch.org/ark:/61903/3:1:3Q9M-C33B-DRK3?cc=3460907 : 2 July 2021)). Il épousa en juin 1670 Catherine Bouvart." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<0539f22c-2bc9-45a2-ac7c-e8229076da97> a crm:PC3_has_note ;
    crm:P01_has_domain <01104cc3-c307-49dd-b1a0-9198cffedad6> ;
    crm:P03_has_range_literal "M. Gaulard est l'un des commissaires fondateurs de l'Académie de musique de Troyes." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<053e3f27-84d3-4849-a897-be51d5bd702f> a crm:PC3_has_note ;
    crm:P01_has_domain <715ba952-ebee-4fe5-843d-dd6863be4e01> ;
    crm:P03_has_range_literal "\"Ombre des Tuileries\" est l'auteur des paroles d'un air publié dans le *Mercure Galant* de mai 1698 (cf. [1698-05_280](https://data-iremus.huma-num.fr/sherlock/mercure-galant/article/1698-05_280))." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<05433a67-5bc3-4e19-9cfe-3d55205d13a9> a crm:PC3_has_note ;
    crm:P01_has_domain <a9cd6e64-dc13-4b3c-978a-198245d34443> ;
    crm:P03_has_range_literal "Pseudonyme d'un habitant du Havre dont une explication en vers d'une énigme de décembre 1683 est parue dans le *Mercure galant* (cf. MG-1684-03e\\_084)." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<054f4bba-5426-48b4-ab1b-dee94895557d> a crm:PC3_has_note ;
    crm:P01_has_domain <1c6556be-1a88-4209-8ac6-1c76a0ed28f7> ;
    crm:P03_has_range_literal "M. Ennelin, \"de Saint Quentin\", est l'auteur d'un air publié dans le *Mercure galant* de juin 1687 (cf. MG-1687-06a\\_084). Peut-être est-il apparenté à l'auteur de l'air \"Retirez-vous foibles buveurs\" publié dans les *Meslanges de musique latine, françoise & italienne...* (Paris, Jean-Baptiste-Christophe Ballard, 1731, Automne, p. 200-204)." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<05a133a8-d3c1-4031-a220-784fbaffc4d6> a crm:PC3_has_note ;
    crm:P01_has_domain <b91181f4-d51c-45ac-abcf-bfce7937aa72> ;
    crm:P03_has_range_literal "Capitoul de Toulouse (cf. MG-1682-10a_209)." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<05bd22b1-9e3f-4d20-9209-7f472bd907dd> a crm:PC3_has_note ;
    crm:P01_has_domain <c4323fbe-80d8-4979-980b-700c0f9380cd> ;
    crm:P03_has_range_literal "échevin de Noyons (cf. [1690-08_072](https://data-iremus.huma-num.fr/sherlock/mercure-galant/article/1690-08_072))." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<05c46987-531d-482d-8f7b-c399232ee3f8> a crm:PC3_has_note ;
    crm:P01_has_domain <edc7bc30-1180-4f61-9a17-cd173cf1472a> ;
    crm:P03_has_range_literal "échevin de Troyes (cf. [1678-09e_309](https://data-iremus.huma-num.fr/sherlock/mercure-galant/article/1678-09e_309))." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<05fd506f-15b9-476a-a725-3c3cd75e5432> a crm:PC3_has_note ;
    crm:P01_has_domain <c5a9a789-92f4-45ba-a585-170eaec1f0d4> ;
    crm:P03_has_range_literal "Mlle de Castille est l'autrice d'un poème, qui sera mis en musique, publié dans le *Mercure galant* d'avril 1680 (cf. [1680-04_242](https://data-iremus.huma-num.fr/sherlock/mercure-galant/article/1680-04_242))." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<0609de0c-5e1a-4ddf-b87a-2f7a13d77a11> a crm:PC3_has_note ;
    crm:P01_has_domain <662f7bb1-f2c3-48cd-aeab-f31cd46bedcd> ;
    crm:P03_has_range_literal "Commandeur de Sainte Catherine de Montrevault. Procureur général et Commandeur de l'Ordre de Notre-Dame-du-Mont-Carmel et de Saint-Lazare de Jérusalem (cf. MG-1696-02_216)." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<06434f3d-53f6-460d-ab39-ed02d7ca0e8c> a crm:PC3_has_note ;
    crm:P01_has_domain <0e9efbc5-66ad-44f5-ac74-591307107835> ;
    crm:P03_has_range_literal "Conseiller au Parlement de Paris, premier président au Parlement de Grenoble (cf. MG-1693-07_196)." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<06490bf7-9624-4591-b9c9-8cd407a1f616> a crm:PC3_has_note ;
    crm:P01_has_domain <37003d59-1b8d-4787-b43c-6b6a70b42f24> ;
    crm:P03_has_range_literal "James Drummond (1648-1716) comte de Perth, était le gouverneur de Jacques-François Stuart (cf. https://fr.wikipedia.org/wiki/James\\_Drummond\\_(4e\\_comte\\_de\\_Perth), consulté le 1er juin 2021)." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

